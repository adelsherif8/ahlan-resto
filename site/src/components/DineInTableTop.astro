---
/** DineIn variant — the table from above: four seats, the code in the middle,
    and the guests it turns into records. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div class="mx-auto grid max-w-5xl items-center gap-12 lg:grid-cols-[1fr_0.9fr]">
      <div class="max-w-[36rem]" data-reveal>
        <h2 class="h-rule">{t.dineIn.h2}</h2>
        <p class="mt-7 text-[1.1rem]">{t.dineIn.p1}</p>
        <p class="mt-4 text-[1.1rem]">{t.dineIn.p2}</p>
      </div>

      <div class="justify-self-center" data-reveal>
        <div class="relative flex h-[320px] w-[320px] items-center justify-center">
          <!-- table -->
          <div class="absolute inset-8 rounded-full bg-[#D8C9B2] shadow-[inset_0_2px_10px_rgba(20,17,16,0.12)]"></div>
          <!-- seats -->
          {[0, 1, 2, 3].map((i) => (
            <span
              class="absolute h-11 w-11 rounded-full border border-ink/12 bg-[#EFE7DA]"
              style={`transform: rotate(${i * 90}deg) translate(0, -140px)`}
              aria-hidden="true"
            ></span>
          ))}
          <!-- the code on the table -->
          <div class="relative z-10 w-24 rounded-[3px] bg-[#FFFDF8] p-2.5 text-center shadow-[0_10px_24px_-10px_rgba(20,17,16,0.5)]">
            <p class="truncate text-[8px] font-bold">{t.hero.restaurant}</p>
            <svg viewBox="0 0 44 44" class="mx-auto mt-1.5 h-12 w-12" role="img" aria-label="QR">
              <rect width="44" height="44" fill="#FFFDF8" />
              <g fill="#8C1D2F">
                <path d="M3 3h12v12H3zM6 6v6h6V6z" fill-rule="evenodd" />
                <path d="M29 3h12v12H29zM32 6v6h6V6z" fill-rule="evenodd" />
                <path d="M3 29h12v12H3zM6 32v6h6V32z" fill-rule="evenodd" />
                <rect x="20" y="4" width="4" height="4" /><rect x="20" y="12" width="4" height="4" />
                <rect x="18" y="20" width="5" height="5" /><rect x="27" y="22" width="4" height="4" />
                <rect x="35" y="20" width="4" height="4" /><rect x="6" y="20" width="4" height="4" />
                <rect x="20" y="29" width="4" height="4" /><rect x="28" y="31" width="5" height="4" />
                <rect x="22" y="37" width="4" height="4" /><rect x="36" y="36" width="5" height="5" />
              </g>
            </svg>
            <p class="mt-1 text-[7px] leading-tight text-ink/70">{t.dineIn.qr.scan}</p>
          </div>
        </div>
        <p class="mt-4 text-center text-[0.85rem] text-ink/55">{t.hero.demoLabel}</p>
      </div>
    </div>
  </div>
</section>
