---
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
import PhoneChat from './PhoneChat';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<section class="on-ink relative overflow-hidden bg-ink">
  <div
    class="container-page relative grid items-center gap-14 pt-16 pb-20 md:pt-24 md:pb-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-6"
  >
    <div class="relative z-10 max-w-[36rem]">
      <h1 class="text-semna">{t.hero.h1}</h1>

      <!-- The confrontational line -->
      <div class="mt-8 border-s-2 border-brass/50 ps-5">
        <p class="text-[1.25rem] font-medium leading-relaxed text-brass sm:text-[1.45rem]">
          {t.hero.sub}
        </p>
      </div>

      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a
          href={WA_LINK}
          class="btn-primary inline-flex items-center justify-center !px-8 !py-3.5 text-[1.05rem]"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#pricing"
          class="inline-flex min-h-[52px] items-center justify-center rounded-[var(--radius-md)] border-[1.5px] border-semna/35 px-8 py-3.5 text-[1.05rem] font-semibold text-semna transition-colors hover:border-brass hover:text-brass-light"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="relative justify-self-center lg:justify-self-end lg:pe-6">
      <!-- The mark's circle, echoed once, as ambient geometry — not a gradient -->
      <div
        class="pointer-events-none absolute start-1/2 top-1/2 -z-0 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-brass/[0.16] rtl:translate-x-1/2"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute start-1/2 top-1/2 -z-0 h-[440px] w-[440px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-brass/[0.09] rtl:translate-x-1/2"
        aria-hidden="true"
      >
      </div>
      <PhoneChat
        client:visible
        rtlChat={true}
        restaurant={t.hero.restaurant}
        status={t.hero.chatStatus}
        demoLabel={t.hero.demoLabel}
        replayLabel={t.hero.replay}
        chat={t.hero.chat}
      />
    </div>
  </div>
</section>
