---
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
import PhoneChat from './PhoneChat';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<section class="on-ink bg-ink">
  <div
    class="mx-auto grid max-w-5xl items-center gap-12 px-5 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8"
  >
    <div class="max-w-[var(--measure)]">
      <h1 class="text-[2.1rem] leading-[1.2] text-semna sm:text-[var(--step-3)] sm:leading-[var(--lh-display)]">
        {t.hero.h1}
      </h1>

      <!-- The confrontational line — brass, held by a hairline rule -->
      <div class="mt-6 border-brass/40 ps-4 border-s-2">
        <p class="text-[1.2rem] font-medium leading-relaxed text-brass sm:text-[1.3rem]">
          {t.hero.sub}
        </p>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={WA_LINK} class="btn-primary inline-flex items-center justify-center">
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#pricing"
          class="inline-flex min-h-[44px] items-center justify-center rounded-[var(--radius-md)] border-[1.5px] border-semna/40 px-6 py-3 font-semibold text-semna hover:border-semna"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="justify-self-center lg:justify-self-end">
      <PhoneChat
        client:visible
        rtlChat={true}
        restaurant={t.hero.restaurant}
        status={t.hero.chatStatus}
        demoLabel={t.hero.demoLabel}
        replayLabel={t.hero.replay}
        chat={t.hero.chat}
      />
    </div>
  </div>
</section>
