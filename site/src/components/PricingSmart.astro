---
/** Pricing — plans + the instrument that picks one. */
import type { SiteContent } from '../content/types';
import PricingPicker from './PricingPicker';

interface Props { t: SiteContent }
const { t } = Astro.props;

const RATE = [
  { fee: 3500, included: 300, over: 9 },
  { fee: 8500, included: 1000, over: 8 },
  { fee: 20000, included: 2500, over: 7 },
];

const labels = {
  plans: t.pricing.plans.map((p, i) => ({ name: p.name, ...RATE[i]!, fits: t.pricing.picker.fits[i]! })),
  rows: { included: t.pricing.rows.included, overage: t.pricing.rows.overage, fits: t.pricing.rows.fits },
  perMonth: t.pricing.perMonth,
  ...t.pricing.picker,
};
---

<section id="pricing" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <h2 class="h-rule rule-center text-center" data-reveal>{t.pricing.h2}</h2>

    <div class="mx-auto mt-12 max-w-6xl" data-reveal>
      <PricingPicker client:visible labels={labels} />
    </div>

    <div class="container-text mt-10 text-center" data-reveal>
      <p class="text-[1.05rem]">{t.pricing.includesAll}</p>
      <p class="mt-2 text-ink/75">{t.pricing.setup}</p>
    </div>

    <p class="mx-auto mt-12 max-w-3xl text-center text-[1.25rem] font-semibold" data-reveal>{t.pricing.mathClose}</p>
  </div>
</section>
