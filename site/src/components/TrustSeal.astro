---
/** Trust variant — the seal: a brass mark carrying the number, sentence beside. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<aside class="border-y border-ink/[0.07] bg-semna">
  <div class="container-page flex flex-wrap items-center justify-center gap-x-8 gap-y-5 py-14" data-reveal>
    <div class="relative flex h-24 w-24 shrink-0 items-center justify-center">
      <span class="absolute inset-0 rounded-full border border-brass-deep/35" aria-hidden="true"></span>
      <span class="absolute inset-2 rounded-full border border-brass-deep/20" aria-hidden="true"></span>
      <span class="num text-[1.9rem] font-medium text-brass-deep">{t.trust.num}</span>
    </div>
    <p class="max-w-[26rem] text-[1.1rem] leading-relaxed text-ink/85">
      {t.trust.pre} <span class="num font-medium text-ink">{t.trust.num}</span> {t.trust.post}
    </p>
  </div>
</aside>
