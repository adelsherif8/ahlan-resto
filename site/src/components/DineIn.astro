---
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1fr_0.75fr]">
      <div class="max-w-[36rem]" data-reveal>
        <h2 class="h-rule">{t.dineIn.h2}</h2>
        <p class="mt-7 text-[1.1rem]">{t.dineIn.p1}</p>
        <p class="mt-4 text-[1.1rem]">{t.dineIn.p2}</p>
      </div>

      <!-- The table tent card, coded — Karkadeh on Semna for scan contrast,
           the restaurant's name larger than ours (ownership, rendered in print). -->
      <div class="justify-self-center" data-reveal>
        <div
          class="w-64 rotate-[-2.5deg] rounded-[var(--radius-md)] border border-ink/10 bg-[#FFFDF8] p-6 text-center shadow-[0_2px_4px_rgba(20,17,16,0.05),0_28px_56px_-24px_rgba(20,17,16,0.35)]"
        >
          <p class="text-[1.2rem] font-bold text-ink">{t.hero.restaurant}</p>

          <!-- Decorative QR — illustration, not a real code -->
          <svg viewBox="0 0 84 84" class="mx-auto mt-5 h-36 w-36" role="img" aria-label="QR">
            <rect width="84" height="84" fill="#FFFDF8" />
            <g fill="#8C1D2F">
              <path d="M4 4h24v24H4zM10 10v12h12V10z" fill-rule="evenodd" />
              <path d="M56 4h24v24H56zM62 10v12h12V10z" fill-rule="evenodd" />
              <path d="M4 56h24v24H4zM10 62v12h12V62z" fill-rule="evenodd" />
              <rect x="36" y="4" width="6" height="6" /><rect x="46" y="10" width="6" height="6" />
              <rect x="36" y="20" width="6" height="6" /><rect x="34" y="34" width="8" height="8" />
              <rect x="48" y="36" width="6" height="6" /><rect x="58" y="40" width="6" height="6" />
              <rect x="68" y="34" width="6" height="6" /><rect x="76" y="44" width="4" height="6" />
              <rect x="10" y="38" width="6" height="6" /><rect x="20" y="44" width="6" height="6" />
              <rect x="4" y="46" width="6" height="6" /><rect x="36" y="50" width="6" height="6" />
              <rect x="46" y="56" width="6" height="6" /><rect x="56" y="62" width="8" height="6" />
              <rect x="38" y="64" width="6" height="6" /><rect x="46" y="74" width="6" height="6" />
              <rect x="60" y="74" width="6" height="6" /><rect x="72" y="60" width="6" height="6" />
              <rect x="74" y="72" width="6" height="8" />
            </g>
          </svg>

          <p class="mt-5 text-[1rem] font-medium leading-relaxed text-ink">{t.dineIn.qr.scan}</p>

          <!-- heavy print weight — the fine stroke dies below 96px (USAGE.md) -->
          <img
            src="/brand/03-mark-print-karkadeh-nobg.svg"
            alt="Munadim"
            width="20" height="20"
            class="mx-auto mt-5 h-5 w-5 opacity-70"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
