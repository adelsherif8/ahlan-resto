---
/** Problem variant D — the statement: the monthly commission statement is the
    artifact that stings (persona doc: "arrives monthly, in writing"). Render it.
    Worked example from the same 150/30 basis; labelled مثال توضيحي. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="border-y border-ink/[0.07] bg-semna">
  <div class="container-page section">
    <div class="mx-auto grid max-w-5xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="max-w-[36rem]" data-reveal>
        <h2 class="h-rule">{t.problem.h2}</h2>
        <p class="mt-7 text-[1.1rem]">{t.problem.p1}</p>
        <p class="mt-4 text-[1.1rem] font-medium">{t.problem.p2}</p>
      </div>

      <!-- The monthly statement, as he receives it -->
      <div class="justify-self-center" data-reveal style="transition-delay:90ms">
        <div class="w-[300px] rotate-[1.5deg] bg-[#FFFDF8] p-6 text-ink shadow-[0_2px_4px_rgba(20,17,16,0.05),0_28px_56px_-24px_rgba(20,17,16,0.3)]">
          <div class="flex items-baseline justify-between border-b border-dashed border-ink/25 pb-3">
            <span class="text-[0.95rem] font-bold">كشف عمولة شهري</span>
            <span class="text-[0.7rem] text-ink/65">مثال توضيحي</span>
          </div>
          <dl class="mt-4 space-y-2.5 text-[0.92rem]">
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">عدد الأوردرات</dt>
              <dd class="num font-medium">400</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">متوسط الأوردر</dt>
              <dd class="num font-medium">150</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">إجمالي المبيعات</dt>
              <dd class="num font-medium">60,000</dd>
            </div>
          </dl>
          <div class="mt-4 flex items-baseline justify-between gap-3 border-t border-dashed border-ink/25 pt-3">
            <span class="font-semibold">العمولة (حوالي الخُمس)</span>
            <span class="num text-[1.5rem] font-semibold text-karkadeh" dir="ltr">−12,000</span>
          </div>
          <p class="mt-3 text-end text-[0.75rem] text-ink/65">جنيه، كل شهر</p>
        </div>
      </div>
    </div>
  </div>
</section>
