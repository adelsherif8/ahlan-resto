---
import type { SiteContent } from '../content/types';
import { CONTACT_EMAIL } from '../lib/const';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<footer class="on-ink border-t border-semna/10 bg-ink">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-12 text-center">
    <img
      src="/brand/23-lockup-stacked-dark-nobg.svg"
      alt="Munadim"
      width="120" height="94"
      class="h-20 w-auto"
      loading="lazy"
    />
    <p class="text-[1.2rem] text-brass" style="font-family: var(--font-display-ar)" lang="ar" dir="rtl">
      {t.footer.tagline}
    </p>

    <nav class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-[0.95rem]">
      <a href={`mailto:${CONTACT_EMAIL}`} class="flex min-h-[44px] items-center text-semna/80 hover:text-brass-light" dir="ltr">
        {CONTACT_EMAIL}
      </a>
      <a href={`/${lang}/privacy`} class="flex min-h-[44px] items-center text-semna/80 hover:text-brass-light">
        {t.footer.privacy}
      </a>
      <a
        href={t.nav.toggle.href}
        class="flex min-h-[44px] items-center text-semna/80 hover:text-brass-light"
        lang={lang === 'ar' ? 'en' : 'ar'}
        dir={lang === 'ar' ? 'ltr' : 'rtl'}
      >{t.nav.toggle.label}</a>
    </nav>

    <p class="text-[var(--step--1)] text-semna/60">{t.footer.rights}</p>
  </div>
</footer>
