---
/** Footer C — paper colophon: light ground, rule-divided columns, tiny mark.
    The page ends on the same paper the hero started on. */
import type { SiteContent } from '../content/types';
import { CONTACT_EMAIL, WA_LINK, WA_NUMBER_DISPLAY } from '../lib/const';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<footer class="border-t border-ink/12 bg-semna">
  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <img src="/brand/02-mark-fine-on-light.svg" alt="" width="26" height="26" class="h-6 w-6" loading="lazy" aria-hidden="true" />
          <span class="text-[0.95rem] font-semibold tracking-[0.14em] text-ink" dir="ltr">MUNADIM</span>
        </div>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-brass-deep" style="font-family: var(--font-display-ar)" lang="ar" dir="rtl">
          {t.footer.tagline}
        </p>
      </div>

      <nav>
        <h2 class="label-cap text-ink/45">{t.footer.colSite}</h2>
        <ul class="mt-3 space-y-0.5">
          {t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="flex w-fit min-h-[36px] items-center text-[0.95rem] text-ink/80 hover:text-karkadeh">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav>
        <h2 class="label-cap text-ink/45">{t.footer.colContact}</h2>
        <ul class="mt-3 space-y-0.5">
          <li>
            <a href={WA_LINK} class="num flex w-fit min-h-[36px] items-center text-[0.95rem] font-medium text-ink/85 hover:text-karkadeh" dir="ltr">{WA_NUMBER_DISPLAY}</a>
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="flex w-fit min-h-[36px] items-center text-[0.95rem] text-ink/80 hover:text-karkadeh" dir="ltr">{CONTACT_EMAIL}</a>
          </li>
          <li>
            <a href={`/${lang}/privacy`} class="flex w-fit min-h-[36px] items-center text-[0.95rem] text-ink/80 hover:text-karkadeh">{t.footer.privacy}</a>
          </li>
          <li>
            <a
              href={t.nav.toggle.href}
              class="flex w-fit min-h-[36px] items-center text-[0.95rem] text-ink/80 hover:text-karkadeh"
              lang={lang === 'ar' ? 'en' : 'ar'}
              dir={lang === 'ar' ? 'ltr' : 'rtl'}
            >{t.nav.toggle.label}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-ink/10 pt-5">
      <p class="text-[var(--step--1)] text-ink/50">{t.footer.rights}</p>
    </div>
  </div>
</footer>
