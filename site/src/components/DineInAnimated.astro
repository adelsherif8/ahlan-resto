---
/** Dine-in — demonstrated, not described: the animated capture scene. */
import type { SiteContent } from '../content/types';
import DineInScene from './DineInScene';

interface Props { t: SiteContent }
const { t } = Astro.props;

const labels = {
  ...t.dineIn.scene,
  restaurant: t.hero.restaurant,
  demoLabel: t.hero.demoLabel,
};
---

<section class="section">
  <div class="container-page">
    <div class="container-text text-center" data-reveal>
      <p class="eyebrow eyebrow-center"><span class="num">03</span> الصالة</p>
      <h2>{t.dineIn.h2}</h2>
      <p class="lede mx-auto mt-6">{t.dineIn.p1}</p>
    </div>

    <div class="mx-auto mt-10 max-w-6xl" data-reveal>
      <DineInScene client:visible labels={labels} />
    </div>

    <p class="lede container-text mt-10 text-center" data-reveal>{t.dineIn.p2}</p>
  </div>
</section>
