---
/** Footer A — the real multi-page site footer: brand column + link columns,
    slim legal bar. Mark stays small (24px, heavy weight per USAGE.md). */
import type { SiteContent } from '../content/types';
import { CONTACT_EMAIL, WA_LINK, WA_NUMBER_DISPLAY } from '../lib/const';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<footer class="on-ink bg-ink">
  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <!-- brand column -->
      <div class="max-w-[22rem]">
        <img src="/brand/20-lockup-horizontal-dark-nobg.svg" alt="Munadim" width="166" height="50" class="h-8 w-auto" loading="lazy" />
        <p class="mt-4 text-[1.05rem] leading-relaxed text-brass" style="font-family: var(--font-display-ar)" lang="ar" dir="rtl">
          {t.footer.tagline}
        </p>
        <a href={WA_LINK} class="mt-5 flex min-h-[44px] w-fit items-center gap-2 text-semna/85 hover:text-brass-light">
          <span class="num text-[1.05rem] font-medium" dir="ltr">{WA_NUMBER_DISPLAY}</span>
        </a>
      </div>

      <!-- site links -->
      <nav>
        <h2 class="label-cap text-semna/60">{t.footer.colSite}</h2>
        <ul class="mt-3 space-y-0.5">
          {t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- contact links -->
      <nav>
        <h2 class="label-cap text-semna/60">{t.footer.colContact}</h2>
        <ul class="mt-3 space-y-0.5">
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light" dir="ltr">{CONTACT_EMAIL}</a>
          </li>
          <li>
            <a href={`/${lang}/privacy`} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light">{t.footer.privacy}</a>
          </li>
          <li>
            <a
              href={t.nav.toggle.href}
              class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light"
              lang={lang === 'ar' ? 'en' : 'ar'}
              dir={lang === 'ar' ? 'ltr' : 'rtl'}
            >{t.nav.toggle.label}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-semna/10 pt-5">
      <p class="text-[var(--step--1)] text-semna/65">{t.footer.rights}</p>
    </div>
  </div>
</footer>
