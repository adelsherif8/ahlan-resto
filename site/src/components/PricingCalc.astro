---
/** Pricing — the slider drives the cards (PricingCards island): set your volume,
    every plan shows what you'd pay, the fit lifts, one line compares with the apps. */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
import PricingCards from './PricingCards';
interface Props { t: SiteContent }
const { t } = Astro.props;

const labels = {
  aov: t.pricing.picker.aov,
  orders: t.pricing.picker.orders,
  egp: t.pricing.picker.egp,
  perMonth: t.pricing.perMonth,
  yourPlan: t.pricing.picker.yourPlan,
  appSide: t.pricing.picker.appSide,
  diff: t.pricing.picker.diff,
  rows: t.pricing.rows,
  plans: t.pricing.plans,
  payAt: 'هتدفع عند',
  ordersWord: 'أوردر',
  cta: t.nav.cta,
  ctaHref: WA_LINK,
};
---

<section id="pricing" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <div class="container-text text-center" data-reveal>
      <p class="eyebrow eyebrow-center"><span class="num">07</span> السعر</p>
      <h2>{t.pricing.h2}</h2>
      <p class="lede mx-auto mt-6">{t.pricing.includesAll}</p>
    </div>

    <div class="mt-10" data-reveal>
      <PricingCards client:visible labels={labels} dir="rtl" />
    </div>

    <p class="mx-auto mt-6 max-w-4xl text-center text-[0.9rem] text-ink/60" data-reveal>
      {t.pricing.setup} {t.pricing.picker.assumption}
    </p>
    <p class="container-text mt-8 text-center text-[1.2rem] font-semibold" data-reveal>{t.pricing.mathClose}</p>
  </div>
</section>
