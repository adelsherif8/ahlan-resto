---
/** Trust variant B — numeral-led: the 110 at editorial scale, sentence beside it. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<aside class="border-y border-ink/[0.07] bg-semna">
  <div class="container-page flex flex-wrap items-center justify-center gap-x-6 gap-y-3 py-12" data-reveal>
    <span class="num text-[3.4rem] font-medium leading-none text-brass-deep">{t.trust.num}</span>
    <p class="max-w-[26rem] text-[1.05rem] leading-relaxed text-ink/85">
      {t.trust.pre} <span class="font-medium text-ink">{t.trust.num}</span> {t.trust.post}
    </p>
  </div>
</aside>
