---
/** Understands variant — one annotated conversation: each exchange proves a
    capability, named in the margin. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
const WAVE = [4, 8, 12, 7, 10, 14, 8, 5, 10, 13, 7, 4, 7, 11, 15, 9];
---

<section id="features" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <h2 class="h-rule rule-center text-center" data-reveal>{t.understands.h2}</h2>

    <div class="mx-auto mt-12 max-w-3xl" data-reveal>
      <div class="rounded-[var(--radius-lg)] bg-[#EFEAE2] p-5 shadow-[0_1px_2px_rgba(20,17,16,0.05),0_20px_44px_-24px_rgba(20,17,16,0.3)]" dir="rtl">
        <div class="space-y-5">
          {t.understands.fragments.map((f, i) => (
            <div class="grid gap-2 sm:grid-cols-[auto_1fr] sm:gap-4" data-reveal style={`transition-delay:${i * 70}ms`}>
              <!-- the capability, in the margin -->
              <span class="flex items-center gap-2 self-start pt-1 text-[0.8rem] font-semibold text-brass-deep sm:w-32">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brass-deep" aria-hidden="true"></span>
                {f.head}
              </span>

              <div class="flex flex-col gap-1.5">
                {f.demo.inVoice ? (
                  <div class="flex w-fit max-w-[85%] items-center gap-2 self-start rounded-lg rounded-ss-none bg-white px-3 py-2 shadow-sm">
                    <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-[#54656F]" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5Z" /></svg>
                    <span class="flex h-4 items-center gap-[2px]" aria-hidden="true">
                      {WAVE.map((h) => <span class="w-[2px] rounded-full bg-[#8696A0]" style={`height:${h}px`}></span>)}
                    </span>
                    <span class="num text-[10px] text-[#667781]">{f.demo.inVoice}</span>
                  </div>
                ) : (
                  <p dir="auto" class="w-fit max-w-[85%] self-start rounded-lg rounded-ss-none bg-white px-3 py-1.5 text-[0.85rem] leading-[1.55] text-[#111B21] shadow-sm">{f.demo.in}</p>
                )}
                <p dir="auto" class="w-fit max-w-[85%] self-end rounded-lg rounded-es-none bg-[#D9FDD3] px-3 py-1.5 text-[0.85rem] leading-[1.55] text-[#111B21] shadow-sm">{f.demo.out}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-center text-[0.72rem] font-medium text-[#667781]">{t.hero.demoLabel}</p>
      </div>
    </div>
  </div>
</section>
