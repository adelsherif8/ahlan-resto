---
/** Header variant — centred masthead: mark in the middle, nav split either side. */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
const half = Math.ceil(t.nav.links.length / 2);
---

<header class="border-b border-ink/[0.07] bg-semna">
  <div class="container-page grid items-center gap-4 py-4 lg:grid-cols-[1fr_auto_1fr]">
    <nav class="hidden items-center gap-6 lg:flex">
      {t.nav.links.slice(0, half).map((l) => (
        <a href={l.href} class="flex min-h-[44px] items-center font-medium text-ink/75 hover:text-karkadeh">{l.label}</a>
      ))}
    </nav>

    <a href={`/${lang}`} class="flex min-h-[44px] items-center justify-self-start lg:justify-self-center" aria-label="Munadim">
      <img src="/brand/21-lockup-horizontal-light-nobg.svg" alt="Munadim" width="166" height="50" class="h-9 w-auto" />
    </a>

    <nav class="flex items-center justify-end gap-4 lg:gap-6">
      {t.nav.links.slice(half).map((l) => (
        <a href={l.href} class="hidden min-h-[44px] items-center font-medium text-ink/75 hover:text-karkadeh lg:flex">{l.label}</a>
      ))}
      <a href={t.nav.toggle.href} class="flex min-h-[44px] items-center font-medium text-ink/55 hover:text-karkadeh" lang={lang === 'ar' ? 'en' : 'ar'} dir={lang === 'ar' ? 'ltr' : 'rtl'}>{t.nav.toggle.label}</a>
      <a href={WA_LINK} class="btn-primary flex items-center justify-center text-[0.95rem] !py-2.5 !px-5">{t.nav.cta}</a>
    </nav>
  </div>
</header>
