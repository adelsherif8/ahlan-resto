---
/** The one pinned section — their morphing scale diagram, our arithmetic.
    Scroll dials the orders/month from 300 to 2,500; the app's cut and
    Munadim's cost interpolate against each other and the plan badge steps
    Start → Grow → Chain. Like their 20ft/40ft, it RESTS on real tiers:
    only the middle of the scroll morphs, so the numbers never quote a plan
    that doesn't exist. Rate card: branding/pricing.md. */
import type { SiteContent } from '../content/types';
import SectionMark from './SectionMark.astro';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section id="math-pin" class="relative bg-semna">
  <div class="container-page flex min-h-screen flex-col justify-center py-16">
    <SectionMark n="06" label={t.pricing.mathH3} />

    <h2 class="mt-6 max-w-[18ch]">{t.pricing.h2}</h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- the dial -->
      <div>
        <p class="label-cap text-ink/50">{t.pricing.picker.orders}</p>
        <p class="mt-3 flex items-baseline gap-3">
          <span id="m-orders" class="num text-[4rem] font-medium leading-none sm:text-[5.5rem]">300</span>
          <span class="text-[1rem] text-ink/60">{t.pricing.rows.included}</span>
        </p>

        <div class="mt-7 flex items-center gap-3">
          <span class="label-cap text-ink/50">{t.pricing.picker.yourPlan}</span>
          <span id="m-plan" class="rounded-full bg-karkadeh px-3.5 py-1 text-[0.9rem] font-semibold text-semna" dir="ltr">Start</span>
        </div>

        <!-- the tier rail: three real stops, like their 20/40 ft -->
        <div class="mt-8">
          <div class="relative h-px w-full bg-ink/15">
            <span id="m-fill" class="absolute inset-y-0 start-0 block bg-brass-deep" style="width:0%"></span>
            {['300', '1,000', '2,500'].map((v, i) => (
              <span
                class="absolute -top-1 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-ink/25 rtl:translate-x-1/2"
                style={`inset-inline-start:${i * 50}%`}
                data-stop={i}
              ></span>
            ))}
          </div>
          <div class="mt-3 flex justify-between text-[0.8rem] text-ink/50">
            <span class="num">300</span><span class="num">1,000</span><span class="num">2,500</span>
          </div>
        </div>
      </div>

      <!-- the two sides, interpolating -->
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="card p-7 text-center">
          <p class="text-[0.92rem] text-ink/65">{t.pricing.picker.appSide}</p>
          <p class="mt-3 flex items-baseline justify-center gap-2 text-karkadeh">
            <span id="m-app" class="num text-[3.2rem] font-medium leading-none sm:text-[4rem]">9,000</span>
            <span class="text-[0.95rem]">{t.pricing.picker.egp}</span>
          </p>
        </div>
        <div class="card p-7 text-center">
          <p class="text-[0.92rem] text-ink/65">{t.pricing.picker.ourSide} <span id="m-plan2" dir="ltr" class="font-semibold">Start</span></p>
          <p class="mt-3 flex items-baseline justify-center gap-2">
            <span id="m-ours" class="num text-[3.2rem] font-medium leading-none sm:text-[4rem]">3,500</span>
            <span class="text-[0.95rem] text-ink/70">{t.pricing.picker.egp}</span>
          </p>
        </div>

        <p class="sm:col-span-2 text-center text-[1.15rem] font-semibold">
          {t.pricing.picker.diff} <span id="m-diff" class="num text-karkadeh">5,500</span> {t.pricing.picker.egp} {t.pricing.perMonth}
        </p>
        <p class="sm:col-span-2 text-center text-[0.85rem] text-ink/55">{t.pricing.picker.assumption}</p>
      </div>
    </div>
  </div>
</section>
