---
/** Footer B — the split: a last quiet CTA panel on one side, links on the other.
    No lockup at all; the small mark signs it off. */
import type { SiteContent } from '../content/types';
import { CONTACT_EMAIL, WA_LINK, WA_NUMBER_DISPLAY } from '../lib/const';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<footer class="on-ink bg-ink">
  <div class="container-page py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:gap-20">
      <!-- last word + number -->
      <div class="max-w-[26rem]">
        <p class="text-[1.35rem] leading-relaxed text-brass" style="font-family: var(--font-display-ar)" lang="ar" dir="rtl">
          {t.footer.tagline}
        </p>
        <a
          href={WA_LINK}
          class="mt-6 inline-flex min-h-[48px] items-center gap-3 rounded-full border border-semna/25 px-6 text-semna transition-colors hover:border-brass hover:text-brass-light"
        >
          <span>{t.nav.cta}</span>
          <span class="num font-medium" dir="ltr">{WA_NUMBER_DISPLAY}</span>
        </a>
      </div>

      <!-- links, two tight columns -->
      <div class="flex gap-14">
        <nav>
          <h2 class="label-cap text-semna/60">{t.footer.colSite}</h2>
          <ul class="mt-3 space-y-0.5">
            {t.nav.links.map((l) => (
              <li>
                <a href={l.href} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav>
          <h2 class="label-cap text-semna/60">{t.footer.colContact}</h2>
          <ul class="mt-3 space-y-0.5">
            <li>
              <a href={`mailto:${CONTACT_EMAIL}`} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light" dir="ltr">{CONTACT_EMAIL}</a>
            </li>
            <li>
              <a href={`/${lang}/privacy`} class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light">{t.footer.privacy}</a>
            </li>
            <li>
              <a
                href={t.nav.toggle.href}
                class="flex w-fit min-h-[44px] items-center text-[0.95rem] text-semna/80 hover:text-brass-light"
                lang={lang === 'ar' ? 'en' : 'ar'}
                dir={lang === 'ar' ? 'ltr' : 'rtl'}
              >{t.nav.toggle.label}</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="mt-9 flex items-center justify-between gap-4 border-t border-semna/10 pt-5">
      <p class="text-[var(--step--1)] text-semna/65">{t.footer.rights}</p>
      <img src="/brand/01-mark-fine-brass-on-ink-nobg.svg" alt="" width="26" height="26" class="h-6 w-6 opacity-60" loading="lazy" aria-hidden="true" />
    </div>
  </div>
</footer>
