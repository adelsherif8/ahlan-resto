---
/** Variant G — "Light editorial": semna ground, ink type, the phone tilted like
    an object photographed on paper. Feels print, not app. */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
import PhoneChat from './PhoneChat';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t } = Astro.props;
---

<section class="relative overflow-hidden bg-semna">
  <div class="container-page relative grid items-center gap-14 pt-16 pb-20 md:pt-24 md:pb-28 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="relative z-10 max-w-[36rem]">
      <h1 class="text-ink">{t.hero.h1}</h1>

      <div class="mt-8 border-s-2 border-karkadeh/60 ps-5">
        <p class="max-w-[32rem] text-[1.25rem] font-medium leading-relaxed text-karkadeh sm:text-[1.4rem]">
          {t.hero.sub}
        </p>
      </div>

      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a href={WA_LINK} class="btn-primary inline-flex items-center justify-center !px-8 !py-3.5 text-[1.05rem]">
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#pricing"
          class="inline-flex min-h-[52px] items-center justify-center rounded-[var(--radius-md)] border-[1.5px] border-ink/30 px-8 py-3.5 text-[1.05rem] font-semibold text-ink transition-colors hover:border-ink"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="relative justify-self-center lg:justify-self-end lg:pe-10">
      <!-- brass-deep circle echo on light -->
      <div
        class="pointer-events-none absolute start-1/2 top-1/2 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-brass-deep/[0.14] rtl:translate-x-1/2"
        aria-hidden="true"
      ></div>
      <div class="rotate-[-5deg]">
        <PhoneChat
          client:visible
          rtlChat={true}
          restaurant={t.hero.restaurant}
          status={t.hero.chatStatus}
          demoLabel={t.hero.demoLabel}
          replayLabel={t.hero.replay}
          chat={t.hero.chat}
        />
      </div>
    </div>
  </div>
</section>
