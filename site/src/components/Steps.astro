---
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section id="how" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <h2 class="h-rule rule-center text-center" data-reveal>{t.steps.h2}</h2>

    <ol class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-3">
      {t.steps.items.map((s, i) => (
        <li class="card relative overflow-hidden p-7" data-reveal style={`transition-delay:${i * 90}ms`}>
          <!-- oversized numeral, brass, quiet -->
          <span
            class="num pointer-events-none absolute -top-5 end-3 text-[6.5rem] font-medium leading-none text-brass-deep/[0.13]"
            aria-hidden="true"
          >{i + 1}</span>
          <span class="num flex h-11 w-11 items-center justify-center rounded-full bg-ink text-[1.05rem] font-medium text-brass">
            {i + 1}
          </span>
          <h3 class="mt-5 text-[1.2rem]">{s.title}</h3>
          <p class="mt-2.5 leading-relaxed text-ink/80">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
