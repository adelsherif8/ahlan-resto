---
/** It understands your customers — the translation table. */
import type { SiteContent } from '../content/types';
import Understanding from './Understanding';

interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section id="features" class="section">
  <div class="container-page">
    <h2 class="h-rule rule-center text-center" data-reveal>{t.understands.h2}</h2>
    <div class="mx-auto mt-12 max-w-6xl" data-reveal>
      <Understanding client:visible labels={t.understands.table} />
    </div>
  </div>
</section>
