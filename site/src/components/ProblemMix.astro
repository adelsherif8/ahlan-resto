---
/** Problem — the mix: all copy in one column (headline, argument, pull quote,
    the per-order stat), the monthly statement card alone opposite it. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="border-y border-ink/[0.07] bg-semna">
  <div class="container-page section">
    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <!-- Text column (right in RTL) -->
      <div data-reveal>
        <div class="flex items-center gap-4">
          <span class="num text-[0.85rem] font-medium tracking-wide text-brass-deep">02</span>
          <span class="h-px flex-1 bg-ink/15" aria-hidden="true"></span>
        </div>

        <h2 class="mt-6">{t.problem.h2}</h2>

        <p class="mt-7 text-[1.1rem] leading-[1.9]">{t.problem.p1}</p>

        <blockquote class="mt-7 border-s-[3px] border-karkadeh ps-6">
          <p class="text-[1.3rem] font-semibold leading-[1.7] text-ink sm:text-[1.4rem]">
            {t.problem.p2}
          </p>
        </blockquote>

        <!-- the per-order cut, at scale -->
        <div class="mt-9 flex items-end gap-4" aria-label={t.problem.bar.app}>
          <span class="num text-[4.5rem] font-medium leading-[0.85] text-karkadeh sm:text-[5.5rem]">30</span>
          <div class="pb-1.5">
            <div class="num text-[1.3rem] font-medium leading-none text-ink/60" dir="ltr">/ 150</div>
            <p class="mt-1.5 max-w-[11rem] text-[0.9rem] leading-snug text-ink/75">{t.problem.bar.app}</p>
          </div>
        </div>
      </div>

      <!-- The statement, alone (left in RTL) -->
      <div class="justify-self-center" data-reveal style="transition-delay:90ms">
        <div class="w-[320px] rotate-[1.5deg] bg-[#FFFDF8] p-7 text-ink shadow-[0_2px_4px_rgba(20,17,16,0.05),0_32px_64px_-24px_rgba(20,17,16,0.32)]">
          <div class="flex items-baseline justify-between border-b border-dashed border-ink/25 pb-3">
            <span class="text-[1rem] font-bold">كشف عمولة شهري</span>
            <span class="text-[0.7rem] text-ink/65">مثال توضيحي</span>
          </div>
          <dl class="mt-5 space-y-3 text-[0.95rem]">
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">عدد الأوردرات</dt>
              <dd class="num font-medium">400</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">متوسط الأوردر</dt>
              <dd class="num font-medium">150</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink/70">إجمالي المبيعات</dt>
              <dd class="num font-medium">60,000</dd>
            </div>
          </dl>
          <div class="mt-5 flex items-baseline justify-between gap-3 border-t border-dashed border-ink/25 pt-4">
            <span class="font-semibold">العمولة (حوالي الخُمس)</span>
            <span class="num text-[1.7rem] font-semibold text-karkadeh" dir="ltr">−12,000</span>
          </div>
          <p class="mt-3 text-end text-[0.78rem] text-ink/65">جنيه، كل شهر</p>
        </div>
      </div>
    </div>
  </div>
</section>
