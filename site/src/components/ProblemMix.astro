---
/** Problem — the mix: editorial grid (giant stat + pull quote) with the monthly
    statement card as the magazine's inset figure. Per-order number on one side,
    per-month artifact on the other — the same arithmetic at two scales. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="border-y border-ink/[0.07] bg-semna">
  <div class="container-page section">
    <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <!-- Headline column: the claim, then the per-order cut at poster scale -->
      <div data-reveal>
        <div class="flex items-center gap-4">
          <span class="num text-[0.85rem] font-medium tracking-wide text-brass-deep">02</span>
          <span class="h-px flex-1 bg-ink/15" aria-hidden="true"></span>
        </div>
        <h2 class="mt-6">{t.problem.h2}</h2>

        <div class="mt-10 flex items-end gap-4" aria-label={t.problem.bar.app}>
          <span class="num text-[6.5rem] font-medium leading-[0.85] text-karkadeh sm:text-[8.5rem]">30</span>
          <div class="pb-2">
            <div class="num text-[1.6rem] font-medium leading-none text-ink/60" dir="ltr">/ 150</div>
            <p class="mt-2 max-w-[11rem] text-[0.95rem] leading-snug text-ink/75">{t.problem.bar.app}</p>
          </div>
        </div>
      </div>

      <!-- Body column: the argument, then the month it adds up to -->
      <div class="flex flex-col" data-reveal style="transition-delay:90ms">
        <p class="text-[1.15rem] leading-[1.9]">{t.problem.p1}</p>

        <blockquote class="mt-8 border-s-[3px] border-karkadeh ps-6">
          <p class="text-[1.4rem] font-semibold leading-[1.7] text-ink sm:text-[1.5rem]">
            {t.problem.p2}
          </p>
        </blockquote>

        <!-- the inset figure: what that 30 becomes in a month -->
        <div class="mt-10 self-center lg:self-start">
          <div class="w-[290px] rotate-[1.5deg] bg-[#FFFDF8] p-6 text-ink shadow-[0_2px_4px_rgba(20,17,16,0.05),0_28px_56px_-24px_rgba(20,17,16,0.3)]">
            <div class="flex items-baseline justify-between border-b border-dashed border-ink/25 pb-3">
              <span class="text-[0.95rem] font-bold">كشف عمولة شهري</span>
              <span class="text-[0.7rem] text-ink/50">مثال توضيحي</span>
            </div>
            <dl class="mt-4 space-y-2.5 text-[0.92rem]">
              <div class="flex justify-between gap-3">
                <dt class="text-ink/70">عدد الأوردرات</dt>
                <dd class="num font-medium">400</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-ink/70">متوسط الأوردر</dt>
                <dd class="num font-medium">150</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-ink/70">إجمالي المبيعات</dt>
                <dd class="num font-medium">60,000</dd>
              </div>
            </dl>
            <div class="mt-4 flex items-baseline justify-between gap-3 border-t border-dashed border-ink/25 pt-3">
              <span class="font-semibold">العمولة (حوالي الخُمس)</span>
              <span class="num text-[1.5rem] font-semibold text-karkadeh" dir="ltr">−12,000</span>
            </div>
            <p class="mt-3 text-end text-[0.75rem] text-ink/50">جنيه، كل شهر</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
