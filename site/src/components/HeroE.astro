---
/** Variant E — "Karkadeh": the deep hibiscus ground. Nobody else looks like this.
    Brand-legal: Semna on Karkadeh is an approved pair (7.5:1); brass stays off this ground. */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
import PhoneChat from './PhoneChat';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t } = Astro.props;
---

<section class="relative overflow-hidden bg-karkadeh">
  <div class="container-page relative grid items-center gap-14 pt-16 pb-20 md:pt-24 md:pb-28 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="relative z-10 max-w-[36rem]">
      <h1 class="text-semna">{t.hero.h1}</h1>

      <p class="mt-8 max-w-[34rem] text-[1.25rem] font-medium leading-relaxed text-semna/90 sm:text-[1.4rem]">
        {t.hero.sub}
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a
          href={WA_LINK}
          class="inline-flex min-h-[52px] items-center justify-center rounded-[var(--radius-md)] bg-semna px-8 py-3.5 text-[1.05rem] font-semibold text-karkadeh transition-colors hover:bg-white"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#pricing"
          class="inline-flex min-h-[52px] items-center justify-center rounded-[var(--radius-md)] border-[1.5px] border-semna/45 px-8 py-3.5 text-[1.05rem] font-semibold text-semna transition-colors hover:border-semna"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="relative justify-self-center lg:justify-self-end lg:pe-6">
      <!-- the mark's circle in semna, one echo -->
      <div
        class="pointer-events-none absolute start-1/2 top-1/2 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-semna/[0.18] rtl:translate-x-1/2"
        aria-hidden="true"
      ></div>
      <PhoneChat
        client:visible
        rtlChat={true}
        restaurant={t.hero.restaurant}
        status={t.hero.chatStatus}
        demoLabel={t.hero.demoLabel}
        replayLabel={t.hero.replay}
        chat={t.hero.chat}
      />
    </div>
  </div>
</section>
