---
/** Objections variant — the heading stays, the answers scroll past it. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
        <h2 class="h-rule">{t.objections.h2}</h2>
      </div>

      <dl class="divide-y divide-ink/10 border-y border-ink/10">
        {t.objections.items.map((o) => (
          <div class="py-6" data-reveal>
            <dt class="text-[1.1rem] font-semibold">{o.q}</dt>
            <dd class="mt-2 leading-relaxed text-ink/80">{o.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
