---
/** Objections variant — the heading stays, the answers scroll past it. */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.5fr_1.3fr] lg:gap-14">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <h2 class="h-rule">{t.objections.h2}</h2>
        <a
          href={WA_LINK}
          class="mt-7 hidden items-center gap-2 text-[0.98rem] font-medium text-karkadeh hover:text-[#741727] lg:inline-flex"
        >
          {t.closing.askMore}
          <span aria-hidden="true" class="rtl:-scale-x-100">←</span>
        </a>
      </div>

      <dl class="divide-y divide-ink/10 border-y border-ink/10">
        {t.objections.items.map((o) => (
          <div class="py-6" data-reveal>
            <dt class="text-[1.1rem] font-semibold">{o.q}</dt>
            <dd class="mt-2 leading-relaxed text-ink/80">{o.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
