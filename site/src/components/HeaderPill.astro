---
/** Header — the floating glass pill: detached capsule, frosted, sticky.
    The 2026 premium signal, in brand materials (semna glass, karkadeh CTA). */
import type { SiteContent } from '../content/types';
import { WA_LINK } from '../lib/const';

interface Props { t: SiteContent; lang: 'ar' | 'en' }
const { t, lang } = Astro.props;
---

<header class="sticky top-3 z-50 px-3">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-3 rounded-full border border-ink/[0.08] bg-[#F5EFE7]/80 py-2 ps-5 pe-2 shadow-[0_2px_10px_rgba(20,17,16,0.06),0_12px_32px_-16px_rgba(20,17,16,0.18)] backdrop-blur-md"
  >
    <a href={`/${lang}`} class="flex min-h-[44px] items-center" aria-label="Munadim">
      <img src="/brand/21-lockup-horizontal-light-nobg.svg" alt="Munadim" width="166" height="50" class="h-8 w-auto" />
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      <a href="#pricing" class="hidden min-h-[44px] items-center rounded-full px-4 font-medium text-ink/75 transition-colors hover:bg-ink/[0.05] hover:text-ink sm:flex">
        {t.nav.pricing}
      </a>
      <a
        href={t.nav.toggle.href}
        class="flex min-h-[44px] items-center rounded-full px-4 font-medium text-ink/60 transition-colors hover:bg-ink/[0.05] hover:text-ink"
        lang={lang === 'ar' ? 'en' : 'ar'}
        dir={lang === 'ar' ? 'ltr' : 'rtl'}
      >{t.nav.toggle.label}</a>
      <a
        href={WA_LINK}
        class="flex min-h-[44px] items-center justify-center rounded-full bg-karkadeh px-6 font-semibold text-semna transition-colors hover:bg-[#741727]"
      >{t.nav.cta}</a>
    </nav>
  </div>
</header>
