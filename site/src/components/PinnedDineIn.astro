---
/** The pinned section — the reference's "How big is it, really?" pattern:
    the artifact stays fixed while the facts scroll past it. Ours: the table
    with the code holds while the three beats of the capture scroll by. */
import type { SiteContent } from '../content/types';
import SectionMark from './SectionMark.astro';
interface Props { t: SiteContent }
const { t } = Astro.props;
const beats = [
  { n: '01', title: t.dineIn.scene.step1, body: t.dineIn.p1 },
  { n: '02', title: t.dineIn.scene.step2, body: t.dineIn.p2 },
  { n: '03', title: t.dineIn.scene.step3, body: t.dineIn.scene.captured },
];
---

<section id="dinein" class="relative bg-semna">
  <div class="container-page py-16 md:py-24">
    <SectionMark n="03" label="الصالة" />
    <h2 class="mt-6 max-w-[18ch]" data-rise>{t.dineIn.h2}</h2>

    <div class="mt-14 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <!-- the pinned artifact -->
      <div class="lg:sticky lg:top-28 lg:h-fit lg:self-start">
        <div class="relative mx-auto flex h-[300px] w-full max-w-[22rem] items-end justify-center overflow-hidden rounded-[var(--radius-lg)] bg-[#E7DCCB] sm:h-[360px]">
          <div class="absolute inset-x-0 bottom-0 h-[58%] bg-[#D8C9B2]" aria-hidden="true"></div>
          <div class="relative mb-10 w-[132px] rounded-t-[4px] bg-[#FFFDF8] px-4 pb-4 pt-3 text-center shadow-[0_14px_28px_-12px_rgba(20,17,16,0.5)]">
            <p class="truncate text-[10px] font-bold text-ink">{t.hero.restaurant}</p>
            <svg viewBox="0 0 44 44" class="mx-auto mt-2 h-16 w-16" role="img" aria-label="QR">
              <rect width="44" height="44" fill="#FFFDF8" />
              <g fill="#8C1D2F">
                <path d="M3 3h12v12H3zM6 6v6h6V6z" fill-rule="evenodd" />
                <path d="M29 3h12v12H29zM32 6v6h6V6z" fill-rule="evenodd" />
                <path d="M3 29h12v12H3zM6 32v6h6V32z" fill-rule="evenodd" />
                <rect x="20" y="4" width="4" height="4" /><rect x="20" y="12" width="4" height="4" />
                <rect x="18" y="20" width="5" height="5" /><rect x="27" y="22" width="4" height="4" />
                <rect x="35" y="20" width="4" height="4" /><rect x="6" y="20" width="4" height="4" />
                <rect x="20" y="29" width="4" height="4" /><rect x="28" y="31" width="5" height="4" />
                <rect x="22" y="37" width="4" height="4" /><rect x="36" y="36" width="5" height="5" />
              </g>
            </svg>
            <p class="mt-2 text-[8.5px] leading-tight text-ink/70">{t.dineIn.qr.scan}</p>
          </div>
        </div>
        <p class="mt-3 text-center text-[0.8rem] text-ink/45">{t.hero.demoLabel}</p>
      </div>

      <!-- the facts that scroll past it -->
      <ol class="space-y-14 lg:space-y-24">
        {beats.map((b) => (
          <li data-rise>
            <div class="flex items-center gap-3">
              <span class="num text-[0.78rem] font-medium tracking-[0.14em] text-brass-deep">{b.n}</span>
              <span class="h-px w-10 bg-ink/15" aria-hidden="true"></span>
            </div>
            <h3 class="mt-4 text-[1.5rem] sm:text-[1.85rem]">{b.title}</h3>
            <p class="mt-3 max-w-[34rem] text-[1.05rem] leading-relaxed text-ink/75">{b.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
