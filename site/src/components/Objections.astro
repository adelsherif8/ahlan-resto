---
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div class="container-text">
      <h2 class="h-rule" data-reveal>{t.objections.h2}</h2>

      <!-- Fully expanded — the buyer between shifts shouldn't tap to read -->
      <dl class="mt-6 divide-y divide-ink/10">
        {t.objections.items.map((o) => (
          <div class="py-7" data-reveal>
            <dt class="text-[1.15rem] font-semibold">{o.q}</dt>
            <dd class="mt-2.5 text-[1.05rem] text-ink/85">{o.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
