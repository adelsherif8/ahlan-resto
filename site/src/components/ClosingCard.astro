---
/** Closing variant — a card floating on karkadeh: the demo offer written out. */
import type { SiteContent } from '../content/types';
import { WA_LINK, WA_NUMBER_DISPLAY, CONTACT_EMAIL } from '../lib/const';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="bg-karkadeh">
  <div class="container-page section">
    <div class="card mx-auto max-w-2xl p-9 text-center sm:p-12" data-reveal>
      <h2 class="h-rule rule-center">{t.closing.h2}</h2>
      <p class="mx-auto mt-7 max-w-[34rem] text-[1.1rem] leading-relaxed text-ink/80">{t.closing.p}</p>
      <div class="mt-9 flex flex-col items-center gap-4">
        <a href={WA_LINK} class="btn-primary inline-flex w-full items-center justify-center !py-4 text-[1.1rem] sm:w-auto sm:!px-12">{t.closing.cta}</a>
        <a href={WA_LINK} class="num flex min-h-[44px] items-center text-[1.05rem] font-medium text-ink/75 hover:text-karkadeh" dir="ltr">{WA_NUMBER_DISPLAY}</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="text-[0.9rem] text-ink/65 hover:text-karkadeh" dir="ltr">{CONTACT_EMAIL}</a>
      </div>
    </div>
  </div>
</section>
