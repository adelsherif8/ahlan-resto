---
/** How it starts — the journey timeline. */
import type { SiteContent } from '../content/types';
import StepsJourney from './StepsJourney';

interface Props { t: SiteContent }
const { t } = Astro.props;

const labels = {
  steps: t.steps.items,
  demoLabel: t.hero.demoLabel,
  ...t.steps.journey,
};
---

<section id="how" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <h2 class="h-rule rule-center text-center" data-reveal>{t.steps.h2}</h2>
    <div class="mt-10" data-reveal>
      <StepsJourney client:visible labels={labels} />
    </div>
  </div>
</section>
