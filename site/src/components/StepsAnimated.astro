---
/** How it starts — the journey timeline. */
import type { SiteContent } from '../content/types';
import StepsJourney from './StepsJourney';

interface Props { t: SiteContent }
const { t } = Astro.props;

const labels = {
  steps: t.steps.items,
  demoLabel: t.hero.demoLabel,
  ...t.steps.journey,
};
---

<section id="how" class="surface-deep border-y border-ink/[0.07]">
  <div class="container-page section">
    <div class="container-text text-center" data-reveal>
      <p class="eyebrow eyebrow-center"><span class="num">04</span> {t.steps.h2} — إزاي بيبدأ</p>
      <h2>من صور المنيو لأول أوردر</h2>
    </div>
    <div class="mt-10" data-reveal>
      <StepsJourney client:visible labels={labels} />
    </div>
  </div>
</section>
