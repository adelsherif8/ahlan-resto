---
/** Problem variant B — the dark band: after a light hero, the pain gets the
    page's one heavy block. */
import type { SiteContent } from '../content/types';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="on-ink bg-ink">
  <div class="container-page section">
    <div class="container-text" data-reveal>
      <h2 class="h-rule text-semna">{t.problem.h2}</h2>
      <p class="mt-7 text-[1.1rem] text-semna/85">{t.problem.p1}</p>
      <p class="mt-4 text-[1.1rem] font-medium text-semna">{t.problem.p2}</p>
    </div>

    <!-- The fifth, drawn on the dark ground -->
    <div class="container-text mt-9" data-reveal>
      <div class="flex h-16 overflow-hidden rounded-[var(--radius-md)] border border-semna/15">
        <div class="flex w-4/5 items-center px-5">
          <span class="num text-[1.05rem] font-medium text-semna">120</span>
        </div>
        <div class="flex w-1/5 items-center justify-center bg-karkadeh px-2">
          <span class="num text-[1.05rem] font-medium text-semna">30</span>
        </div>
      </div>
      <div class="mt-3 flex items-center justify-between gap-4">
        <span class="text-[0.95rem] text-semna/70">{t.problem.bar.order}</span>
        <span class="text-[0.95rem] font-semibold text-semna">{t.problem.bar.app}</span>
      </div>
    </div>
  </div>
</section>
