---
// Trust-strip variants sandwiched in context: end of Understands above, start of Pricing below.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Understands from '../../components/Understands.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import TrustNumeral from '../../components/TrustNumeral.astro';
import TrustRibbon from '../../components/TrustRibbon.astro';
import Pricing from '../../components/Pricing.astro';
import { ar as t } from '../../content/ar';
---

<Base lang="ar" title="معاينة سطر الثقة" description="Trust strip variants" path="/preview/trust">
  <Header t={t} lang="ar" />
  <main>
    <Understands t={t} />
    <TrustStrip t={t} />
    <TrustNumeral t={t} />
    <TrustRibbon t={t} />
    <Pricing t={t} />
  </main>
</Base>
