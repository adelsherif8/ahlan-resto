---
// WhatIs variants stacked: flow diagram → record card → current (pills).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import WhatIsStream from '../../components/WhatIsStream.astro';
import WhatIsFlow from '../../components/WhatIsFlow.astro';
import WhatIsRecord from '../../components/WhatIsRecord.astro';
import WhatIs from '../../components/WhatIs.astro';
import { ar as t } from '../../content/ar';
---

<Base lang="ar" title="معاينة قسم القناة" description="WhatIs section variants" path="/preview/whatis">
  <Header t={t} lang="ar" />
  <main class="[&>section+section]:mt-2">
    <WhatIsStream t={t} />
    <WhatIsFlow t={t} />
    <WhatIsRecord t={t} />
    <WhatIs t={t} />
  </main>
</Base>
