---
import Base from '../../layouts/Base.astro';
import FooterColumns from '../../components/FooterColumns.astro';
import FooterSplit from '../../components/FooterSplit.astro';
import FooterPaper from '../../components/FooterPaper.astro';
import FooterGiantAr from '../../components/FooterGiantAr.astro';
import FooterGiant from '../../components/FooterGiant.astro';
import { ar as t } from '../../content/ar';
---

<Base lang="ar" title="معاينة — الفوتر" description="Footer variants" path="/preview/footers">
  <main>
    <FooterColumns t={t} lang="ar" />
    <div class="h-8 bg-semna"></div>
    <FooterSplit t={t} lang="ar" />
    <div class="h-8 bg-ink"></div>
    <FooterPaper t={t} lang="ar" />
    <div class="h-8 bg-semna"></div>
    <FooterGiantAr t={t} lang="ar" />
    <div class="h-8 bg-ink"></div>
    <FooterGiant t={t} lang="ar" />
  </main>
</Base>
