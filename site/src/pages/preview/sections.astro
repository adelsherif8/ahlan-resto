---
// Full-page preview with ALL section variants swapped in:
// dark problem band + bento understands + calculator pricing.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import ProblemDark from '../../components/ProblemDark.astro';
import WhatIs from '../../components/WhatIs.astro';
import DineIn from '../../components/DineIn.astro';
import Steps from '../../components/Steps.astro';
import UnderstandsBento from '../../components/UnderstandsBento.astro';
import PricingCalc from '../../components/PricingCalc.astro';
import Objections from '../../components/Objections.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import { ar as t } from '../../content/ar';
---

<Base lang="ar" title="معاينة الأقسام" description="Section variants preview" path="/preview/sections">
  <Header t={t} lang="ar" />
  <main>
    <Hero t={t} lang="ar" />
    <ProblemDark t={t} />
    <WhatIs t={t} />
    <DineIn t={t} />
    <Steps t={t} />
    <UnderstandsBento t={t} />
    <PricingCalc t={t} />
    <Objections t={t} />
    <Closing t={t} />
  </main>
  <Footer t={t} lang="ar" />
</Base>
