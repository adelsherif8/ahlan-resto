---
// Koffee Kulture — a concept of the café's own brand site (noindex; credited in the footer).
// Art direction follows playful brand sites (Oatly, Graza, Liquid Death, Crumbl): cream canvas,
// full-bleed colour bands, 2px ink outlines with hard offset shadows, one chunky display face,
// packaging (the kans) as the hero object, the moon-faced characters in every section.
// The menu is the LIVE menu, read at build time from the same API the table chat uses, so every
// "+" lands in the chat's cart by exact name. Photos are KK's own (Talabat/menu shots); the
// white-background ones are blended into their tiles with mix-blend-mode: multiply.
import Base from '../../layouts/Base.astro';

const FLOWS = 'https://flows.munadim.com';
const DEMO_TOKEN = 'v1.eyJ2IjoxLCJiIjoiYXJrYW4iLCJ0IjoiREVNTyIsInIiOiJkMGNkMmM4Ni0xN2UyLTQ4ZTUtOTc0MC1hOGM5MWMxZWE2ZDkifQ.76OJRQTeb-Q9lGOrgh_9of6TdWfAe833W4GHkgjEQ7Y';
const widgetUrl = `${FLOWS}/t/${DEMO_TOKEN}?r=koffee-kulture`;
const I = '/koffee';

type LiveItem = { name: string; description?: string; price: number; price_l?: number | null; bestseller?: boolean; photo?: string | null };
const live = await fetch(`${FLOWS}/api/widget/menu?slug=koffee-kulture&token=${encodeURIComponent(DEMO_TOKEN)}`).then((r) => r.json());
if (!live?.categories?.length) throw new Error('KK menu unavailable at build time');
const cats: { name: string; items: LiveItem[] }[] = live.categories.filter((c: any) => c.items?.length);

// KK's own photos, by exact menu name. white = studio shot on white → blended into the tile
const PHOTO: Record<string, [string, boolean]> = {
  'Blended Dirty Matcha': ['dirty-matcha.jpg', true], 'Pink Redbull': ['pink-redbull.jpg', true],
  'Philly Steak Bagel': ['philly-bagel.jpg', true], 'Kulture Bagel': ['kulture-bagel.jpg', true],
  'Almond Salted Caramel Cake': ['almond-cake.jpg', true], 'Chocolate Chip Cookie': ['choc-cookie.jpg', true],
  'Kinder Cookie': ['kinder-cookie.jpg', true], 'Brookies': ['brookies.jpg', true],
  'Salted Caramel Tres Leches': ['tresleches.jpg', false],
};
const CHARS = ['char-chair', 'char-sip', 'char-walk', 'char-dance', 'char-travel', 'char-guitar', 'char-kroissant', 'char-hug'];
// local shots first, else KK's own product photo from the live menu (studio shots on white → blended)
const photoOf = (i: LiveItem): [string, boolean] | null => PHOTO[i.name] ? [`${I}/${PHOTO[i.name][0]}`, PHOTO[i.name][1]] : i.photo ? [i.photo, true] : null;
const CAT_CHAR = ['char-chair', 'char-sip', 'char-dance', 'char-hug', 'char-walk', 'char-guitar', 'char-kroissant', 'char-travel'];
const TINTS = ['#FFE1EF', '#DDF3D8', '#FFF0C2', '#FFE6D6', '#E6EEFF', '#F1E6FF'];
const short = (n: string) => n.replace(/ Kulture$/, '').replace(/^The /, '');
const priceOf = (i: LiveItem) => (i.price_l ? `${i.price} / ${i.price_l}` : `${i.price}`);
const slugOf = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const favNames = ['Spanish Latte', 'Pistachio Konafa Kroissant', 'The LA Benedict', 'San Sebastian Cheesecake'];
const all = cats.flatMap((c) => c.items);
const favs = favNames.map((n) => all.find((i) => i.name === n)).filter(Boolean) as LiveItem[];
const favArt = [['char-sip', '#FFE1EF'], ['char-kroissant', '#FFF0C2'], ['char-travel', '#DDF3D8'], ['char-guitar', '#FFE6D6']];

const kans = [
  { name: 'Blended Dirty Matcha', line: 'Espresso over matcha, sealed cold', img: 'dirty-matcha.jpg', white: true, bg: '#DDF3D8' },
  { name: 'Pink Redbull', line: 'Red Bull, strawberry, vanilla-cherry', img: 'pink-redbull.jpg', white: true, bg: '#FFE1EF' },
];
const marquee = ['Different People', 'Different Kultures', 'Different Koffee Kups'];
const words = ['Spanish Latte', 'Dirty Matcha', 'Konafa Kroissant', 'Pink Redbull', 'Philly Bagel', 'Brookies', 'Salted Karamel', 'Love Story'];
const branches = [
  { area: 'Sheikh Zayed & Palm Hills', list: [['Arkan Plaza', 'Sheikh Zayed'], ['Golf Central', 'Palm Hills']] },
  { area: 'New Cairo', list: [['U Venues', 'New Cairo'], ['District 5', 'New Cairo'], ['O1 Kitchen Mall', 'New Cairo'], ['Lake District', 'Mivida'], ['Ivory', 'Villette by Sodic']] },
];
const maps = (b: string, a: string) => `https://www.google.com/maps/search/${encodeURIComponent(`Koffee Kulture ${b} ${a}`)}`;
---

<Base
  lang="en"
  title="Koffee Kulture — Different People. Different Kultures. Different Koffee Kups."
  description="Specialty koffee, matcha, kroissants, bagels and koffee in a kan — seven branches across Sheikh Zayed and New Cairo. Order from your table."
  path="koffee-kulture"
  noindex
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="kk">
    <div class="ann"><span><i class="fa-solid fa-clock"></i> Open every day 7:30 AM – midnight</span><span class="sep">✱</span><span>7 branches · Sheikh Zayed &amp; New Cairo</span><span class="sep">✱</span><button data-open-chat>Order from your table <i class="fa-solid fa-arrow-right"></i></button></div>

    <header class="top" id="topbar">
      <a class="brand" href="#top" aria-label="Koffee Kulture home"><img src={`${I}/logo.jpg`} alt="" width="46" height="46" /><span>Koffee<br />Kulture</span></a>
      <nav aria-label="Sections"><a href="#menu">Menu</a><a href="#kans">Kans</a><a href="#table">At the table</a><a href="#branches">Branches</a></nav>
      <button class="btn pri order" data-open-chat><i class="fa-solid fa-basket-shopping"></i><span>Order</span><b class="count" data-count hidden>0</b></button>
    </header>

    <!-- HERO: the slogan, the kans, the characters -->
    <section class="hero" id="top">
      <div class="copy">
        <p class="kick"><i class="fa-solid fa-mug-hot"></i> Specialty koffee &amp; breakfast kulture</p>
        <h1 aria-label="Different People. Different Kultures. Different Koffee Kups.">
          <span class="ln"><span class="w" style="--d:0">Different</span> <span class="w" style="--d:1">People.</span></span>
          <span class="ln"><span class="w" style="--d:2">Different</span> <span class="w pk" style="--d:3">Kultures.</span></span>
          <span class="ln"><span class="w" style="--d:4">Different</span> <span class="w gr" style="--d:5">Koffee&nbsp;Kups.</span></span>
        </h1>
        <p class="lede">Espresso pulled to order, matcha whisked by hand, kroissants baked all day — and koffee you take home in a kan.</p>
        <div class="ctas">
          <button class="btn pri big" data-open-chat><i class="fa-solid fa-comment-dots"></i>Order from your table</button>
          <a class="btn big" href="#menu"><i class="fa-solid fa-book-open"></i>See the menu</a>
        </div>
        <p class="open"><span class="dot"></span><span id="open-state">Open every day 7:30 AM – midnight</span></p>
      </div>
      <div class="stage" id="stage" aria-hidden="true">
        <div class="blob"></div>
        <div class="tile t1" data-depth="10"><img class="mult" src={`${I}/pink-redbull.jpg`} alt="" /></div>
        <div class="tile t2" data-depth="18"><img class="mult" src={`${I}/dirty-matcha.jpg`} alt="" /></div>
        <img class="ch c1" src={`${I}/char-sip.png`} alt="" data-depth="26" />
        <img class="ch c2" src={`${I}/char-dance.png`} alt="" data-depth="-14" />
        <svg class="seal" viewBox="0 0 200 200" data-depth="-8"><defs><path id="circ" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs><circle cx="100" cy="100" r="96" /><text><textPath href="#circ">KAN KULTURE ✱ SEALED FRESH ✱ TAKE IT HOME ✱ </textPath></text><text x="100" y="116" text-anchor="middle" class="k">K</text></svg>
        <span class="spark s1">✱</span><span class="spark s2">✱</span><span class="spark s3">✱</span>
      </div>
    </section>

    <div class="marq" aria-hidden="true"><div class="track">{[0, 1, 2, 3].map(() => marquee.map((m) => <span>{m}<i>✱</i></span>))}</div></div>

    <!-- KAN KULTURE: packaging as the hero object -->
    <section class="band green kans" id="kans">
      <div class="wrap">
        <div class="head reveal"><p class="tag"><i class="fa-solid fa-bolt"></i> Kan Kulture</p><h2>Koffee in a kan.</h2><p class="sub">Iced, sealed and made to travel. The thing everyone photographs.</p></div>
        <div class="kgrid">
          <figure class="kt photo reveal" style="--r:-2deg"><img src={`${I}/hero-can.jpg`} alt="A Koffee Kulture kan held up at the beach" loading="lazy" /><figcaption>Beach-proof.</figcaption></figure>
          {kans.map((k, i) => (
            <article class="kt can reveal" style={`--bg:${k.bg};--r:${i ? 2 : -1}deg`}>
              <div class="art"><img class="mult" src={`${I}/${k.img}`} alt={k.name} loading="lazy" /></div>
              <div class="meta"><h3>{k.name}</h3><p>{k.line}</p></div>
              <button class="add" data-add={k.name} aria-label={`Add ${k.name}`}><i class="fa-solid fa-plus"></i></button>
            </article>
          ))}
          <figure class="kt photo reveal" style="--r:1.5deg"><img src={`${I}/matcha-cans.jpg`} alt="Matcha kans" loading="lazy" /><figcaption>Matcha, sealed fresh.</figcaption></figure>
          <figure class="kt photo wide reveal" style="--r:-1deg"><img src={`${I}/cans.jpg`} alt="Refresher kans" loading="lazy" /><figcaption>Refreshers in a kan.</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- KROWD FAVOURITES -->
    <section class="favs" id="favs">
      <div class="wrap">
        <div class="head reveal"><p class="tag pinktag"><i class="fa-solid fa-star"></i> Krowd favourites</p><h2>What everyone orders.</h2></div>
        <div class="fgrid">
          {favs.map((f, i) => (
            <article class="fav reveal" style={`--bg:${favArt[i][1]};--d:${i}`}>
              <div class={`art${photoOf(f) ? ' real' : ''}`}>{photoOf(f) ? <img class="mult" src={photoOf(f)![0]} alt={f.name} loading="lazy" /> : <img src={`${I}/${favArt[i][0]}.png`} alt="" loading="lazy" />}</div>
              <h3>{f.name}</h3><p>{f.description}</p>
              <div class="row"><span class="price">{priceOf(f)} <small>EGP</small></span><button class="add" data-add={f.name} aria-label={`Add ${f.name}`}><i class="fa-solid fa-plus"></i></button></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FULL MENU (live) -->
    <section class="menu" id="menu">
      <div class="wrap">
        <div class="head reveal"><p class="tag"><i class="fa-solid fa-book-open"></i> The menu</p><h2>Pick something. <span class="pkt">Or ask the chat.</span></h2><p class="sub">Prices in EGP, VAT inclusive · Medium / Large where you see two prices · Tap <b>+</b> to pick size, milk and extras — it goes straight into your table order.</p></div>
        <div class="mbar">
          <div class="tabs" role="tablist">{cats.map((c, i) => <button class={`tab${i ? '' : ' on'}`} data-tab={slugOf(c.name)} role="tab">{short(c.name)}</button>)}</div>
          <label class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="q" placeholder="Search 200+ items — matcha, pistachio, bagel…" autocomplete="off" /></label>
        </div>
        <div class="board">
          {cats.map((c, ci) => (
            <div class={`cat${ci ? '' : ' on'}`} data-cat={slugOf(c.name)}>
              <aside class="cathead" style={`--bg:${TINTS[ci % TINTS.length]}`}>
                <img src={`${I}/${CAT_CHAR[ci % CAT_CHAR.length]}.png`} alt="" loading="lazy" />
                <h3>{short(c.name)}</h3><p>{c.items.length} on the menu{c.items.some((i) => i.price_l) ? ' · M / L' : ''}</p>
              </aside>
              <div class="rows">
                {c.items.map((it, j) => {
                  const ph = photoOf(it);
                  return (
                    <article class="item" data-name={`${it.name} ${it.description || ''}`.toLowerCase()}>
                      {ph ? <div class={`thumb${ph[1] ? '' : ' cover'}`} style={`--bg:${TINTS[(ci + j) % TINTS.length]}`}><img class={ph[1] ? 'mult' : ''} src={ph[0]} alt={it.name} loading="lazy" /></div>
                        : <div class="thumb chr" style={`--bg:${TINTS[(ci + j) % TINTS.length]}`}><img src={`${I}/${CHARS[(ci * 5 + j * 3) % CHARS.length]}.png`} alt="" loading="lazy" /></div>}
                      <div class="txt"><h4>{it.name}{it.bestseller && <span class="pop"><i class="fa-solid fa-star"></i> Popular</span>}</h4>{it.description && <p>{it.description}</p>}</div>
                      <span class="price">{priceOf(it)}<small>EGP</small></span>
                      <button class="add" data-add={it.name} aria-label={`Add ${it.name}`}><i class="fa-solid fa-plus"></i></button>
                    </article>
                  );
                })}
              </div>
            </div>
          ))}
          <p class="empty" id="empty" hidden><img src={`${I}/char-walk.png`} alt="" width="90" /> Nothing by that name — ask the chat, it knows the whole menu.</p>
        </div>
      </div>
    </section>

    <!-- AT THE TABLE: the live chat -->
    <section class="band pink tablesec" id="table">
      <div class="wrap tgrid">
        <div class="tcopy">
          <p class="tag inv"><i class="fa-solid fa-qrcode"></i> At the table</p>
          <h2>Sit down. Scan.<br />Your order's on its way.</h2>
          <ol class="steps">
            <li class="reveal"><b>1</b><div><h3>Scan the code on your table</h3><p>The chat opens already knowing where you're sitting. No app, no sign-up.</p></div></li>
            <li class="reveal"><b>2</b><div><h3>Tap the menu or just say it</h3><p>"Iced Spanish, oat, large" — English, Arabic or Franco. Fill a cart while you chat.</p></div></li>
            <li class="reveal"><b>3</b><div><h3>Watch it come to you</h3><p>Received, making, ready, served — live on your phone, to your table.</p></div></li>
          </ol>
          <ul class="perks">
            <li><i class="fa-solid fa-user-check"></i>Remembers your usual</li>
            <li><i class="fa-solid fa-bell-concierge"></i>Call staff in one tap</li>
            <li><i class="fa-solid fa-users"></i>Friends order to the same table</li>
            <li><i class="fa-solid fa-receipt"></i>Bill on your phone</li>
          </ul>
          <button class="btn ink big" data-open-chat><i class="fa-solid fa-comment-dots"></i>Try it now</button>
        </div>
        <div class="phone-wrap">
          <img class="ch pc" src={`${I}/char-walk.png`} alt="" loading="lazy" />
          <div class="phone"><iframe id="demoFrame" title="Koffee Kulture table chat — live" allow="geolocation" loading="lazy" data-src={widgetUrl}></iframe></div>
        </div>
      </div>
    </section>

    <!-- THE KULTURE -->
    <section class="kulture">
      <div class="wrap kgrid2">
        <div class="kart reveal">
          <img class="k1" src={`${I}/char-hug.png`} alt="" loading="lazy" />
          <img class="k2" src={`${I}/char-guitar.png`} alt="" loading="lazy" />
          <img class="k3" src={`${I}/char-chair.png`} alt="" loading="lazy" />
        </div>
        <div class="kcopy reveal">
          <p class="tag pinktag"><i class="fa-solid fa-heart"></i> The Kulture</p>
          <h2>Different people. Same table.</h2>
          <p>Koffee Kulture is where Zayed and New Cairo slow down: a flat white before work, a matcha after the gym, a konafa kroissant you didn't plan on. Every kup made to order, every branch its own kind of hangout.</p>
          <p class="sig">— see you at the Kulture</p>
        </div>
      </div>
      <div class="wrap gal">
        <figure class="g1 reveal"><img src={`${I}/storefront.jpg`} alt="Koffee Kulture storefront with the green sculpture" loading="lazy" /></figure>
        <figure class="g2 reveal"><img src={`${I}/pancakes.jpg`} alt="Pancakes" loading="lazy" /></figure>
        <figure class="g3 reveal"><img src={`${I}/tresleches.jpg`} alt="Salted Karamel Tres Leches" loading="lazy" /></figure>
        <figure class="g4 reveal white"><img class="mult" src={`${I}/kulture-bagel.jpg`} alt="Kulture Bagel" loading="lazy" /></figure>
        <figure class="g5 reveal white"><img class="mult" src={`${I}/almond-cake.jpg`} alt="Almond salted caramel cake" loading="lazy" /></figure>
      </div>
    </section>

    <!-- BRANCHES -->
    <section class="band butter branches" id="branches">
      <div class="wrap">
        <div class="head reveal"><p class="tag inkt"><i class="fa-solid fa-location-dot"></i> Find your Kulture</p><h2>Seven homes. Every day, 7:30 to midnight.</h2></div>
        <div class="bgrid">
          {branches.map((g) => (
            <div class="bgroup reveal">
              <h3>{g.area}</h3>
              {g.list.map(([b, a]) => (
                <a class="br" href={maps(b, a)} target="_blank" rel="noopener"><span><b>{b}</b><small>{a}</small></span><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
              ))}
            </div>
          ))}
          <img class="ch bc" src={`${I}/char-travel.png`} alt="" loading="lazy" />
        </div>
      </div>
    </section>

    <footer class="band green foot">
      <div class="wrap">
        <div class="fw" aria-hidden="true">{words.map((w) => <span>{w}</span>)}</div>
        <div class="fbot">
          <div class="fbrand"><img src={`${I}/logo.jpg`} alt="" width="54" height="54" /><p><b>Koffee Kulture</b><br />Specialty koffee &amp; breakfast kulture · Sheikh Zayed &amp; New Cairo</p></div>
          <nav><a href="#menu">The Menu</a><a href="#kans">Kan Kulture</a><a href="#table">At the Table</a><a href="#branches">Branches</a></nav>
        </div>
        <p class="credit">A concept site for Koffee Kulture by <a href="/en/">Munadim</a> — the table ordering on this page is live. Not the official Koffee Kulture website.</p>
      </div>
      <img class="ch fc" src={`${I}/char-sip.png`} alt="" loading="lazy" />
    </footer>

    <!-- toast + mobile order bar + chat panel -->
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <div class="mbar-fixed"><button class="btn pri big" data-open-chat><i class="fa-solid fa-basket-shopping"></i><span id="mlabel">Order from your table</span><b class="count" data-count hidden>0</b></button></div>
    <button class="bubble" id="kk-bubble" data-open-chat aria-label="Order from your table"><i class="fa-solid fa-comment-dots"></i><i class="fa-solid fa-xmark"></i><b class="count" data-count hidden>0</b></button>
    <div class="chat" id="kk-panel" aria-hidden="true"><iframe id="kk-frame" title="Koffee Kulture — order from your table" allow="geolocation" data-src={widgetUrl}></iframe></div>
  </div>

<style>
  .kk { --g:#22A447; --g2:#14822f; --pink:#F26BAE; --pk2:#d94c95; --butter:#FFD54A; --cream:#FFF4E4; --ink:#1B1B1B; --muted:#5f5a52;
    --disp:"Bagel Fat One", ui-rounded, system-ui, sans-serif; --ease:cubic-bezier(.2,.8,.2,1); --pop:cubic-bezier(.34,1.56,.64,1);
    font-family:"Rubik", system-ui, sans-serif; color:var(--ink); background:var(--cream); overflow-x:clip; font-size:17px; line-height:1.5; }
  .kk *, .kk *::before { box-sizing:border-box; }
  .kk h1, .kk h2, .kk h3, .kk h4 { font-family:var(--disp); font-weight:400; margin:0; letter-spacing:-.01em; }
  .kk img { max-width:100%; display:block; }
  .kk [hidden] { display:none !important; }
  .wrap { max-width:1240px; margin:0 auto; padding:0 24px; position:relative; }
  .band { position:relative; }
  .band.green { background:var(--g); color:#fff; } .band.pink { background:var(--pink); color:var(--ink); } .band.butter { background:var(--butter); }

  /* buttons: pill, 2px ink outline, hard offset shadow */
  .btn { display:inline-flex; align-items:center; gap:10px; font:600 15px/1 "Rubik",sans-serif; color:var(--ink); background:#fff; border:2px solid var(--ink); border-radius:999px; padding:12px 18px; cursor:pointer; text-decoration:none; box-shadow:3px 3px 0 var(--ink); transition:transform .15s var(--ease), box-shadow .15s var(--ease); position:relative; }
  .btn:hover { transform:translate(-2px,-2px); box-shadow:5px 5px 0 var(--ink); } .btn:active { transform:translate(2px,2px); box-shadow:1px 1px 0 var(--ink); }
  .btn.pri { background:var(--g); color:#fff; } .btn.ink { background:var(--ink); color:#fff; box-shadow:3px 3px 0 #fff; }
  .btn.big { font-size:17px; padding:16px 24px; }
  .count { min-width:22px; height:22px; padding:0 6px; border-radius:11px; background:var(--pink); color:var(--ink); border:2px solid var(--ink); font:700 12px/18px "Rubik",sans-serif; text-align:center; }
  .count.bump { animation:bump .5s var(--pop); }
  @keyframes bump { 40% { transform:scale(1.5) rotate(-10deg); } }

  .ann { background:var(--ink); color:#fff; font-size:13.5px; font-weight:500; display:flex; justify-content:center; align-items:center; gap:14px; padding:9px 16px; flex-wrap:wrap; text-align:center; }
  .ann i { color:var(--butter); } .ann .sep { color:var(--pink); }
  .ann button { font:inherit; color:var(--butter); background:none; border:0; cursor:pointer; text-decoration:underline; text-underline-offset:3px; }

  .top { position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:24px; padding:12px 24px; background:var(--cream); border-bottom:2px solid transparent; transition:border-color .2s, padding .2s; }
  .top.scrolled { border-color:var(--ink); padding:8px 24px; }
  .brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); font:400 18px/1 var(--disp); }
  .brand img { width:46px; height:46px; object-fit:cover; border-radius:12px; border:2px solid var(--ink); }
  .top nav { display:flex; gap:6px; margin-left:auto; }
  .top nav a { color:var(--ink); text-decoration:none; font-weight:600; font-size:15px; padding:8px 14px; border-radius:999px; transition:background .15s; }
  .top nav a:hover { background:#fff; box-shadow:inset 0 0 0 2px var(--ink); }

  /* HERO */
  .hero { max-width:1360px; margin:0 auto; padding:40px 24px 70px; display:grid; grid-template-columns:1.25fr .75fr; gap:30px; align-items:center; }
  .kick { display:inline-flex; gap:8px; align-items:center; font-weight:600; font-size:14px; letter-spacing:.06em; text-transform:uppercase; background:#fff; border:2px solid var(--ink); border-radius:999px; padding:7px 14px; margin:0 0 22px; }
  .kick i { color:var(--g); }
  .hero h1 { font-size:clamp(40px, 5.5vw, 94px); line-height:.9; letter-spacing:-.02em; }
  .hero h1 .ln { display:block; white-space:nowrap; }
  .hero h1 .w { display:inline-block; animation:wordIn .7s var(--pop) both; animation-delay:calc(var(--d) * 90ms + 100ms); }
  .hero h1 .pk { color:var(--pink); -webkit-text-stroke:2px var(--ink); paint-order:stroke fill; }
  .hero h1 .gr { color:var(--g); -webkit-text-stroke:2px var(--ink); paint-order:stroke fill; }
  @keyframes wordIn { from { opacity:0; transform:translateY(40px) rotate(6deg) scale(.9); } }
  .lede { font-size:19px; max-width:520px; margin:24px 0 28px; color:#3b3832; }
  .ctas { display:flex; gap:14px; flex-wrap:wrap; }
  .open { display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600; margin:22px 0 0; }
  .open .dot { width:10px; height:10px; border-radius:50%; background:var(--g); box-shadow:0 0 0 0 rgba(34,164,71,.5); animation:ping 1.8s infinite; }
  .open.closed .dot { background:#c9573c; animation:none; }
  @keyframes ping { 70% { box-shadow:0 0 0 10px rgba(34,164,71,0); } 100% { box-shadow:0 0 0 0 rgba(34,164,71,0); } }

  .stage { position:relative; aspect-ratio:1/1.02; max-width:600px; width:100%; justify-self:center; }
  .stage > * { position:absolute; transition:translate .4s var(--ease); }
  .blob { inset:8% 4% 6% 8%; background:var(--pink); border:2px solid var(--ink); border-radius:58% 42% 50% 50% / 46% 54% 46% 54%; animation:morph 12s ease-in-out infinite; box-shadow:8px 8px 0 var(--ink); }
  @keyframes morph { 50% { border-radius:42% 58% 38% 62% / 58% 40% 60% 42%; } }
  .tile { background:#fff; border:2px solid var(--ink); border-radius:28px; overflow:hidden; box-shadow:6px 6px 0 var(--ink); isolation:isolate; }
  .tile img { width:100%; height:100%; object-fit:cover; }
  .t1 { width:38%; height:52%; left:14%; top:14%; background:#FFE1EF; rotate:-7deg; animation:bob 5s ease-in-out infinite; }
  .t2 { width:38%; height:52%; left:48%; top:24%; background:#DDF3D8; rotate:6deg; animation:bob 5s ease-in-out infinite -2.5s; }
  .t1 img, .t2 img { object-fit:contain; padding:10px; transform:scale(1.25); }
  @keyframes bob { 50% { transform:translateY(-14px); } }
  .ch { pointer-events:none; }
  .c1 { width:56%; left:-6%; bottom:-4%; animation:sway 6s ease-in-out infinite; transform-origin:50% 100%; filter:drop-shadow(3px 3px 0 rgba(0,0,0,.15)); }
  .c2 { width:30%; right:-2%; top:-4%; animation:sway 4.4s ease-in-out infinite -1s; transform-origin:50% 100%; }
  @keyframes sway { 50% { transform:rotate(3deg) translateY(-4px); } }
  .seal { width:30%; right:2%; bottom:6%; animation:spin 18s linear infinite; }
  .seal circle { fill:var(--butter); stroke:var(--ink); stroke-width:3; } .seal text { font:700 15px "Rubik",sans-serif; letter-spacing:.14em; fill:var(--ink); }
  .seal .k { font:400 56px var(--disp); letter-spacing:0; fill:var(--g); stroke:var(--ink); stroke-width:2; paint-order:stroke; }
  @keyframes spin { to { rotate:360deg; } }
  .spark { color:var(--g); font:400 40px var(--disp); animation:twinkle 2.6s ease-in-out infinite; }
  .s1 { left:2%; top:6%; } .s2 { right:30%; top:2%; color:var(--ink); font-size:26px; animation-delay:-.8s; } .s3 { left:48%; bottom:2%; color:var(--pink); animation-delay:-1.6s; }
  @keyframes twinkle { 50% { transform:scale(.6) rotate(45deg); opacity:.6; } }

  /* marquee */
  .marq { background:var(--ink); color:var(--cream); border-block:2px solid var(--ink); overflow:hidden; rotate:-1.2deg; margin:0 -20px; position:relative; z-index:2; }
  .marq .track { display:flex; width:max-content; animation:slide 30s linear infinite; }
  .marq span { font:400 clamp(26px,3.4vw,44px)/1 var(--disp); padding:16px 0; white-space:nowrap; display:inline-flex; align-items:center; }
  .marq span:nth-child(3n+2) { color:var(--pink); } .marq span:nth-child(3n) { color:#7fe39a; }
  .marq i { font-style:normal; color:var(--butter); padding:0 26px; }
  @keyframes slide { to { transform:translateX(-50%); } }

  /* section heads */
  .head { margin-bottom:36px; max-width:760px; }
  .tag { display:inline-flex; gap:8px; align-items:center; font-weight:700; font-size:13px; letter-spacing:.08em; text-transform:uppercase; padding:7px 13px; border-radius:999px; background:#fff; color:var(--g2); border:2px solid var(--ink); margin:0 0 16px; }
  .tag.pinktag { color:var(--pk2); } .tag.inv { background:var(--ink); color:#fff; } .tag.inkt { color:var(--ink); }
  .kk h2 { font-size:clamp(40px, 5.6vw, 80px); line-height:.95; }
  .sub { font-size:18px; margin:14px 0 0; opacity:.85; }
  .pkt { color:var(--pink); -webkit-text-stroke:2px var(--ink); paint-order:stroke fill; }

  /* KANS */
  .kans { padding:110px 0 100px; }
  .kans .tag { color:var(--g2); }
  .kgrid { display:grid; grid-template-columns:repeat(4, 1fr); grid-auto-rows:300px; gap:20px; }
  .kt { margin:0; border:2px solid var(--ink); border-radius:28px; overflow:hidden; position:relative; box-shadow:6px 6px 0 var(--ink); rotate:var(--r); transition:rotate .3s var(--pop), transform .3s var(--pop), box-shadow .3s; background:#fff; color:var(--ink); }
  .kt:hover { rotate:0deg; transform:translateY(-6px); box-shadow:10px 10px 0 var(--ink); }
  .kt.photo img { width:100%; height:100%; object-fit:cover; transition:transform .6s var(--ease); }
  .kt.photo:hover img { transform:scale(1.06); }
  .kt figcaption { position:absolute; left:12px; bottom:12px; background:#fff; border:2px solid var(--ink); border-radius:999px; padding:6px 12px; font-weight:700; font-size:14px; }
  .kt.photo:first-child { grid-row:span 2; }
  .kt.wide { grid-column:span 3; }
  .kt.can { background:var(--bg); grid-row:span 1; display:flex; flex-direction:column; isolation:isolate; }
  .kt.can .art { flex:1; min-height:0; display:grid; place-items:center; padding:14px 14px 0; }
  .kt.can .art img { height:100%; width:auto; object-fit:contain; transition:transform .4s var(--pop); }
  .kt.can:hover .art img { transform:rotate(-6deg) scale(1.08); }
  .kt.can .meta { padding:0 70px 16px 16px; } .kt.can h3 { font-size:22px; line-height:1; } .kt.can p { margin:4px 0 0; font-size:13.5px; color:var(--muted); }
  .kt.can .add { position:absolute; right:14px; bottom:14px; }
  .mult { mix-blend-mode:multiply; }

  .add { width:44px; height:44px; flex:0 0 44px; border-radius:50%; border:2px solid var(--ink); background:var(--g); color:#fff; font-size:16px; cursor:pointer; box-shadow:2px 2px 0 var(--ink); transition:transform .2s var(--pop), background .2s; }
  .add:hover { transform:rotate(90deg) scale(1.08); } .add.ok { background:var(--ink); animation:ok .5s var(--pop); }
  @keyframes ok { 40% { transform:scale(1.3); } }

  /* FAVS */
  .favs { padding:110px 0 60px; }
  .fgrid { display:grid; grid-template-columns:repeat(4, 1fr); gap:22px; }
  .fav { background:var(--bg); border:2px solid var(--ink); border-radius:28px; padding:18px; box-shadow:6px 6px 0 var(--ink); display:flex; flex-direction:column; transition:transform .3s var(--pop), box-shadow .3s; }
  .fav:hover { transform:translateY(-6px) rotate(-1deg); box-shadow:10px 10px 0 var(--ink); }
  .fav .art { aspect-ratio:4/3; display:grid; place-items:center; } .fav .art img { max-height:100%; width:auto; transition:transform .4s var(--pop); }
  .fav:hover .art img { transform:rotate(-4deg) scale(1.06); }
  .fav .art.real { isolation:isolate; } .fav .art.real img { width:100%; height:100%; object-fit:contain; }
  .fav h3 { font-size:24px; line-height:1; margin-top:8px; } .fav p { font-size:14px; color:var(--muted); margin:6px 0 14px; flex:1; }
  .row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .price { font-weight:700; font-size:17px; } .price small { font-size:12px; color:var(--muted); font-weight:600; }

  /* MENU */
  .menu { padding:70px 0 110px; }
  .mbar { position:sticky; top:72px; z-index:10; background:var(--cream); padding:12px 0; margin-bottom:10px; display:flex; flex-direction:column; gap:12px; }
  .tabs { display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding:4px 4px 6px; } .tabs::-webkit-scrollbar { display:none; }
  .tab { flex:0 0 auto; font:600 14.5px "Rubik",sans-serif; padding:10px 16px; border-radius:999px; border:2px solid var(--ink); background:#fff; cursor:pointer; transition:transform .15s, background .15s; }
  .tab:hover { transform:translateY(-2px); } .tab.on { background:var(--ink); color:#fff; box-shadow:3px 3px 0 var(--pink); }
  .search { position:relative; max-width:520px; } .search i { position:absolute; left:16px; top:50%; transform:translateY(-50%); }
  .search input { width:100%; font:500 16px "Rubik",sans-serif; padding:14px 16px 14px 44px; border-radius:999px; border:2px solid var(--ink); background:#fff; outline:none; box-shadow:3px 3px 0 var(--ink); }
  .search input:focus { box-shadow:3px 3px 0 var(--g); }
  .cat { display:none; grid-template-columns:300px 1fr; gap:22px; align-items:start; } .cat.on { display:grid; animation:fadeUp .35s var(--ease); }
  .board.searching .cat { display:grid; } .board.searching .cat:not(:has(.item:not(.hide))) { display:none; }
  @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } }
  .cathead { position:sticky; top:250px; background:var(--bg); border:2px solid var(--ink); border-radius:28px; padding:20px; box-shadow:6px 6px 0 var(--ink); }
  .cathead img { width:100%; aspect-ratio:1.1; object-fit:contain; transition:transform .4s var(--pop); } .cathead:hover img { transform:rotate(-4deg) scale(1.04); }
  .cathead h3 { font-size:34px; line-height:1; margin-top:10px; } .cathead p { margin:6px 0 0; font-weight:600; color:var(--muted); font-size:14px; }
  .rows { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .item { display:flex; align-items:center; gap:14px; background:#fff; border:2px solid var(--ink); border-radius:20px; padding:12px 12px 12px 16px; transition:transform .2s var(--pop), box-shadow .2s; box-shadow:3px 3px 0 var(--ink); animation:fadeUp .35s var(--ease) both; }
  .item:hover { transform:translate(-2px,-2px); box-shadow:6px 6px 0 var(--ink); }
  .item.hide { display:none; }
  .thumb { flex:0 0 76px; height:76px; border-radius:14px; border:2px solid var(--ink); background:var(--bg); overflow:hidden; isolation:isolate; }
  .thumb img { width:100%; height:100%; object-fit:contain; padding:4px; transform:scale(1.15); } .thumb.cover img { object-fit:cover; padding:0; transform:none; }
  .thumb.chr img { object-fit:contain; object-position:center bottom; padding:4px 2px 0; transform:none; }
  .item .txt { flex:1; min-width:0; } .item h4 { font-size:19px; line-height:1.05; } .item .txt p { margin:4px 0 0; font-size:13.5px; color:var(--muted); line-height:1.35; }
  .item .pop { display:inline-flex; gap:4px; align-items:center; vertical-align:3px; margin-left:8px; background:var(--butter); border:1.5px solid var(--ink); border-radius:999px; font:700 11px "Rubik",sans-serif; padding:2px 7px; white-space:nowrap; }
  .item .price { text-align:right; white-space:nowrap; font-size:15.5px; } .item .price small { display:block; font-size:11px; }
  .empty { display:flex; align-items:center; gap:16px; font-weight:600; font-size:18px; }

  /* TABLE */
  .tablesec { padding:110px 0; overflow:hidden; }
  .tgrid { display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:center; }
  .tablesec h2 { color:var(--ink); }
  .steps { list-style:none; padding:0; margin:32px 0 26px; display:flex; flex-direction:column; gap:14px; }
  .steps li { display:flex; gap:16px; align-items:flex-start; background:var(--cream); border:2px solid var(--ink); border-radius:22px; padding:16px 18px; box-shadow:4px 4px 0 var(--ink); }
  .steps b { flex:0 0 48px; height:48px; border-radius:50%; background:var(--g); color:#fff; border:2px solid var(--ink); display:grid; place-items:center; font:400 24px var(--disp); }
  .steps h3 { font-size:22px; line-height:1.05; } .steps p { margin:4px 0 0; font-size:15px; color:#3b3832; }
  .perks { list-style:none; padding:0; margin:0 0 28px; display:flex; flex-wrap:wrap; gap:10px; }
  .perks li { display:inline-flex; gap:8px; align-items:center; background:#fff; border:2px solid var(--ink); border-radius:999px; padding:8px 14px; font-weight:600; font-size:14.5px; }
  .perks i { color:var(--g2); }
  .phone-wrap { position:relative; justify-self:center; }
  .phone { width:min(360px, 84vw); aspect-ratio:9/18.5; border:3px solid var(--ink); border-radius:44px; background:var(--ink); padding:10px; box-shadow:12px 12px 0 var(--ink); position:relative; z-index:2; rotate:2deg; }
  .phone iframe { width:100%; height:100%; border:0; border-radius:34px; background:#fff; }
  .pc { position:absolute; width:190px; left:-150px; bottom:-10px; z-index:3; animation:sway 5s ease-in-out infinite; transform-origin:50% 100%; }

  /* KULTURE */
  .kulture { padding:120px 0 90px; }
  .kgrid2 { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; margin-bottom:60px; }
  .kart { position:relative; aspect-ratio:1.15; }
  .kart img { position:absolute; }
  .k1 { width:42%; left:4%; top:4%; animation:sway 5s ease-in-out infinite; } .k2 { width:44%; right:2%; top:0; animation:sway 4.2s ease-in-out infinite -1s; } .k3 { width:40%; left:32%; bottom:0; animation:sway 6s ease-in-out infinite -2s; }
  .kcopy p { font-size:19px; color:#3b3832; max-width:540px; } .kcopy h2 { margin-bottom:18px; }
  .sig { font:400 26px var(--disp) !important; color:var(--g) !important; }
  .gal { display:grid; grid-template-columns:1.4fr 1fr 1fr; grid-template-rows:240px 240px; gap:18px; }
  .gal figure { margin:0; border:2px solid var(--ink); border-radius:24px; overflow:hidden; box-shadow:5px 5px 0 var(--ink); background:#fff; isolation:isolate; }
  .gal figure img { width:100%; height:100%; object-fit:cover; transition:transform .6s var(--ease); } .gal figure:hover img { transform:scale(1.06); }
  .gal .white img { object-fit:contain; padding:10px; }
  .g1 { grid-row:span 2; } .g4 { background:#FFF0C2 !important; } .g5 { background:#FFE1EF !important; }

  /* BRANCHES */
  .branches { padding:110px 0; overflow:hidden; }
  .bgrid { display:grid; grid-template-columns:1fr 1.6fr; gap:22px; position:relative; align-items:start; }
  .bgroup { background:var(--cream); border:2px solid var(--ink); border-radius:28px; padding:22px; box-shadow:6px 6px 0 var(--ink); display:grid; gap:10px; }
  .bgroup h3 { font-size:28px; margin-bottom:6px; grid-column:1/-1; }
  .bgroup:last-of-type { grid-template-columns:1fr 1fr; }
  .br { display:flex; align-items:center; justify-content:space-between; gap:10px; text-decoration:none; color:var(--ink); background:#fff; border:2px solid var(--ink); border-radius:16px; padding:12px 16px; transition:transform .15s var(--ease), box-shadow .15s; }
  .br:hover { transform:translate(-2px,-2px); box-shadow:4px 4px 0 var(--ink); }
  .br b { display:block; font-size:17px; } .br small { color:var(--muted); font-size:13.5px; } .br i { color:var(--g2); }
  .bc { position:absolute; width:200px; right:-10px; bottom:-120px; opacity:.95; }

  /* FOOTER */
  .foot { padding:80px 0 40px; overflow:hidden; }
  .fw { display:flex; flex-wrap:wrap; gap:6px 22px; font:400 clamp(30px, 4.6vw, 64px)/1.05 var(--disp); margin-bottom:46px; max-width:1000px; }
  .fw span:nth-child(odd) { color:var(--butter); } .fw span:nth-child(3n) { color:var(--ink); }
  .fbot { display:flex; justify-content:space-between; gap:30px; flex-wrap:wrap; align-items:center; border-top:2px solid rgba(255,255,255,.35); padding-top:26px; }
  .fbrand { display:flex; gap:14px; align-items:center; } .fbrand img { width:54px; height:54px; object-fit:cover; border-radius:14px; border:2px solid var(--ink); } .fbrand p { margin:0; font-size:14.5px; }
  .foot nav { display:flex; gap:20px; flex-wrap:wrap; } .foot nav a { color:#fff; font-weight:600; text-decoration:none; } .foot nav a:hover { text-decoration:underline; }
  .credit { font-size:12.5px; opacity:.8; margin:26px 0 0; } .credit a { color:#fff; }
  .fc { position:absolute; width:300px; right:2%; top:30px; opacity:.98; }

  /* toast, bubble, mobile bar, panel */
  .toast { visibility:hidden; position:fixed; left:50%; bottom:28px; transform:translate(-50%, 140%); z-index:60; background:var(--ink); color:#fff; border-radius:999px; padding:10px 10px 10px 18px; display:flex; align-items:center; gap:12px; font-weight:600; font-size:15px; box-shadow:4px 4px 0 var(--pink); transition:transform .35s var(--pop); max-width:calc(100vw - 32px); }
  .toast.show { visibility:visible; transform:translate(-50%, 0); }
  .toast button { font:700 14px "Rubik",sans-serif; background:var(--g); color:#fff; border:2px solid #fff; border-radius:999px; padding:8px 14px; cursor:pointer; white-space:nowrap; }
  .bubble { position:fixed; right:24px; bottom:24px; z-index:51; width:66px; height:66px; border-radius:50%; border:2px solid var(--ink); background:var(--g); color:#fff; font-size:26px; cursor:pointer; box-shadow:4px 4px 0 var(--ink); transition:transform .25s var(--pop); }
  .bubble:hover { transform:scale(1.08) rotate(-6deg); }
  .bubble .fa-xmark { display:none; } .bubble.open .fa-xmark { display:inline; } .bubble.open .fa-comment-dots { display:none; }
  .bubble .count { position:absolute; top:-6px; right:-6px; }
  .chat { position:fixed; right:24px; bottom:104px; z-index:50; width:400px; height:min(680px, calc(100dvh - 140px)); border:2px solid var(--ink); border-radius:28px; overflow:hidden; background:#fff; box-shadow:8px 8px 0 var(--ink); transform:translateY(20px) scale(.96); opacity:0; pointer-events:none; transform-origin:bottom right; transition:transform .3s var(--pop), opacity .2s; }
  .chat.open { transform:none; opacity:1; pointer-events:auto; } .chat iframe { width:100%; height:100%; border:0; display:block; }
  .mbar-fixed { display:none; }

  /* reveal: visible at rest; only below-the-fold elements get .pre, then animate in once */
  .reveal.pre { opacity:0; transform:translateY(26px) scale(.98); }
  .reveal { transition:opacity .5s var(--ease), transform .5s var(--ease), rotate .3s var(--pop), box-shadow .3s; }

  @media (max-width: 1020px) {
    .hero { grid-template-columns:1fr; padding-top:24px; } .stage { max-width:520px; }
    .kgrid { grid-template-columns:repeat(2, 1fr); grid-auto-rows:260px; } .kt.photo:first-child { grid-row:span 1; grid-column:span 2; }
    .fgrid { grid-template-columns:repeat(2, 1fr); }
    .tgrid, .kgrid2 { grid-template-columns:1fr; } .pc { display:none; }
    .cat, .cat.on, .board.searching .cat { grid-template-columns:1fr; } .cathead { position:static; display:grid; grid-template-columns:110px 1fr; align-items:center; gap:4px 16px; padding:14px; } .cathead img { grid-row:span 2; } .cathead h3 { margin:0; font-size:28px; } .rows { grid-template-columns:1fr; }
    .bgrid { grid-template-columns:1fr; } .bc { display:none; } .fc { width:180px; top:auto; bottom:90px; opacity:.5; }
  }
  @media (max-width: 720px) {
    .kk { font-size:16px; }
    .wrap { padding:0 16px; } .hero { padding:18px 16px 40px; } .top { padding:10px 16px; gap:10px; } .top.scrolled { padding:8px 16px; }
    .top nav { display:none; } .top .order { margin-left:auto; padding:10px 14px; }
    .ann { font-size:12.5px; gap:8px; } .ann .sep, .ann span:nth-of-type(3) { display:none; }
    .lede { font-size:17px; } .btn.big { font-size:16px; padding:14px 18px; }
    .hero h1 .pk, .hero h1 .gr, .pkt { -webkit-text-stroke:1.5px var(--ink); }
    .kans, .favs, .menu, .tablesec, .kulture, .branches { padding:70px 0; }
    .kgrid { grid-auto-rows:220px; gap:14px; } .kt.wide, .kt.photo:first-child { grid-column:span 2; }
    .fgrid { gap:14px; } .fav { padding:12px; border-radius:22px; } .fav h3 { font-size:19px; } .fav p { display:none; }
    .mbar { top:62px; } .item { gap:10px; padding:10px 10px 10px 12px; border-radius:16px; } .item h4 { font-size:16.5px; } .item .txt p { font-size:12.5px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .thumb { flex-basis:60px; height:60px; } .price { font-size:15px; } .add { width:40px; height:40px; flex-basis:40px; }
    .hero h1 .ln { white-space:normal; } .bgroup:last-of-type { grid-template-columns:1fr; }
    .gal { grid-template-columns:1fr 1fr; grid-template-rows:200px 160px 160px; } .g1 { grid-column:span 2; grid-row:span 1; }
    .bubble { display:none; }
    .mbar-fixed { display:block; position:fixed; left:0; right:0; bottom:0; z-index:52; padding:10px 16px calc(10px + env(safe-area-inset-bottom)); background:linear-gradient(transparent, var(--cream) 40%); }
    .mbar-fixed .btn { width:100%; justify-content:center; }
    .chat { left:0; right:0; bottom:0; width:100%; height:calc(100dvh - 56px); border-radius:24px 24px 0 0; border-bottom:0; }
    .chat.open ~ .mbar-fixed, .kk:has(.chat.open) .mbar-fixed { display:none; }
    .toast { bottom:92px; }
    .foot { padding-bottom:110px; } .fc { display:none; }
  }
  @media (prefers-reduced-motion: reduce) { .kk *, .kk *::before { animation:none !important; transition:none !important; } }
</style>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const panel = $('kk-panel'), frame = $('kk-frame') as HTMLIFrameElement, bubble = $('kk-bubble'), toast = $('toast');
    let ready = false; const queue: any[] = []; let cartCount = 0;
    const post = (m: any) => { if (ready) frame.contentWindow?.postMessage(m, '*'); else queue.push(m); };
    function loadChat() { if (!frame.src) frame.src = frame.dataset.src!; }
    function openChat(keepSheet = false) {
      loadChat(); panel.classList.add('open'); panel.setAttribute('aria-hidden', 'false'); bubble.classList.add('open');
      if (cartCount && !keepSheet) post({ type: 'kk:cart-open' });
    }
    function closeChat() { panel.classList.remove('open'); panel.setAttribute('aria-hidden', 'true'); bubble.classList.remove('open'); }
    addEventListener('message', (e) => {
      if (e.source !== frame.contentWindow) return;
      if (e.data?.type === 'kk:open') { openChat(true); toast.classList.remove('show'); }
      if (e.data?.type === 'kk:ready') { ready = true; while (queue.length) frame.contentWindow?.postMessage(queue.shift(), '*'); }
      if (e.data?.type === 'kk:cart') {
        const n = Number(e.data.count) || 0, grew = n > cartCount; cartCount = n;
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => { c.textContent = String(n); c.hidden = !n; if (grew) { c.classList.remove('bump'); void c.offsetWidth; c.classList.add('bump'); } });
        $('mlabel').textContent = n ? `Review order · ${e.data.total} ${e.data.currency}` : 'Order from your table';
      }
    });
    document.querySelectorAll<HTMLElement>('[data-open-chat]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); panel.classList.contains('open') && b === bubble ? closeChat() : openChat(); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeChat(); });

    // "+" anywhere on the page → straight into the table chat's cart
    let tt: number | undefined;
    document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => b.addEventListener('click', () => {
      loadChat(); post({ type: 'kk:add', name: b.dataset.add });
      b.classList.remove('ok'); void b.offsetWidth; b.classList.add('ok'); b.innerHTML = '<i class="fa-solid fa-check"></i>';
      setTimeout(() => { b.classList.remove('ok'); b.innerHTML = '<i class="fa-solid fa-plus"></i>'; }, 1300);
      toast.innerHTML = `<span>Added <b></b></span><button type="button">Review order</button>`;
      toast.querySelector('b')!.textContent = b.dataset.add!;
      toast.querySelector('button')!.addEventListener('click', () => openChat());
      toast.classList.add('show'); clearTimeout(tt); tt = window.setTimeout(() => toast.classList.remove('show'), 3200);
    }));

    // live phone loads when it scrolls near
    const demo = $('demoFrame') as HTMLIFrameElement;
    new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { demo.src = demo.dataset.src!; o.disconnect(); } }), { rootMargin: '300px' }).observe(demo);

    // menu tabs + search
    const tabs = document.querySelectorAll<HTMLElement>('.tab'), cats = document.querySelectorAll<HTMLElement>('.cat');
    const q = $('q') as HTMLInputElement, empty = $('empty'), board = document.querySelector('.board')!;
    tabs.forEach((t) => t.addEventListener('click', () => {
      q.value = ''; filter(); tabs.forEach((x) => x.classList.toggle('on', x === t)); cats.forEach((c) => c.classList.toggle('on', c.dataset.cat === t.dataset.tab));
      t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      const top = (document.querySelector('.mbar') as HTMLElement).getBoundingClientRect().top; if (top < 70) $('menu').querySelector('.mbar')!.scrollIntoView({ behavior: 'smooth' });
    }));
    function filter() {
      const s = q.value.trim().toLowerCase(); board.classList.toggle('searching', !!s); let hits = 0;
      document.querySelectorAll<HTMLElement>('.item').forEach((it) => { const ok = !s || it.dataset.name!.includes(s); it.classList.toggle('hide', !ok); if (ok && s) hits++; });
      empty.hidden = !s || hits > 0;
    }
    q.addEventListener('input', filter);

    // hero parallax
    if (matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const els = $('stage').querySelectorAll<HTMLElement | SVGElement>('[data-depth]');
      addEventListener('pointermove', (e) => { const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        els.forEach((c) => { const d = Number(c.getAttribute('data-depth')); (c as HTMLElement).style.translate = `${x * d}px ${y * d}px`; }); }, { passive: true });
    }
    // reveal once, only for what starts below the fold
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.remove('pre'); io.unobserve(e.target); } }), { threshold: 0.08 });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) { el.classList.add('pre'); io.observe(el); } });
    addEventListener('scroll', () => $('topbar').classList.toggle('scrolled', scrollY > 40), { passive: true });
    // open now (Cairo, 7:30 → midnight)
    const h = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Cairo' })); const open = h.getHours() * 60 + h.getMinutes() >= 450;
    const st = $('open-state'); st.textContent = open ? 'Open now · until midnight' : 'Closed now · opens 7:30 AM'; st.parentElement!.classList.toggle('closed', !open);
  </script>
</Base>
