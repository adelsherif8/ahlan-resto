---
// Koffee Kulture — the dine-in chat widget, live on this page (showroom table).
// The frame is the real flows widget: a signed "DEMO" table token on a branch with no
// coordinates, so the geofence never blocks visitors; real tables use the printed QR codes.
import Base from '../../layouts/Base.astro';
import HeaderPill from '../../components/HeaderPill.astro';
import Footer from '../../components/FooterGiant.astro';
import { en as t } from '../../content/en';

const FLOWS = 'https://flows.munadim.com';
const DEMO_TOKEN = 'v1.eyJ2IjoxLCJiIjoiZGVtbyIsInQiOiJERU1PIiwiciI6ImQwY2QyYzg2LTE3ZTItNDhlNS05NzQwLWE4YzkxYzFlYTZkOSJ9.bky0UjKfKYJZb7le55u1URtdvXpF2kVbJvEj5rQjYsg';
const widgetUrl = `${FLOWS}/t/${DEMO_TOKEN}?r=koffee-kulture`;
---

<Base
  lang="en"
  title="Koffee Kulture · order from your table — Munadim"
  description="Scan the QR on your table, chat, and your order reaches the counter with your table number. No app, no waiter, no typing a code. Live demo of Munadim's dine-in widget for Koffee Kulture."
  path="koffee-kulture"
>
  <HeaderPill t={t} lang="en" />

  <main class="kk">
    <section class="hero">
      <p class="eyebrow">Dine-in · Koffee Kulture</p>
      <h1>Scan the table. Say what you want. It's at the counter.</h1>
      <p class="lede">
        A chat on your phone that knows your table. No app to install, no waiter to flag down,
        no code to type. The order lands on the counter screen as <em>Table A7</em> — sizes,
        oat milk, extra shot and all.
      </p>
      <ol class="steps">
        <li><span>1</span><b>Scan</b> the QR on the table — it opens the chat already knowing where you sit.</li>
        <li><span>2</span><b>Order</b> in your own words: “iced spanish latte large, oat milk, and a pistachio kroissant”.</li>
        <li><span>3</span><b>Done</b> — the ticket reaches the counter with your table number. Pay there as usual.</li>
      </ol>
    </section>

    <section class="demo">
      <div class="phone">
        <div class="notch"></div>
        <iframe src={widgetUrl} title="Koffee Kulture — order from your table (live demo)" loading="lazy" allow="geolocation"></iframe>
      </div>
      <div class="demo-copy">
        <h2>Try it — this is the real thing</h2>
        <p>
          This frame is the live widget on a showroom table. Ask for the menu, order a matcha,
          change your mind, split a bagel across two people. The bot answers in English, Arabic
          or Franco — whichever you type.
        </p>
        <p class="note">
          Prices and the 12% service charge are the café's. On a real table the phone's
          location must be inside the café for the order to go through; the showroom table skips that check.
        </p>
      </div>
    </section>

    <section class="trust">
      <h2>How we know it's really your table — with nobody on staff lifting a finger</h2>
      <div class="cards">
        <article>
          <h3>The QR is signed</h3>
          <p>Each table's code carries a signed token naming the branch and table. It can't be edited to point at another table, and you had to be at the table to scan it.</p>
        </article>
        <article>
          <h3>Your phone is inside the café</h3>
          <p>When you confirm, the browser shares your location once. Orders only go through from inside the café's fence — a photo of the QR sent to a friend across town places nothing.</p>
        </article>
        <article>
          <h3>Your table, for your visit</h3>
          <p>A scan opens a session on your phone for the visit. Scan another table and the old one ends. No codes to read out, no staff confirmation, no app.</p>
        </article>
      </div>
    </section>

    <section class="cta">
      <h2>Running a café?</h2>
      <p>Same brain as the WhatsApp bot, on the table. Menu, sizes, add-ons and the counter screen set up in a day.</p>
      <a class="btn" href="https://wa.me/201515066123">Talk to us on WhatsApp</a>
    </section>
  </main>

  <Footer t={t} lang="en" />
</Base>

<style>
  .kk { max-width: 1120px; margin: 0 auto; padding: 32px 20px 80px; }
  .eyebrow { letter-spacing: .14em; text-transform: uppercase; font-size: 12px; opacity: .7; margin: 0 0 10px; }
  .hero h1 { font-size: clamp(30px, 5vw, 52px); line-height: 1.05; margin: 0 0 16px; max-width: 18ch; }
  .lede { font-size: 18px; line-height: 1.5; max-width: 60ch; opacity: .9; }
  .lede em { font-style: normal; font-weight: 700; }
  .steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .steps li { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border: 1px solid rgba(0,0,0,.1); border-radius: 14px; line-height: 1.4; }
  .steps span { flex: 0 0 28px; height: 28px; border-radius: 50%; background: #3DAE2B; color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
  .demo { margin-top: 56px; display: grid; gap: 32px; grid-template-columns: 360px 1fr; align-items: center; }
  .phone { position: relative; width: 360px; height: 720px; border-radius: 44px; background: #111; padding: 12px; box-shadow: 0 30px 60px rgba(0,0,0,.25); }
  .phone .notch { position: absolute; top: 22px; left: 50%; transform: translateX(-50%); width: 110px; height: 26px; background: #111; border-radius: 16px; z-index: 2; }
  .phone iframe { width: 100%; height: 100%; border: 0; border-radius: 34px; background: #fff; }
  .demo-copy h2 { font-size: 28px; margin: 0 0 10px; }
  .demo-copy p { line-height: 1.55; font-size: 17px; }
  .note { font-size: 14px; opacity: .7; }
  .trust { margin-top: 72px; }
  .trust h2 { font-size: clamp(22px, 3vw, 32px); max-width: 28ch; margin: 0 0 20px; }
  .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .cards article { padding: 20px; border-radius: 16px; background: rgba(61,174,43,.08); border: 1px solid rgba(61,174,43,.25); }
  .cards h3 { margin: 0 0 8px; font-size: 18px; }
  .cards p { margin: 0; line-height: 1.5; }
  .cta { margin-top: 72px; text-align: center; }
  .cta h2 { font-size: 30px; margin: 0 0 8px; }
  .btn { display: inline-block; margin-top: 14px; padding: 14px 24px; border-radius: 999px; background: #3DAE2B; color: #fff; font-weight: 700; text-decoration: none; }
  @media (max-width: 820px) { .demo { grid-template-columns: 1fr; justify-items: center; } .phone { width: min(360px, 92vw); height: min(720px, 150vw); } }
</style>
