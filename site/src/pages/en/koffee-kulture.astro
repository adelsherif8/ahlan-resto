---
// Koffee Kulture — the café's own site, built from its real photos (Talabat menu shots, CairoScene
// branch photos) and the moon-faced characters from its printed menu. Our addition: the chat bubble
// bottom-right and the "your table runs itself" section, both the real dine-in system (flows) on the
// showroom table DEMO at Arkan (exempt from the geofence).
import Base from '../../layouts/Base.astro';

const FLOWS = 'https://flows.munadim.com';
const DEMO_TOKEN = 'v1.eyJ2IjoxLCJiIjoiYXJrYW4iLCJ0IjoiREVNTyIsInIiOiJkMGNkMmM4Ni0xN2UyLTQ4ZTUtOTc0MC1hOGM5MWMxZWE2ZDkifQ.76OJRQTeb-Q9lGOrgh_9of6TdWfAe833W4GHkgjEQ7Y';
const widgetUrl = `${FLOWS}/t/${DEMO_TOKEN}?r=koffee-kulture`;
const I = '/koffee';

// [name, price, description, photo?]
type Item = [string, number | string, string, string?];
const menu: { key: string; name: string; icon: string; char: string; tint: string; items: Item[] }[] = [
  { key: 'hot', name: 'Hot Koffee', icon: 'fa-mug-hot', char: 'char-chair', tint: '#FDE7D7', items: [
    ['Spanish Latte', 135, 'Espresso, milk, condensed milk'], ['Kappuccino', 125, 'Espresso, steamed milk foam'],
    ['Flat White', 110, 'Double espresso, steamed milk'], ['Salted Karamel Latte', 135, 'Double espresso, salted caramel'],
    ['Pistachio Latte', 175, 'Steamed milk, Italian pistachio'], ['Honey Cinnamon Latte', 145, 'Honey cinnamon sauce'] ] },
  { key: 'cold', name: 'Kold Koffee', icon: 'fa-glass-water', char: 'char-sip', tint: '#E3F1FF', items: [
    ['Iced Spanish Latte', '125 / 145', 'Milk, espresso, condensed milk'], ['Iced Salted Karamel', '125 / 145', 'Creamy, salted caramel'],
    ['Iced Pistachio Latte', '165 / 185', 'Iced latte, pistachio'], ['Iced Banana Bread Latte', '155 / 175', 'Banana, cinnamon, milk'],
    ['Blended Spanish Latte', '125 / 145', 'Strong coffee, condensed milk, ice'], ['Karamel Koffee Frappe', '125 / 145', 'Coffee, caramel, milk, ice'] ] },
  { key: 'matcha', name: 'Matcha Kulture', icon: 'fa-leaf', char: 'char-walk', tint: '#E4F5DF', items: [
    ['Blended Dirty Matcha', '165 / 185', 'Espresso blend over matcha', 'dirty-matcha.jpg'], ['Blended Matcha', '155 / 175', 'Matcha blended with milk'],
    ['Hot Salted Karamel Matcha', 165, 'Hot matcha, salted caramel'], ['Iced Matcha Latte', '140 / 160', 'Whisked to order'],
    ['Blended Strawberry Matcha', '165 / 185', 'Matcha, strawberry sauce'], ['Blended Pistachio Matcha', '180 / 195', 'Matcha, pistachio sauce'] ] },
  { key: 'refresh', name: 'Refreshers', icon: 'fa-lemon', char: 'char-dance', tint: '#FFE3EF', items: [
    ['Pink Redbull', 190, 'Red Bull, strawberry, vanilla-cherry', 'pink-redbull.jpg'], ['Coco Berry Redbull', 190, 'Red Bull, coconut, berries'],
    ['Raspberry Mojito', 140, 'Raspberry, mint, lemon'], ['Ocean Breeze', 150, 'Lemon soda, coconut, blue curaçao'],
    ['Love Story Smoothie', 170, 'Pineapple, passion fruit, peach'], ['Passion Lemonade', 140, 'Passion fruit, lemon'] ] },
  { key: 'bakery', name: 'Bakery & Breakfast', icon: 'fa-bread-slice', char: 'char-travel', tint: '#FFF1D6', items: [
    ['Pistachio Konafa Kroissant', 180, 'Kunafa, pistachio, chocolate'], ['All Butter Kroissant', 80, 'Viennoise, butter-rich'],
    ['The LA Benedict', 320, 'Smoked salmon, avocado, dill hollandaise'], ['Mushroom Invasion Omelette', 290, 'Thyme mushrooms, fried brie'],
    ['Pistachio Pancakes', 370, 'Pistachio sauce, fresh cream'], ['Savory Breakfast Bagel', 275, 'Scrambled egg, halloumi, spinach'] ] },
  { key: 'bagels', name: 'Bagels & Sandwiches', icon: 'fa-burger', char: 'char-guitar', tint: '#EFE6FF', items: [
    ['Philly Steak Bagel', 395, 'Steak fillet, mushrooms, cheddar', 'philly-bagel.jpg'], ['Kulture Bagel', 390, 'Salmon, avocado, honey mustard', 'kulture-bagel.jpg'],
    ['Lunch Bagel', 285, 'Grilled chicken, Caesar, parmesan'], ['Sub Out', 290, 'Avocado, chicken, sweet chili mayo'],
    ['Spicy Tunacado', 310, 'Tuna, pesto, jalapeño, guacamole'], ['Cream Cheese Bagel', 170, 'Baked daily'] ] },
  { key: 'sweet', name: 'Sweet Tooth', icon: 'fa-cake-candles', char: 'char-kroissant', tint: '#FFE9DE', items: [
    ['Almond Salted Caramel Cake', 245, 'Salted caramel, caramelised almonds', 'almond-cake.jpg'], ['Brookies', 110, 'Brownie meets cookie', 'brookies.jpg'],
    ['Kinder Cookie', 115, 'Kinder spread filling', 'kinder-cookie.jpg'], ['Chocolate Chip Cookie', 100, 'Milk chocolate, a note of coffee', 'choc-cookie.jpg'],
    ['San Sebastian Cheesecake', 195, 'Basque-style'], ['Tiramisu Jar', 190, 'Made with our koffee'] ] },
];
const CHARS = ['char-chair', 'char-sip', 'char-walk', 'char-dance', 'char-travel', 'char-guitar', 'char-kroissant', 'char-hug'];
const marquee = ['Spanish Latte', 'Dirty Matcha', 'Pistachio Konafa Kroissant', 'Pink Redbull', 'Philly Steak Bagel', 'Brookies', 'Salted Karamel', 'Love Story Smoothie'];
const does = [
  ['fa-comments', 'Takes the order', 'Sizes, oat milk, extra shot, "same as last time" — English, Arabic or Franco.'],
  ['fa-wand-magic-sparkles', 'Suggests the add-on', 'A kroissant with the latte, at the moment it fits.'],
  ['fa-chair', 'Knows the table', 'Every ticket carries its table. Nobody at another table can order to yours.'],
  ['fa-arrows-split-up-and-left', 'Routes it', 'Drinks to the bar screen, food to the kitchen, the same second.'],
  ['fa-list-check', 'Tracks it', 'Received, making, ready, served — live on the guest\'s phone.'],
  ['fa-bell-concierge', 'Calls staff', '"The bill", "water", "help" — one tap, a chime at the counter.'],
  ['fa-user-check', 'Remembers regulars', '"Welcome back, Sara — your usual?"'],
  ['fa-star', 'Collects reviews', 'Happy guests go to Google; unhappy ones reach the manager privately.'],
  ['fa-chart-line', 'Reports to you', 'Orders, average check, add-on rate, kitchen time — per branch.'],
];
const branches = [
  ['Arkan Plaza', 'Sheikh Zayed'], ['Golf Central', 'Palm Hills'], ['U Venues', 'New Cairo'], ['District 5', 'New Cairo'],
  ['O1 Kitchen Mall', 'New Cairo'], ['Lake District', 'Mivida'], ['Ivory', 'Villette by Sodic'],
];
---

<Base
  lang="en"
  title="Koffee Kulture — Specialty Koffee & Breakfast Kulture"
  description="Different People, Different Kultures, Different KOFFEE KUPS. Specialty coffee, matcha, kroissants and bagels in Sheikh Zayed and New Cairo. Order from your table."
  path="koffee-kulture"
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="kk">
    <header class="top" id="topbar">
      <a class="brand" href="#top"><img src={`${I}/logo.jpg`} alt="Koffee Kulture" width="44" height="44" /><span>Koffee Kulture</span></a>
      <nav>
        <a href="#kans">Kans</a><a href="#menu">Menu</a><a href="#table">Order at the table</a><a href="#branches">Branches</a>
        <button class="btn sm" data-open-chat><i class="fa-solid fa-mug-saucer"></i><span>Order</span></button>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="tag reveal"><i class="fa-solid fa-seedling"></i> Specialty Koffee &amp; Breakfast Kulture</p>
        <h1 class="reveal">
          <span class="w">Different</span> <span class="w">People.</span><br />
          <span class="w">Different</span> <span class="w">Kultures.</span><br />
          <span class="w pink">Different</span> <span class="w green">Koffee Kups.</span>
        </h1>
        <p class="lede reveal">Espresso pulled to order, matcha whisked by hand, kroissants baked all day and coffee you take home in a kan. Seven homes across Sheikh Zayed and New Cairo.</p>
        <div class="cta reveal">
          <button class="btn lg" data-open-chat><i class="fa-solid fa-comment-dots"></i> Order from your table</button>
          <a class="btn lg ghost" href="#menu"><i class="fa-solid fa-book-open"></i> See the menu</a>
        </div>
        <p class="hours reveal"><span class="dot"></span><span id="open-state">Open daily 7:30 AM – 12:00 AM</span></p>
      </div>
      <div class="hero-art" id="heroArt">
        <div class="blob" aria-hidden="true"></div>
        <svg class="asterisk" viewBox="0 0 100 100" aria-hidden="true"><g stroke="#3DAE2B" stroke-width="13" stroke-linecap="round"><path d="M50 8v84M8 50h84M20 20l60 60M80 20L20 80"/></g></svg>
        <img class="hero-photo" src={`${I}/hero-can.jpg`} alt="A Koffee Kulture kan held up at the beach" />
        <img class="char c1" data-depth="18" src={`${I}/char-guitar.png`} alt="" aria-hidden="true" />
        <img class="char c2" data-depth="-14" src={`${I}/char-sip.png`} alt="" aria-hidden="true" />
        <span class="spark s1" aria-hidden="true">✦</span><span class="spark s2" aria-hidden="true">✦</span><span class="spark s3" aria-hidden="true">✦</span>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[...marquee, ...marquee].map((m) => (<span>{m}<i class="fa-solid fa-star-of-life"></i></span>))}
      </div>
    </div>

    <!-- KANS -->
    <section class="kans" id="kans">
      <div class="head reveal">
        <p class="tag pinkbg"><i class="fa-solid fa-bottle-water"></i> The Kan Kulture</p>
        <h2>Our koffee comes in a kan.</h2>
        <p class="sub">Iced, sealed and made to travel — the thing everyone photographs.</p>
      </div>
      <div class="kan-grid">
        <figure class="kan tilt reveal" style="--d:0ms"><img src={`${I}/cans.jpg`} alt="Four Koffee Kulture kans: berry, vanilla, matcha and purple" /><figcaption>Refreshers in a kan</figcaption></figure>
        <figure class="kan tilt tall reveal" style="--d:90ms"><img src={`${I}/matcha-cans.jpg`} alt="Matcha kans" /><figcaption>Matcha, sealed fresh</figcaption></figure>
        <figure class="kan tilt reveal" style="--d:180ms"><img src={`${I}/dirty-matcha.jpg`} alt="Blended Dirty Matcha kan" /><figcaption>Blended Dirty Matcha</figcaption></figure>
        <figure class="kan tilt reveal" style="--d:270ms"><img src={`${I}/pink-redbull.jpg`} alt="Pink Redbull kan" /><figcaption>Pink Redbull</figcaption></figure>
      </div>
    </section>

    <!-- MENU -->
    <section class="menu" id="menu">
      <img class="side-char" src={`${I}/char-chair.png`} alt="" aria-hidden="true" />
      <div class="head reveal">
        <p class="tag"><i class="fa-solid fa-book-open"></i> The Menu</p>
        <h2>Pick something. Or let the chat pick for you.</h2>
        <p class="sub">EGP, VAT inclusive · 12% service on dine-in · plant milk +40 · extra shot +35</p>
      </div>
      <div class="tabs reveal" role="tablist">
        {menu.map((c, i) => (<button class={`tab ${i === 0 ? 'on' : ''}`} role="tab" data-tab={c.key}><i class={`fa-solid ${c.icon}`}></i>{c.name}</button>))}
      </div>
      <div class="search reveal"><i class="fa-solid fa-magnifying-glass"></i><input id="q" placeholder="Search — matcha, pistachio, bagel…" autocomplete="off" /></div>
      <div class="board">
        {menu.map((c, i) => (
          <div class={`cat ${i === 0 ? 'on' : ''}`} data-cat={c.key}>
            {c.items.map(([n, p, d, ph], j) => (
              <article class="item" data-name={`${n} ${d}`.toLowerCase()}>
                <div class="pic" style={`--tint:${c.tint}`}>
                  {ph ? <img src={`${I}/${ph}`} alt={n} loading="lazy" /> : <img class="illus" src={`${I}/${CHARS[(i * 3 + j) % CHARS.length]}.png`} alt="" aria-hidden="true" loading="lazy" />}
                </div>
                <div class="info">
                  <b>{n}</b><span>{d}</span>
                  <div class="row"><em>{p} <small>EGP</small></em><button class="add" data-ask={`I'd like a ${n}`} aria-label={`Order ${n}`}><i class="fa-solid fa-plus"></i></button></div>
                </div>
              </article>
            ))}
          </div>
        ))}
        <p class="empty" id="empty" hidden><i class="fa-regular fa-face-frown"></i> Nothing matches — ask the chat, it knows all 170 items.</p>
      </div>
    </section>

    <!-- TABLE / BOT -->
    <section class="tablesec" id="table">
      <div class="table-in">
        <div class="table-copy">
          <p class="tag light reveal"><i class="fa-solid fa-microchip"></i> One AI, the whole visit</p>
          <h2 class="reveal">Your table runs itself.</h2>
          <p class="sub light reveal">Scan the code on the table and chat. The order reaches the bar and kitchen with your table number — and the AI handles everything after it.</p>
          <ul class="does">
            {does.map(([ic, h, t], i) => (<li class="reveal" style={`--d:${i * 45}ms`}><i class={`fa-solid ${ic}`}></i><div><b>{h}</b><span>{t}</span></div></li>))}
          </ul>
        </div>
        <div class="phone-wrap reveal">
          <img class="char c3" src={`${I}/char-walk.png`} alt="" aria-hidden="true" />
          <div class="phone"><iframe id="demoFrame" title="Koffee Kulture table chat — live demo" allow="geolocation" loading="lazy" data-src={widgetUrl}></iframe></div>
          <p class="live"><span class="dot"></span> Live — this is the real system on our showroom table</p>
        </div>
      </div>
    </section>

    <!-- INSIDE -->
    <section class="inside">
      <div class="head reveal">
        <p class="tag"><i class="fa-solid fa-camera-retro"></i> Inside the Kulture</p>
        <h2>Come for the koffee. Stay for the kroissant.</h2>
      </div>
      <div class="gallery">
        <figure class="g g1 reveal"><img src={`${I}/storefront.jpg`} alt="Koffee Kulture storefront with its green logo" loading="lazy" /></figure>
        <figure class="g g2 reveal" style="--d:80ms"><img src={`${I}/pancakes.jpg`} alt="Five pancakes from the new pancake menu" loading="lazy" /></figure>
        <figure class="g g3 reveal" style="--d:160ms"><img src={`${I}/tresleches.jpg`} alt="Salted Karamel Tres Leches in its box" loading="lazy" /></figure>
        <figure class="g g4 reveal" style="--d:240ms"><img src={`${I}/kulture-bagel.jpg`} alt="Kulture Bagel" loading="lazy" /></figure>
        <figure class="g g5 reveal" style="--d:320ms"><img src={`${I}/almond-cake.jpg`} alt="Almond Salted Caramel Cake" loading="lazy" /></figure>
      </div>
    </section>

    <!-- BRANCHES -->
    <section class="branches" id="branches">
      <img class="side-char right" src={`${I}/char-travel.png`} alt="" aria-hidden="true" />
      <div class="head reveal"><p class="tag"><i class="fa-solid fa-location-dot"></i> Find your Kulture</p><h2>Seven homes. Every day, 7:30 to midnight.</h2></div>
      <div class="bgrid">
        {branches.map(([n, a], i) => (<div class="branch reveal" style={`--d:${i * 50}ms`}><i class="fa-solid fa-location-dot"></i><div><b>{n}</b><span>{a}</span></div></div>))}
      </div>
      <p class="contact reveal"><a href="tel:01034999123"><i class="fa-solid fa-phone"></i> 010 3499 9123</a></p>
    </section>

    <footer class="foot">
      <img src={`${I}/char-hug.png`} alt="" aria-hidden="true" />
      <div><b>Koffee Kulture</b><span>Different People. Different Kultures. Different Koffee Kups.</span></div>
      <span class="by">Table ordering by <a href="/en">Munadim</a></span>
    </footer>

    <!-- the chat bubble -->
    <button class="bubble" id="kk-bubble" aria-label="Order from your table" data-open-chat>
      <span class="ring"></span><i class="fa-solid fa-comment-dots ico-open"></i><i class="fa-solid fa-xmark ico-close"></i><span class="hint">Order from your table</span>
    </button>
    <div class="chat" id="kk-panel" aria-hidden="true"><iframe id="kk-frame" title="Koffee Kulture — order from your table" allow="geolocation" data-src={widgetUrl}></iframe></div>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const panel = $('kk-panel'), frame = $('kk-frame') as HTMLIFrameElement, bubble = $('kk-bubble');
    function openChat(prefill?: string) {
      if (!frame.src) frame.src = frame.dataset.src!;
      panel.classList.add('open'); panel.setAttribute('aria-hidden', 'false'); bubble.classList.add('open');
      if (prefill) { const send = () => frame.contentWindow?.postMessage({ type: 'kk:prefill', text: prefill }, '*'); frame.dataset.loaded ? send() : frame.addEventListener('load', () => setTimeout(send, 1200), { once: true }); }
    }
    function closeChat() { panel.classList.remove('open'); panel.setAttribute('aria-hidden', 'true'); bubble.classList.remove('open'); }
    frame.addEventListener('load', () => { frame.dataset.loaded = '1'; });
    document.querySelectorAll<HTMLElement>('[data-open-chat]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); panel.classList.contains('open') && b === bubble ? closeChat() : openChat(); }));
    document.querySelectorAll<HTMLElement>('[data-ask]').forEach((b) => b.addEventListener('click', () => { b.classList.add('pop'); setTimeout(() => b.classList.remove('pop'), 450); openChat(b.dataset.ask); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeChat(); });
    setTimeout(() => bubble.classList.add('quiet'), 7000);

    // in-page live demo phone loads when it scrolls near
    const demo = $('demoFrame') as HTMLIFrameElement;
    new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { demo.src = demo.dataset.src!; o.disconnect(); } }), { rootMargin: '300px' }).observe(demo);

    // menu tabs + search
    const tabs = document.querySelectorAll<HTMLElement>('.tab'), cats = document.querySelectorAll<HTMLElement>('.cat');
    const q = $('q') as HTMLInputElement, empty = $('empty');
    tabs.forEach((t) => t.addEventListener('click', () => { q.value = ''; filter(); tabs.forEach((x) => x.classList.toggle('on', x === t)); cats.forEach((c) => c.classList.toggle('on', c.dataset.cat === t.dataset.tab)); }));
    function filter() {
      const s = q.value.trim().toLowerCase(); document.querySelector('.board')!.classList.toggle('searching', !!s); let hits = 0;
      document.querySelectorAll<HTMLElement>('.item').forEach((it) => { const ok = !s || it.dataset.name!.includes(s); it.classList.toggle('hide', !ok); if (ok && s) hits++; });
      empty.hidden = !s || hits > 0;
    }
    q.addEventListener('input', filter);

    // tilt on the kan cards
    document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
      el.addEventListener('pointermove', (e) => { const r = el.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5; el.style.transform = `perspective(800px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg) translateY(-6px)`; });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });
    // hero characters follow the pointer a little
    const art = $('heroArt');
    if (matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      addEventListener('pointermove', (e) => { const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        art.querySelectorAll<HTMLElement>('[data-depth]').forEach((c) => { const d = Number(c.dataset.depth); c.style.translate = `${x * d}px ${y * d}px`; }); }, { passive: true });
    }
    // reveal
    // content is visible at rest; only what starts below the fold is hidden, then animated in
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.remove('pre'); io.unobserve(e.target); } }), { threshold: 0.08 });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) { el.classList.add('pre'); io.observe(el); } });
    addEventListener('scroll', () => $('topbar').classList.toggle('scrolled', scrollY > 10), { passive: true });
    // open now (Cairo)
    const h = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Cairo' })); const open = h.getHours() * 60 + h.getMinutes() >= 450;
    const st = $('open-state'); st.textContent = open ? 'Open now · until midnight' : 'Closed now · opens 7:30 AM'; st.parentElement!.classList.toggle('closed', !open);
  </script>
</Base>

<style>
  .kk { --g:#3DAE2B; --g2:#24871a; --gs:#E4F5DF; --pink:#E85BAE; --ps:#FFE3EF; --ink:#17191b; --paper:#F4F3EF; --card:#fff; --muted:#666c72; --line:rgba(0,0,0,.08); --ease:cubic-bezier(.2,.8,.2,1);
    --disp:"Fredoka",ui-rounded,system-ui,sans-serif; font-family:"Figtree",system-ui,sans-serif; color:var(--ink); background:var(--paper); overflow-x:clip; }
  .kk h1, .kk h2, .kk h3 { font-family:var(--disp); }
  .top { position:sticky; top:env(safe-area-inset-top,0px); z-index:30; display:flex; align-items:center; justify-content:space-between; padding:10px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px)); background:rgba(244,243,239,.85); backdrop-filter:blur(12px); transition:box-shadow .3s; }
  .top.scrolled { box-shadow:0 6px 24px rgba(0,0,0,.07); }
  .brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); font:600 19px var(--disp); }
  .brand img { width:44px; height:44px; border-radius:12px; object-fit:cover; transition:transform .5s var(--ease); }
  .brand:hover img { transform:rotate(-12deg) scale(1.08); }
  .top nav { display:flex; align-items:center; gap:22px; } .top nav a { color:var(--ink); text-decoration:none; font-weight:600; font-size:15px; position:relative; }
  .top nav a::after { content:''; position:absolute; left:0; right:0; bottom:-5px; height:3px; border-radius:3px; background:var(--pink); transform:scaleX(0); transition:transform .3s var(--ease); }
  .top nav a:hover::after { transform:scaleX(1); }
  .btn { font:inherit; font-weight:700; color:#fff; background:var(--g); border:0; border-radius:999px; padding:12px 20px; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:10px; box-shadow:0 8px 20px rgba(61,174,43,.3); transition:transform .2s var(--ease), box-shadow .2s, background .2s; }
  .btn:hover { transform:translateY(-2px) rotate(-1deg); background:var(--g2); box-shadow:0 12px 26px rgba(61,174,43,.38); } .btn:active { transform:scale(.97); }
  .btn.sm { padding:9px 16px; font-size:14px; } .btn.lg { padding:15px 24px; font-size:16px; }
  .btn.ghost { background:#fff; color:var(--ink); box-shadow:inset 0 0 0 2px var(--ink); } .btn.ghost:hover { background:var(--ps); }
  .tag { display:inline-flex; align-items:center; gap:8px; font-size:12.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--g2); background:var(--gs); padding:7px 13px; border-radius:999px; margin:0 0 16px; }
  .tag.pinkbg { color:#b3247b; background:var(--ps); } .tag.light { color:#bff0b2; background:rgba(255,255,255,.1); }
