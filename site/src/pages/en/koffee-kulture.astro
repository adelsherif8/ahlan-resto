---
// Koffee Kulture — the café's own site, as a guest would see it. Our one addition is the
// chat bubble bottom-right: it opens the real dine-in widget (flows) on a showroom table.
// Real tables use the printed QR codes (branding/qr/koffee-kulture); the showroom table
// "DEMO" on the Arkan branch is exempt from the geofence (ai.dine_in_widget.showroom_tables).
import Base from '../../layouts/Base.astro';

const FLOWS = 'https://flows.munadim.com';
const DEMO_TOKEN = 'v1.eyJ2IjoxLCJiIjoiYXJrYW4iLCJ0IjoiREVNTyIsInIiOiJkMGNkMmM4Ni0xN2UyLTQ4ZTUtOTc0MC1hOGM5MWMxZWE2ZDkifQ.76OJRQTeb-Q9lGOrgh_9of6TdWfAe833W4GHkgjEQ7Y';
const widgetUrl = `${FLOWS}/t/${DEMO_TOKEN}?r=koffee-kulture`;
const LOGO = 'https://sxthftiqvaojbdyjizjr.supabase.co/storage/v1/object/public/brand/koffee-kulture/logo.jpg?v=1';

// Menu highlights — same names and prices as the tenant's menu (tools/seed-koffee.mjs).
const menu = [
  { name: 'Hot Koffee', items: [['Espresso', 80], ['Flat White', 110], ['Kappuccino', 125], ['Spanish Latte', 135], ['Salted Karamel Latte', 135], ['Pistachio Latte', 175]] },
  { name: 'Kold & Blended', note: 'M / L', items: [['Iced Spanish Latte', '125 / 145'], ['Iced Salted Karamel Latte', '125 / 145'], ['Iced Pistachio Latte', '165 / 185'], ['Blended Spanish Latte', '125 / 145'], ['Karamel Koffee Frappe', '125 / 145'], ['Iced Banana Bread Latte', '155 / 175']] },
  { name: 'Matcha Kulture', note: 'hot · iced M / L', items: [['Hot Matcha Latte', 150], ['Hot Salted Karamel Matcha', 165], ['Hot Pistachio Matcha', 185], ['Iced Matcha Latte', '140 / 160'], ['Blended Strawberry Matcha', '165 / 185'], ['Blended Pistachio Matcha', '180 / 195']] },
  { name: 'The Bakery Kulture', items: [['All Butter Kroissant', 80], ['Pistachio Kroissant', 120], ['Pistachio Konafa Kroissant', 180], ['Almond Kroissant', 110], ['Caprese Kroissant', 250], ['Labneh & Zaatar Kroissant', 270]] },
  { name: 'The KK Breakfast', items: [['The LA Benedict', 320], ['Shroom Truffle Benedict', 225], ['The Klassic Omelette', 190], ['Mushroom Invasion Omelette', 290], ['Savory Breakfast Bagel', 275], ['Pistachio Pancakes', 370]] },
  { name: 'Bagels & Sandwiches', items: [['Cream Cheese Bagel', 170], ['Lunch Bagel', 285], ['Philly Steak Bagel', 395], ['Kulture Bagel', 390], ['Sub Out', 290], ['Spicy Tunacado', 310]] },
  { name: 'Refreshers', items: [['Raspberry Mojito', 140], ['Ocean Breeze', 150], ['Coco Berry Redbull', 190], ['Passion Lemonade', 140], ['Love Story Smoothie', 170], ['Peach Ice Tea', 130]] },
  { name: 'Sweet Tooth Kulture', items: [['San Sebastian Cheesecake', 195], ['Tiramisu Jar', 190], ['Vanilla Berry Cake', 240], ['Brookies', 110], ['Kinder Cookie', 115], ['Brownies Salted Caramel Kan Kake', 245]] },
];
const branches = [
  { name: 'Arkan Plaza', area: 'Sheikh Zayed' },
  { name: 'Golf Central', area: 'Palm Hills' },
  { name: 'U Venues', area: 'New Cairo' },
  { name: 'District 5', area: 'New Cairo' },
  { name: 'O1 Kitchen Mall', area: 'New Cairo' },
  { name: 'Lake District', area: 'Mivida' },
  { name: 'Ivory', area: 'Villette by Sodic' },
];
---

<Base
  lang="en"
  title="Koffee Kulture — Specialty Koffee & Breakfast Kulture"
  description="Different People, Different Kultures, Different KOFFEE KUPS. Specialty coffee, matcha, kroissants, bagels and all-day breakfast in Sheikh Zayed and New Cairo. Order from your table."
  path="koffee-kulture"
>
  <div class="kk">
    <header class="top">
      <a class="brand" href="#top"><img src={LOGO} alt="Koffee Kulture" width="44" height="44" /><span>Koffee Kulture</span></a>
      <nav>
        <a href="#menu">Menu</a>
        <a href="#branches">Branches</a>
        <a href="#story">Our Kulture</a>
        <button class="order-btn" data-open-chat>Order from your table</button>
      </nav>
    </header>

    <section class="hero" id="top">
      <p class="tag">Specialty Koffee &amp; Breakfast Kulture</p>
      <h1>Different People.<br>Different Kultures.<br><em>Different Koffee Kups.</em></h1>
      <p class="lede">Single-origin espresso, ceremonial matcha, kroissants baked through the day and a breakfast menu that runs till midnight. Seven homes across Sheikh Zayed and New Cairo.</p>
      <div class="cta">
        <button class="btn" data-open-chat>☕ Order from your table</button>
        <a class="btn ghost" href="#menu">See the menu</a>
      </div>
      <p class="hours">Open daily 7:30 AM – 12:00 AM</p>
    </section>

    <section class="strip">
      <div><b>7</b><span>branches</span></div>
      <div><b>170+</b><span>things to order</span></div>
      <div><b>22</b><span>matcha ways</span></div>
      <div><b>7:30 → 00:00</b><span>every day</span></div>
    </section>

    <section class="menu" id="menu">
      <h2>The Menu</h2>
      <p class="sub">Prices in EGP, VAT inclusive · 12% service charge on dine-in · plant-based milks +40 · extra shot +35</p>
      <div class="cats">
        {menu.map((c) => (
          <article class="cat">
            <h3>{c.name}{c.note && <small> {c.note}</small>}</h3>
            <ul>{c.items.map(([n, p]) => <li><span>{n}</span><i></i><b>{p}</b></li>)}</ul>
          </article>
        ))}
      </div>
      <p class="more">The full list, sizes and add-ons are in the chat — ask for the menu and order in one line: <button class="link" data-open-chat>open the chat</button>.</p>
    </section>

    <section class="story" id="story">
      <div class="story-card">
        <h2>Our Kulture</h2>
        <p>This is what a Koffee Kulture is: different people, with different kultures, holding different koffee kups. We roast a Brazilian–Colombian arabica blend, whisk matcha to order, and bake every kroissant on site. Outdoor seats, table service, and a counter that never rushes you.</p>
      </div>
      <div class="story-card green">
        <h2>Order without leaving your seat</h2>
        <p>Scan the code on your table and tell us what you'd like, in English, Arabic or Franco. Sizes, oat milk, extra shot — all understood. The ticket reaches the counter with your table number; you pay there as always. No app, no waiting for a waiter.</p>
        <button class="btn light" data-open-chat>Try it now</button>
      </div>
    </section>

    <section class="branches" id="branches">
      <h2>Find your Kulture</h2>
      <div class="grid">
        {branches.map((b) => (
          <div class="branch"><b>{b.name}</b><span>{b.area}</span><small>7:30 AM – 12 AM</small></div>
        ))}
      </div>
      <p class="sub">Hotline 010 3499 9123 · amina@koffee-kulture.com</p>
    </section>

    <footer class="foot">
      <span>© Koffee Kulture</span>
      <span class="powered">Ordering by <a href="/en">Munadim</a></span>
    </footer>

    <!-- our addition: the chat bubble -->
    <button class="bubble" id="kk-bubble" aria-label="Order from your table" data-open-chat>
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H8l-5 3 1.5-4.5A8 8 0 1 1 21 12z"/></svg>
      <span class="hint">Order from your table</span>
    </button>
    <div class="panel" id="kk-panel" hidden>
      <div class="panel-head"><span>Koffee Kulture · your table</span><button id="kk-close" aria-label="Close">✕</button></div>
      <iframe id="kk-frame" title="Koffee Kulture — order from your table" allow="geolocation" data-src={widgetUrl}></iframe>
    </div>
  </div>

  <script>
    const panel = document.getElementById('kk-panel');
    const frame = document.getElementById('kk-frame');
    const bubble = document.getElementById('kk-bubble');
    const open = () => { if (!frame.src) frame.src = frame.dataset.src; panel.hidden = false; bubble.classList.add('open'); };
    const close = () => { panel.hidden = true; bubble.classList.remove('open'); };
    document.querySelectorAll('[data-open-chat]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); panel.hidden ? open() : close(); }));
    document.getElementById('kk-close').addEventListener('click', close);
    // a first-time visitor sees the hint for a few seconds, then just the bubble
    setTimeout(() => bubble.classList.add('quiet'), 6000);
  </script>
</Base>

<style>
  .kk { --g: #3DAE2B; --g2: #2f8f22; --ink: #15181a; --paper: #fbfaf6; --muted: #6b7280; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--paper); }
  .top { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: rgba(251,250,246,.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0,0,0,.06); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-weight: 800; letter-spacing: .02em; }
  .brand img { width: 44px; height: 44px; border-radius: 12px; object-fit: cover; }
  .top nav { display: flex; align-items: center; gap: 18px; }
  .top nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 15px; }
  .order-btn, .btn { font: inherit; font-weight: 700; color: #fff; background: var(--g); border: 0; border-radius: 999px; padding: 11px 18px; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1.5px solid rgba(0,0,0,.2); }
  .btn.light { background: #fff; color: var(--g2); }
  .hero { max-width: 1120px; margin: 0 auto; padding: 72px 20px 36px; }
  .tag { letter-spacing: .16em; text-transform: uppercase; font-size: 12px; color: var(--g2); font-weight: 700; margin: 0 0 14px; }
  .hero h1 { font-size: clamp(38px, 7vw, 74px); line-height: .98; margin: 0 0 18px; letter-spacing: -.01em; }
  .hero h1 em { font-style: normal; color: var(--g); }
  .lede { font-size: 19px; line-height: 1.5; max-width: 56ch; color: #333; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .hours { margin-top: 16px; color: var(--muted); font-size: 14px; }
  .strip { max-width: 1120px; margin: 24px auto 0; padding: 0 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .strip div { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 16px; padding: 16px; display: flex; flex-direction: column; }
  .strip b { font-size: 26px; color: var(--g2); } .strip span { color: var(--muted); font-size: 13px; }
  .menu { max-width: 1120px; margin: 0 auto; padding: 72px 20px 20px; }
  h2 { font-size: clamp(28px, 4vw, 40px); margin: 0 0 8px; }
  .sub { color: var(--muted); margin: 0 0 22px; font-size: 14px; }
  .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .cat { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 18px; padding: 18px 20px; }
  .cat h3 { margin: 0 0 10px; font-size: 18px; color: var(--g2); } .cat h3 small { color: var(--muted); font-weight: 500; font-size: 12px; }
  .cat ul { list-style: none; margin: 0; padding: 0; }
  .cat li { display: flex; align-items: baseline; gap: 8px; padding: 7px 0; font-size: 15px; }
  .cat li i { flex: 1; border-bottom: 1px dotted rgba(0,0,0,.25); transform: translateY(-4px); } .cat li b { white-space: nowrap; }
  .more { margin-top: 18px; color: var(--muted); }
  .link { font: inherit; color: var(--g2); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .story { max-width: 1120px; margin: 56px auto 0; padding: 0 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .story-card { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 22px; padding: 28px; line-height: 1.55; }
  .story-card.green { background: var(--g); color: #fff; } .story-card.green h2 { color: #fff; } .story-card .btn { margin-top: 14px; }
  .branches { max-width: 1120px; margin: 0 auto; padding: 72px 20px 48px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
  .branch { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 2px; }
  .branch b { font-size: 16px; } .branch span { color: var(--muted); font-size: 14px; } .branch small { color: var(--g2); font-size: 12px; margin-top: 6px; }
  .foot { display: flex; justify-content: space-between; padding: 22px 20px 110px; color: var(--muted); font-size: 13px; border-top: 1px solid rgba(0,0,0,.06); }
  .foot a { color: var(--g2); }
  /* the chat bubble + panel */
  .bubble { position: fixed; right: 18px; bottom: 18px; z-index: 50; display: flex; align-items: center; gap: 10px; background: var(--g); color: #fff; border: 0; border-radius: 999px; padding: 14px 18px 14px 14px; box-shadow: 0 14px 36px rgba(61,174,43,.45); cursor: pointer; font: inherit; font-weight: 700; transition: padding .25s; }
  .bubble .hint { white-space: nowrap; max-width: 220px; overflow: hidden; transition: max-width .3s, opacity .3s; }
  .bubble.quiet { padding-right: 14px; } .bubble.quiet .hint { max-width: 0; opacity: 0; }
  .bubble.open { background: var(--ink); box-shadow: none; }
  .panel { position: fixed; right: 18px; bottom: 86px; z-index: 49; width: min(400px, calc(100vw - 36px)); height: min(680px, calc(100dvh - 110px)); background: #fff; border-radius: 22px; overflow: hidden; box-shadow: 0 24px 70px rgba(0,0,0,.28); display: flex; flex-direction: column; animation: up .22s ease-out; }
  .panel[hidden] { display: none; }
  .panel-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: var(--g); color: #fff; font-weight: 700; font-size: 14px; }
  .panel-head button { font: inherit; color: #fff; background: transparent; border: 0; font-size: 16px; cursor: pointer; }
  .panel iframe { flex: 1; width: 100%; border: 0; }
  @keyframes up { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (max-width: 720px) { .top nav a { display: none; } .order-btn { padding: 9px 14px; font-size: 14px; } }
</style>
