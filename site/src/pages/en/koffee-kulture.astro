---
// Koffee Kulture — the café's own site. Our one addition is the chat bubble bottom-right,
// which opens the real dine-in widget (flows) on the showroom table DEMO at Arkan.
// Icons: Font Awesome 6 (no emoji anywhere on the page).
import Base from '../../layouts/Base.astro';

const FLOWS = 'https://flows.munadim.com';
const DEMO_TOKEN = 'v1.eyJ2IjoxLCJiIjoiYXJrYW4iLCJ0IjoiREVNTyIsInIiOiJkMGNkMmM4Ni0xN2UyLTQ4ZTUtOTc0MC1hOGM5MWMxZWE2ZDkifQ.76OJRQTeb-Q9lGOrgh_9of6TdWfAe833W4GHkgjEQ7Y';
const widgetUrl = `${FLOWS}/t/${DEMO_TOKEN}?r=koffee-kulture`;
const LOGO = 'https://sxthftiqvaojbdyjizjr.supabase.co/storage/v1/object/public/brand/koffee-kulture/logo.jpg?v=1';

const menu = [
  { key: 'hot', name: 'Hot Koffee', icon: 'fa-mug-hot', items: [['Espresso', 80, 'Double shot of the house blend'], ['Flat White', 110, 'Double espresso, steamed milk'], ['Kappuccino', 125, 'Espresso, steamed milk foam'], ['Spanish Latte', 135, 'Espresso, milk, condensed milk'], ['Salted Karamel Latte', 135, 'Double espresso, salted caramel'], ['Pistachio Latte', 175, 'Steamed milk, pistachio syrup']] },
  { key: 'cold', name: 'Kold & Blended', icon: 'fa-glass-water', note: 'M / L', items: [['Iced Spanish Latte', '125 / 145', 'Milk, espresso, condensed milk'], ['Iced Salted Karamel', '125 / 145', 'Creamy, salted caramel syrup'], ['Iced Pistachio Latte', '165 / 185', 'Iced latte, pistachio'], ['Blended Spanish Latte', '125 / 145', 'Strong coffee, condensed milk, ice'], ['Karamel Koffee Frappe', '125 / 145', 'Coffee, caramel, milk, ice'], ['Iced Banana Bread Latte', '155 / 175', 'Banana, cinnamon, milk']] },
  { key: 'matcha', name: 'Matcha Kulture', icon: 'fa-leaf', items: [['Hot Matcha Latte', 150, 'Best with skim or coconut milk'], ['Hot Salted Karamel Matcha', 165, 'Hot matcha, salted caramel'], ['Hot Pistachio Matcha', 185, 'Matcha, pistachio, hot milk'], ['Iced Matcha Latte', '140 / 160', 'Iced, whisked to order'], ['Blended Strawberry Matcha', '165 / 185', 'Matcha, strawberry sauce'], ['Blended Pistachio Matcha', '180 / 195', 'Matcha, pistachio sauce']] },
  { key: 'bakery', name: 'Bakery', icon: 'fa-bread-slice', items: [['All Butter Kroissant', 80, 'Viennoise, butter-rich'], ['Pistachio Kroissant', 120, 'Pistachio from Italy'], ['Pistachio Konafa Kroissant', 180, 'Kunafa, pistachio, chocolate'], ['Almond Kroissant', 110, 'Almond cream, toasted almonds'], ['Caprese Kroissant', 250, 'Mozzarella, pesto, cherry tomato'], ['Labneh & Zaatar Kroissant', 270, 'Turkish labneh, fresh zaatar']] },
  { key: 'breakfast', name: 'Breakfast', icon: 'fa-egg', items: [['The LA Benedict', 320, 'Smoked salmon, avocado, dill hollandaise'], ['Shroom Truffle Benedict', 225, 'Mushrooms, spinach, truffle hollandaise'], ['The Klassic Omelette', 190, 'Folded, parmesan'], ['Mushroom Invasion Omelette', 290, 'Thyme mushrooms, fried brie'], ['Savory Breakfast Bagel', 275, 'Scrambled egg, halloumi, spinach'], ['Pistachio Pancakes', 370, 'Pistachio sauce, fresh cream']] },
  { key: 'bagels', name: 'Bagels & Sandwiches', icon: 'fa-burger', items: [['Cream Cheese Bagel', 170, 'Baked daily'], ['Lunch Bagel', 285, 'Grilled chicken, Caesar, parmesan'], ['Philly Steak Bagel', 395, 'Steak, mushrooms, cheddar'], ['Kulture Bagel', 390, 'Salmon, avocado, honey mustard'], ['Sub Out', 290, 'Avocado, chicken, sweet chili mayo'], ['Spicy Tunacado', 310, 'Tuna, pesto, jalapeño, guacamole']] },
  { key: 'refresh', name: 'Refreshers', icon: 'fa-lemon', items: [['Raspberry Mojito', 140, 'Raspberry, mint, lemon'], ['Ocean Breeze', 150, 'Lemon soda, coconut, blue curaçao'], ['Coco Berry Redbull', 190, 'Red Bull, coconut, berries'], ['Passion Lemonade', 140, 'Passion fruit, lemon'], ['Love Story Smoothie', 170, 'Pineapple, passion fruit, peach'], ['Peach Ice Tea', 130, 'Peach iced tea']] },
  { key: 'sweet', name: 'Sweet Tooth', icon: 'fa-cake-candles', items: [['San Sebastian Cheesecake', 195, 'Basque-style'], ['Tiramisu Jar', 190, 'Made with our koffee'], ['Vanilla Berry Cake', 240, 'Ganache, raspberry, berries'], ['Brookies', 110, 'Brownie meets cookie'], ['Kinder Cookie', 115, 'Kinder spread filling'], ['Salted Caramel Kan Kake', 245, 'Brownie, salted caramel']] },
];
const branches = [
  { name: 'Arkan Plaza', area: 'Sheikh Zayed' }, { name: 'Golf Central', area: 'Palm Hills' },
  { name: 'U Venues', area: 'New Cairo' }, { name: 'District 5', area: 'New Cairo' },
  { name: 'O1 Kitchen Mall', area: 'New Cairo' }, { name: 'Lake District', area: 'Mivida' },
  { name: 'Ivory', area: 'Villette by Sodic' },
];
// what the AI handles across the whole visit (each one is live in the table chat)
const does = [
  { icon: 'fa-comments', title: 'Takes the order', text: 'Sizes, oat milk, extra shot, "same as last time" — in English, Arabic or Franco.' },
  { icon: 'fa-wand-magic-sparkles', title: 'Suggests the add-on', text: 'A kroissant with the latte, at the moment it fits. Never pushy.' },
  { icon: 'fa-chair', title: 'Knows the table', text: 'Every ticket carries its table number. Nobody at another table can order to yours.' },
  { icon: 'fa-arrows-split-up-and-left', title: 'Routes it', text: 'Drinks to the bar screen, food to the kitchen screen, at the same second.' },
  { icon: 'fa-list-check', title: 'Tracks it', text: 'Received, making, ready, served — the guest sees it live on their phone.' },
  { icon: 'fa-bell-concierge', title: 'Calls staff', text: '"Need help", "the bill", "water" — one tap, the counter hears a chime.' },
  { icon: 'fa-user-check', title: 'Remembers regulars', text: 'Next visit: "Welcome back, Sara — your usual?" Verified once on WhatsApp.' },
  { icon: 'fa-star', title: 'Collects reviews', text: 'Happy guests go to Google. Unhappy ones reach the manager privately, the same day.' },
  { icon: 'fa-chart-line', title: 'Reports to you', text: 'Orders, average check, add-on rate, kitchen time and peak hours, per branch.' },
];
const steps = [
  { icon: 'fa-qrcode', title: 'Scan', text: 'The code on your table opens the chat already knowing where you sit.' },
  { icon: 'fa-comments', title: 'Say it', text: '"Large iced spanish latte, oat milk, and a pistachio kroissant." Done.' },
  { icon: 'fa-bell-concierge', title: 'Served', text: 'The ticket reaches the counter with your table number. Pay there as usual.' },
];
---

<Base
  lang="en"
  title="Koffee Kulture — Specialty Koffee & Breakfast Kulture"
  description="Different People, Different Kultures, Different KOFFEE KUPS. Specialty coffee, matcha, kroissants, bagels and all-day breakfast in Sheikh Zayed and New Cairo. Order from your table."
  path="koffee-kulture"
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <div class="kk">
    <header class="top" id="top-bar">
      <a class="brand" href="#top"><img src={LOGO} alt="Koffee Kulture" width="40" height="40" /><span>Koffee Kulture</span></a>
      <nav>
        <a href="#menu">Menu</a>
        <a href="#how">How to order</a>
        <a href="#branches">Branches</a>
        <button class="btn sm" data-open-chat><i class="fa-solid fa-mug-saucer"></i><span>Order</span></button>
      </nav>
    </header>

    <section class="hero" id="top">
      <div class="blob b1"></div><div class="blob b2"></div>
      <div class="hero-in">
        <p class="tag reveal"><i class="fa-solid fa-seedling"></i> Specialty Koffee &amp; Breakfast Kulture</p>
        <h1 class="reveal">Different People.<br>Different Kultures.<br><em>Different Koffee Kups.</em></h1>
        <p class="lede reveal">Espresso pulled to order, matcha whisked by hand, kroissants baked through the day and breakfast till midnight. Seven homes across Sheikh Zayed and New Cairo.</p>
        <div class="cta reveal">
          <button class="btn lg" data-open-chat><i class="fa-solid fa-comment-dots"></i> Order from your table</button>
          <a class="btn lg ghost" href="#menu"><i class="fa-solid fa-book-open"></i> See the menu</a>
        </div>
        <p class="hours reveal"><span class="dot"></span><span id="open-state">Open daily 7:30 AM – 12:00 AM</span></p>
      </div>
      <div class="cup reveal" aria-hidden="true">
        <div class="steam"><span></span><span></span><span></span></div>
        <i class="fa-solid fa-mug-hot"></i>
      </div>
    </section>

    <section class="strip">
      <div class="stat reveal"><i class="fa-solid fa-location-dot"></i><b data-count="7">0</b><span>branches</span></div>
      <div class="stat reveal"><i class="fa-solid fa-utensils"></i><b data-count="170" data-suffix="+">0</b><span>things to order</span></div>
      <div class="stat reveal"><i class="fa-solid fa-leaf"></i><b data-count="22">0</b><span>matcha drinks</span></div>
      <div class="stat reveal"><i class="fa-regular fa-clock"></i><b>7:30–00:00</b><span>every day</span></div>
    </section>

    <section class="menu" id="menu">
      <div class="head reveal">
        <h2>The Menu</h2>
        <p class="sub">EGP, VAT inclusive · 12% service on dine-in · plant milk +40 · extra shot +35</p>
      </div>
      <div class="tabs reveal" role="tablist">
        {menu.map((c, i) => (
          <button class={`tab ${i === 0 ? 'on' : ''}`} role="tab" data-tab={c.key}><i class={`fa-solid ${c.icon}`}></i>{c.name}</button>
        ))}
      </div>
      <div class="search reveal"><i class="fa-solid fa-magnifying-glass"></i><input id="q" placeholder="Search the menu — matcha, pistachio, bagel…" autocomplete="off" /></div>
      <div class="board">
        {menu.map((c, i) => (
          <div class={`panel-cat ${i === 0 ? 'on' : ''}`} data-cat={c.key}>
            {c.items.map(([n, p, d]) => (
              <article class="item" data-name={`${n} ${d}`.toLowerCase()}>
                <div class="ic"><i class={`fa-solid ${c.icon}`}></i></div>
                <div class="tx"><b>{n}</b><span>{d}</span></div>
                <div class="pr">{p}<small>EGP</small></div>
                <button class="add" data-ask={`I'd like ${n}`} aria-label={`Order ${n}`}><i class="fa-solid fa-plus"></i></button>
              </article>
            ))}
          </div>
        ))}
        <p class="empty" id="empty" hidden><i class="fa-regular fa-face-frown"></i> Nothing matches — ask in the chat, it knows all 170 items.</p>
      </div>
    </section>

    <section class="how" id="how">
      <div class="head reveal">
        <h2>Your table runs itself</h2>
        <p class="sub">An AI host on every table: it takes the order, sends it to the bar and kitchen, calls staff, and remembers your regulars. No app to download.</p>
      </div>
      <div class="steps">
        {steps.map((s, i) => (
          <div class="step reveal" style={`--d:${i * 120}ms`}>
            <div class="num">{i + 1}</div>
            <i class={`fa-solid ${s.icon} big`}></i>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <div class="does-head reveal">
        <p class="tag"><i class="fa-solid fa-microchip"></i> One AI, the whole visit</p>
        <h3>It doesn't stop at taking the order</h3>
      </div>
      <div class="does">
        {does.map((d, i) => (
          <div class="do reveal" style={`--d:${i * 50}ms`}>
            <i class={`fa-solid ${d.icon}`}></i>
            <div><b>{d.title}</b><span>{d.text}</span></div>
          </div>
        ))}
      </div>
      <div class="trust reveal">
        <div><i class="fa-solid fa-shield-halved"></i><span>Each table's code is signed — it can't be edited to point at another table.</span></div>
        <div><i class="fa-solid fa-location-crosshairs"></i><span>Orders only go through from inside the café. A photo of the code sent across town places nothing.</span></div>
        <div><i class="fa-solid fa-user-check"></i><span>Nobody on staff has to confirm anything. Your table, for your visit.</span></div>
      </div>
      <button class="btn lg center reveal" data-open-chat><i class="fa-solid fa-comment-dots"></i> Try it now</button>
    </section>

    <section class="branches" id="branches">
      <div class="head reveal"><h2>Find your Kulture</h2><p class="sub">Every branch, every day, 7:30 AM – 12 AM</p></div>
      <div class="grid">
        {branches.map((b, i) => (
          <div class="branch reveal" style={`--d:${i * 60}ms`}>
            <i class="fa-solid fa-location-dot"></i>
            <div><b>{b.name}</b><span>{b.area}</span></div>
          </div>
        ))}
      </div>
      <p class="contact reveal"><a href="tel:01034999123"><i class="fa-solid fa-phone"></i> 010 3499 9123</a><a href="mailto:amina@koffee-kulture.com"><i class="fa-regular fa-envelope"></i> amina@koffee-kulture.com</a></p>
    </section>

    <footer class="foot">
      <span>© Koffee Kulture</span>
      <span>Table ordering by <a href="/en">Munadim</a></span>
    </footer>

    <!-- our addition: the chat bubble -->
    <button class="bubble" id="kk-bubble" aria-label="Order from your table" data-open-chat>
      <span class="ring"></span>
      <i class="fa-solid fa-comment-dots ico-open"></i>
      <i class="fa-solid fa-xmark ico-close"></i>
      <span class="hint">Order from your table</span>
    </button>
    <div class="chat" id="kk-panel" aria-hidden="true">
      <iframe id="kk-frame" title="Koffee Kulture — order from your table" allow="geolocation" data-src={widgetUrl}></iframe>
    </div>
  </div>

  <script>
    const panel = document.getElementById('kk-panel');
    const frame = document.getElementById('kk-frame');
    const bubble = document.getElementById('kk-bubble');
    const isOpen = () => panel.classList.contains('open');
    function openChat(prefill) {
      if (!frame.src) frame.src = frame.dataset.src;
      panel.classList.add('open'); panel.setAttribute('aria-hidden', 'false'); bubble.classList.add('open');
      if (prefill) {
        const send = () => frame.contentWindow?.postMessage({ type: 'kk:prefill', text: prefill }, '*');
        frame.dataset.loaded ? send() : frame.addEventListener('load', () => setTimeout(send, 1200), { once: true });
      }
    }
    function closeChat() { panel.classList.remove('open'); panel.setAttribute('aria-hidden', 'true'); bubble.classList.remove('open'); }
    frame.addEventListener('load', () => { frame.dataset.loaded = '1'; });
    document.querySelectorAll('[data-open-chat]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); isOpen() && b === bubble ? closeChat() : openChat(); }));
    document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => { b.classList.add('pop'); setTimeout(() => b.classList.remove('pop'), 400); openChat(b.dataset.ask); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeChat(); });
    setTimeout(() => bubble.classList.add('quiet'), 7000);

    // menu tabs + search
    const tabs = document.querySelectorAll('.tab');
    const cats = document.querySelectorAll('.panel-cat');
    const q = document.getElementById('q');
    const empty = document.getElementById('empty');
    tabs.forEach((t) => t.addEventListener('click', () => {
      q.value = ''; filter();
      tabs.forEach((x) => x.classList.toggle('on', x === t));
      cats.forEach((c) => c.classList.toggle('on', c.dataset.cat === t.dataset.tab));
    }));
    function filter() {
      const s = q.value.trim().toLowerCase();
      document.querySelector('.board').classList.toggle('searching', !!s);
      let hits = 0;
      document.querySelectorAll('.item').forEach((it) => { const ok = !s || it.dataset.name.includes(s); it.classList.toggle('hide', !ok); if (ok && s) hits++; });
      empty.hidden = !s || hits > 0;
    }
    q.addEventListener('input', filter);

    // scroll reveal + count-up
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in'); io.unobserve(e.target);
      const n = e.target.querySelector('[data-count]');
      if (n) { const to = +n.dataset.count, suf = n.dataset.suffix || ''; let t0; const tick = (t) => { t0 ??= t; const p = Math.min((t - t0) / 900, 1); n.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))) + suf; if (p < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); }
    }), { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // header shadow on scroll
    const bar = document.getElementById('top-bar');
    addEventListener('scroll', () => bar.classList.toggle('scrolled', scrollY > 10), { passive: true });

    // open now / closed (Cairo time, 07:30–24:00)
    const h = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Cairo' }));
    const mins = h.getHours() * 60 + h.getMinutes();
    const open = mins >= 450;
    const st = document.getElementById('open-state');
    st.textContent = open ? 'Open now · until midnight' : 'Closed now · opens 7:30 AM';
    st.parentElement.classList.toggle('closed', !open);
  </script>
</Base>

<style>
  .kk { --g: #3DAE2B; --g2: #2a8a1f; --gs: #e9f6e6; --ink: #14171a; --paper: #fbfaf6; --card: #fff; --muted: #6b7280; --line: rgba(0,0,0,.07); --ease: cubic-bezier(.2,.8,.2,1);
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--paper); overflow-x: clip; }
  .kk i.fa-solid, .kk i.fa-regular { line-height: 1; }
  /* header */
  .top { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: rgba(251,250,246,.82); backdrop-filter: blur(12px); transition: box-shadow .3s; }
  .top.scrolled { box-shadow: 0 6px 24px rgba(0,0,0,.06); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-weight: 800; }
  .brand img { width: 40px; height: 40px; border-radius: 11px; object-fit: cover; transition: transform .4s var(--ease); }
  .brand:hover img { transform: rotate(-8deg) scale(1.05); }
  .top nav { display: flex; align-items: center; gap: 20px; }
  .top nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 15px; position: relative; }
  .top nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--g); transform: scaleX(0); transition: transform .3s var(--ease); }
  .top nav a:hover::after { transform: scaleX(1); }
  /* buttons */
  .btn { font: inherit; font-weight: 700; color: #fff; background: var(--g); border: 0; border-radius: 999px; padding: 12px 20px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: transform .2s var(--ease), box-shadow .2s, background .2s; box-shadow: 0 8px 20px rgba(61,174,43,.28); }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(61,174,43,.36); background: var(--g2); }
  .btn:active { transform: translateY(0) scale(.98); }
  .btn.sm { padding: 9px 16px; font-size: 14px; }
  .btn.lg { padding: 15px 24px; font-size: 16px; }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px rgba(0,0,0,.18); }
  .btn.ghost:hover { background: #fff; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .btn.center { display: flex; margin: 28px auto 0; width: fit-content; }
  /* hero */
  .hero { position: relative; max-width: 1180px; margin: 0 auto; padding: 80px 20px 40px; display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: 24px; }
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .45; z-index: 0; animation: float 14s ease-in-out infinite; }
  .b1 { width: 380px; height: 380px; background: #c8eec0; top: -40px; right: 8%; }
  .b2 { width: 260px; height: 260px; background: #f4e1c1; bottom: 0; left: 30%; animation-delay: -6s; }
  @keyframes float { 50% { transform: translate(30px, -24px) scale(1.08); } }
  .hero-in { position: relative; z-index: 1; }
  .tag { display: inline-flex; align-items: center; gap: 8px; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; color: var(--g2); font-weight: 800; background: var(--gs); padding: 7px 12px; border-radius: 999px; margin: 0 0 18px; }
  .hero h1 { font-size: clamp(40px, 6.6vw, 76px); line-height: .98; margin: 0 0 20px; letter-spacing: -.02em; }
  .hero h1 em { font-style: normal; background: linear-gradient(90deg, var(--g), #7fd36b, var(--g)); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shine 6s linear infinite; }
  @keyframes shine { to { background-position: 200% center; } }
  .lede { font-size: 19px; line-height: 1.55; max-width: 54ch; color: #3a3f44; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .hours { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; color: var(--muted); font-size: 14px; }
  .hours .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g); box-shadow: 0 0 0 0 rgba(61,174,43,.6); animation: ping 2s infinite; }
  .hours.closed .dot { background: #d97706; animation: none; }
  @keyframes ping { 70% { box-shadow: 0 0 0 10px rgba(61,174,43,0); } 100% { box-shadow: 0 0 0 0 rgba(61,174,43,0); } }
  .cup { position: relative; z-index: 1; justify-self: center; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fff, var(--gs)); display: grid; place-items: center; box-shadow: 0 30px 60px rgba(61,174,43,.18); }
  .cup > i { font-size: 110px; color: var(--g); }
  .steam { position: absolute; top: 46px; left: 50%; transform: translateX(-60%); display: flex; gap: 12px; }
  .steam span { width: 6px; height: 34px; border-radius: 6px; background: rgba(61,174,43,.35); animation: steam 2.6s ease-in-out infinite; }
  .steam span:nth-child(2) { animation-delay: .4s; } .steam span:nth-child(3) { animation-delay: .8s; }
  @keyframes steam { 0% { transform: translateY(10px) scaleY(.6); opacity: 0; } 40% { opacity: .9; } 100% { transform: translateY(-26px) scaleY(1.1); opacity: 0; } }
  /* stats */
  .strip { max-width: 1180px; margin: 10px auto 0; padding: 0 20px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .stat { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 18px; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: center; transition: transform .3s var(--ease), box-shadow .3s; }
  .stat:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,.06); }
  .stat i { grid-row: span 2; width: 44px; height: 44px; border-radius: 12px; background: var(--gs); color: var(--g2); display: grid; place-items: center; font-size: 18px; }
  .stat b { font-size: 24px; color: var(--ink); } .stat span { color: var(--muted); font-size: 13px; }
  /* sections */
  .menu, .how, .branches { max-width: 1180px; margin: 0 auto; padding: 84px 20px 0; }
  .head h2 { font-size: clamp(30px, 4vw, 44px); margin: 0 0 6px; letter-spacing: -.01em; }
