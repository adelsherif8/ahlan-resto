---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import WhatIs from '../../components/WhatIs.astro';
import DineIn from '../../components/DineIn.astro';
import Steps from '../../components/Steps.astro';
import Understands from '../../components/Understands.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Pricing from '../../components/Pricing.astro';
import Objections from '../../components/Objections.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import { ar as t } from '../../content/ar';
---

<Base
  lang="ar"
  title={t.meta.title}
  description={t.meta.description}
  preloadFonts={[
    'amiri-v30-arabic-700.woff2',
    'ibm-plex-sans-arabic-v15-arabic_latin-regular.woff2',
  ]}
>
  <Header t={t} lang="ar" />
  <main>
    <Hero t={t} lang="ar" />
    <Problem t={t} />
    <WhatIs t={t} />
    <DineIn t={t} />
    <Steps t={t} />
    <Understands t={t} />
    <TrustStrip t={t} />
    <Pricing t={t} />
    <Objections t={t} />
    <Closing t={t} />
  </main>
  <Footer t={t} lang="ar" />
</Base>
