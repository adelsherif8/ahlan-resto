---
/**
 * The reference site's choreography (fixed hero that opens and lifts away,
 * one pinned reveal, quiet entrances, pill nav, sticky pill) carrying
 * Munadim's content in Munadim's light palette. One stylesheet
 * (styles/clone.css), one script (public/js/clone.js) — no framework islands,
 * so nothing fights the scroll rig.
 *
 * Funnel order: hero → the arithmetic (pinned) → what an order produces →
 * what it understands → the dining room → 3 steps → trust band → price +
 * calculator → questions → closing.
 */
import { ar as t } from '../../content/ar';
import { WA_LINK, WA_NUMBER_DISPLAY, CONTACT_EMAIL } from '../../lib/const';
import '../../styles/fonts.css';
import '../../styles/clone.css';

const heroWords = t.hero.h1.split(' ');
const [subA, subB] = t.hero.sub.split('.').map((s) => s.trim()).filter(Boolean);
const rec = t.whatIs.panels.receipt;
const tk = t.whatIs.panels.ticket;
const pf = t.whatIs.panels.profile;
const sc = t.dineIn.scene;
const jr = t.steps.journey;
const qrCells = [
  '1111111 01 1111111','1000001 10 1000001','1011101 01 1011101','1011101 11 1011101',
  '1011101 00 1011101','1000001 01 1000001','1111111 10 1111111','0000000 11 0000000',
  '1101011 01 0110110','0010110 10 1001011','1111111 00 0110101','1000001 11 1010010',
  '1011101 01 0101101','1011101 10 1110010','1011101 01 0011101','1000001 11 1100010',
  '1111111 00 0101011',
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/brand/08-favicon.svg" />
    <link rel="preload" href="/fonts/amiri-v30-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-arabic-v15-arabic_latin-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">تخطَّ للمحتوى</a>

    <!-- ═══════════════════════ PRELOADER ═══════════════════════ -->
    <div class="pre" id="pre">
      <div class="pre__mark">
        <span class="pre__word"><b>مُنادم</b></span>
        <span class="pre__rule" aria-hidden="true"><i></i></span>
        <p class="pre__brand">قناة الطلبات المباشرة لمطعمك.</p>
      </div>
    </div>

    <!-- ═════════════════════════ NAV ═══════════════════════════ -->
    <header class="nav" id="nav">
      <div class="nav__pill">
        <a class="nav__brand" href="#main" aria-label="Munadim">
          <img src="/brand/21-lockup-horizontal-light-nobg.svg" alt="Munadim" width="120" height="40" />
        </a>
        <nav class="nav__links" aria-label="Primary">
          {t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <a class="btn btn--yellow btn--sm" href={WA_LINK}>{t.nav.cta}</a>
      </div>
    </header>

    <main id="main">
      <!-- ═══════════════════ 1 · HERO ══════════════════════ -->
      <div class="hero" id="hero">
        <div class="hero__bar" id="hero-bar">
          <img src="/brand/20-lockup-horizontal-dark-nobg.svg" alt="" width="120" height="40" />
        </div>
        <div class="hero__area" id="hero-area">
          <div class="hero__frame" id="hero-frame">
            <div class="hero__stage">
              <!-- the payoff: the customer, on record, slides out from behind the phone -->
              <div class="hero__card record" id="hero-card" aria-hidden="true">
                <div class="record__head">
                  <span class="record__av">{t.whatIs.flow.record.name.charAt(0)}</span>
                  <span><b>{t.whatIs.flow.record.name}</b><span class="num" dir="ltr">{t.whatIs.flow.record.phone}</span></span>
                  <span class="record__badge">{t.whatIs.panels.profile.badge}</span>
                </div>
                {t.whatIs.flow.record.rows.map((r) => <div class="record__row"><span>{r.label}</span><b>{r.value}</b></div>)}
                <p class="record__captured">✓ {t.whatIs.flow.captured}</p>
              </div>
              <!-- the conversation: their video slot. Bubbles land one by one as you scroll. -->
              <div class="chat" id="hero-chat" dir="rtl">
                <div class="chat__top">
                  <span class="chat__av">{t.hero.restaurant.trim().charAt(0)}</span>
                  <span class="chat__who"><b>{t.hero.restaurant}</b><span>{t.hero.chatStatus}</span></span>
                  <span class="chat__demo">{t.hero.demoLabel}</span>
                </div>
                <div class="chat__body">
                  {t.hero.chat.map((m) => (
                    <>
                    {m.from === 'out' && <div class="chat__b chat__b--out chat__typing" aria-hidden="true"><i></i><i></i><i></i></div>}
                    <div class:list={['chat__b', m.from === 'out' ? 'chat__b--out' : 'chat__b--in']}>
                      {m.voice && (
                        <span class="chat__voice">
                          <span class="chat__wave">
                            {[5,9,14,8,12,17,10,6,12,16,9,5,8,13,18,11,7,10].map((h) => <i style={`height:${h}px`}></i>)}
                          </span>
                          <b class="num">{m.voice.duration}</b>
                        </span>
                      )}
                      {m.bill && (
                        <span>
                          {m.bill.lines.map((l) => (
                            <span class="chat__bill"><span>{l.label}</span><b>{l.price}</b></span>
                          ))}
                          <span class="chat__bill chat__sum"><span>{m.bill.total.label}</span><b>{m.bill.total.price}</b></span>
                          {m.bill.after && <span>{m.bill.after}</span>}
                        </span>
                      )}
                      {m.text && <span>{m.text}</span>}
                      <span class="chat__t">{m.time}</span>
                    </div>
                    </>
                  ))}
                </div>
              </div>
            </div>
            <div class="hero__veil"></div>
          </div>
          <div class="hero__copy" id="hero-copy">
            <p class="hero__kicker">{t.hero.demoLabel} · {t.hero.restaurant}</p>
            <p class="hero__beat" id="hero-beat" aria-hidden="true">
              <span class="is-on">{t.whatIs.flow.step1}</span><span>{t.whatIs.flow.step2}</span><span>{t.whatIs.flow.step3}</span>
            </p>
            <h1 class="hero__title" id="hero-title">
              <span class="ln">
                {heroWords.map((w) => <span class="w"><i>{w}</i></span>)}
              </span>
            </h1>
            <div class="hero__subs">
              <p class="hero__sub" id="sub1">{subA}.</p>
              <p class="hero__sub" id="sub2">{subB}.</p>
              <p class="hero__sub" id="sub3">{t.whatIs.flow.captured}.</p>
            </div>
            <div class="hero__cta">
              <a class="btn btn--yellow" href={WA_LINK}>{t.hero.ctaPrimary} <span aria-hidden="true">←</span></a>
              <a class="hero__more" href="#pricing">{t.hero.ctaSecondary}</a>
            </div>
          </div>
          <p class="hero__hint" id="hero-hint">[ انزل ]</p>
        </div>
      </div>
      <div class="hero-spacer"></div>

      <!-- ═══ 2 · THE ARITHMETIC — the receipt that gets torn (short pin) ═══ -->
      <section class="scale" id="problem">
        <div class="scale__pin" id="scale-pin">
          <div class="wrap tear">
            <div class="tear__copy">
              <p class="eyebrow"><span class="eyebrow__rule"></span> [01] {t.pricing.mathH3}</p>
              <h2 class="mega mega--md">{t.problem.h2}</h2>
              <p class="lede">{t.problem.p1}</p>
              <p class="lede">{t.problem.p2}</p>
              <p class="tear__close" id="tear-close">{t.pricing.mathClose}</p>
              <a class="btn btn--yellow" href="#pricing">{t.hero.ctaSecondary} <span aria-hidden="true">↓</span></a>
            </div>
            <div class="tear__stage" id="tear-stage">
              <div class="tally tally--app" id="tally-app"><span>{t.pricing.picker.appSide}</span><b class="num" id="tally-app-n">240</b> {t.pricing.picker.egp}</div>
              <div class="tally tally--ours" id="tally-ours"><span>{t.pricing.ourCost.label}</span><b class="num" id="tally-ours-n">68</b> {t.pricing.picker.egp}</div>
              <div class="stack" id="stack">
                {[0,1,2,3,4,5,6,7].map((i) => (
                  <div class="rcpt" data-i={i}>
                    <b>{t.hero.restaurant}</b>
                    <span class="rcpt__meta num">{t.problem.bar.order} · #{i + 1}</span>
                    <span class="rcpt__row"><span>{jr.orderItem}</span><b class="num">150</b></span>
                    <i class="rcpt__tear num">−30 <small>{t.problem.bar.app.replace('حوالي 30 جنيه ', '')}</small></i>
                  </div>
                ))}
              </div>
              <p class="stack__label" id="stack-label">نفس الزبون — <b class="num">8</b> مرات</p>
              <div class="tear__diff" id="tear-diff"><span>الفرق من زبون واحد في الشهر</span><b class="num">172</b> {t.pricing.picker.egp}</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 3 · ONE ORDER, THREE DESTINATIONS ═══ -->
      <section class="sec" id="outputs">
        <div class="wrap">
          <header class="sec-head sec-head--row sec-head--tight">
            <div>
              <p class="eyebrow"><span class="eyebrow__rule"></span> [02] {t.whatIs.h2}</p>
              <h2 class="mega mega--md">أوردر واحد. تلات حاجات بتحصل.</h2>
            </div>
            <p class="lede">{t.whatIs.p1}</p>
          </header>
          <div class="fan scene" id="scene-outputs">
            <div class="fan__src">
              <div class="chat__b chat__b--in fan__voice">
                <span class="chat__voice">
                  <span class="chat__wave chat__wave--live">{[5,9,14,8,12,17,10,6,12,16,9,5,8,13,18,11,7,10].map((h) => <i style={`height:${h}px`}></i>)}</span>
                  <b class="num">0:07</b>
                </span>
              </div>
              <span class="fan__from">{t.hero.restaurant} · واتساب</span>
            </div>
            <svg class="fan__lines" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
              <path class="fan__line" d="M600 0 C600 70, 1000 50, 1000 120" />
              <path class="fan__line" d="M600 0 V120" />
              <path class="fan__line" d="M600 0 C600 70, 200 50, 200 120" />
            </svg>
            <div class="fan__row">
              <article class="panel">
                <span class="panel__n num">01</span>
                <h3>{t.whatIs.panels.p1}</h3>
                <div class="panel__art">
                  <div class="wa">
                    <div class="wa__b wa__b--out"><span>{rec.headline}</span></div>
                    <div class="wa__b wa__b--out">
                      <b>{rec.title}</b>
                      <span>{rec.item}</span>
                      <b>{rec.total}</b>
                      <span>{rec.payEta}</span>
                    </div>
                  </div>
                </div>
              </article>
              <article class="panel">
                <span class="panel__n num">02</span>
                <h3>{t.whatIs.panels.p2}</h3>
                <div class="panel__art">
                  <div class="ticket num" dir="ltr">
                    <b>{tk.head}</b>
                    <span class="ticket__code">{tk.code}</span>
                    <span>{tk.customer}</span>
                    <hr />
                    <span class="ticket__row"><span>{tk.item}</span><span>{tk.price}</span></span>
                    {tk.mods.slice(0, 2).map((m) => <span class="ticket__mod">{m}</span>)}
                    <hr />
                    <span class="ticket__row ticket__total"><span>{tk.totalLabel}</span><span>{tk.total}</span></span>
                  </div>
                </div>
              </article>
              <article class="panel">
                <span class="panel__n num">03</span>
                <h3>{t.whatIs.panels.p3}</h3>
                <div class="panel__art">
                  <div class="record">
                    <div class="record__head">
                      <span class="record__av">{pf.name.charAt(0)}</span>
                      <span><b>{pf.name}</b><span class="num" dir="ltr">{pf.phone}</span></span>
                      <span class="record__badge">{pf.badge}</span>
                    </div>
                    <div class="record__stats">
                      {pf.stats.map((s) => <span><b class="num" data-count={s.value}>{s.value}</b><small>{s.label}</small></span>)}
                    </div>
                    <div class="record__row"><span>{pf.rows[0]!.label}</span><b>{pf.rows[0]!.text}</b></div>
                    <div class="record__row"><span>{pf.notesLabel}</span><b>{pf.notes[0]}</b></div>
                  </div>
                </div>
              </article>
            </div>
            <button class="replay" type="button" data-replay="scene-outputs">↻ {t.whatIs.stream.replay}</button>
          </div>
        </div>
      </section>

      <!-- ═══ 4 · WHAT IT UNDERSTANDS — the bento ═══ -->
      <section class="sec" id="features">
        <div class="wrap">
          <header class="sec-head">
            <p class="eyebrow"><span class="eyebrow__rule"></span> [03] بيفهم إزاي</p>
            <h2 class="mega">{t.understands.h2}</h2>
          </header>
          <div class="bento" id="scene-bento">
            {t.understands.table.pairs.map((p, i) => (
              <article class:list={['tile', 'scene', i < 2 && 'tile--wide']}>
                <h3>{p.head}</h3>
                <span class="tile__k">{t.understands.table.sends}</span>
                <div class="tile__in">
                  {p.input.kind === 'voice' && (
                    <span class="chat__voice">
                      <span class="chat__wave chat__wave--live">{[5,9,14,8,12,17,10,6,12,16,9,5,8,13].map((h) => <i style={`height:${h}px`}></i>)}</span>
                      <b class="num" data-timer={p.input.duration}>{p.input.duration}</b>
                    </span>
                  )}
                  {p.input.kind === 'location' && <span data-type={`📍 ${p.input.text}`}>📍 {p.input.text}</span>}
                  {p.input.kind === 'text' && <span dir="auto" data-type={p.input.text}>{p.input.text}</span>}
                </div>
                <span class="tile__k">{t.understands.table.gets}</span>
                <dl class="tile__out">
                  {p.fields.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
                </dl>
              </article>
            ))}
            <a class="tile tile--cta" href={WA_LINK}>
              <h3>{t.closing.askMore}</h3>
              <span class="btn btn--yellow btn--sm">{t.nav.cta} <span aria-hidden="true">←</span></span>
            </a>
          </div>
          <button class="replay" type="button" data-replay="scene-bento">↻ {t.understands.table.replay}</button>
        </div>
      </section>

      <!-- ═══ 5 · THE DINING ROOM — the divided strip ═══ -->
      <section class="sec sec--steel" id="dinein">
        <div class="wrap dine">
          <header class="sec-head dine__copy">
            <p class="eyebrow"><span class="eyebrow__rule"></span> [04] الصالة</p>
            <h2 class="mega mega--md">{t.dineIn.h2}</h2>
            <p class="lede">{t.dineIn.p1}</p>
            <p class="lede">{t.dineIn.p2}</p>
          </header>
          <div class="strip scene" id="scene-dine">
            <div class="strip__cell">
              <span class="strip__n num">1</span>
              <div class="scanner" aria-hidden="true">
                <div class="scanner__win"><i class="scanner__c scanner__c--tl"></i><i class="scanner__c scanner__c--tr"></i><i class="scanner__c scanner__c--bl"></i><i class="scanner__c scanner__c--br"></i><span class="scanner__line"></span></div>
                <span class="scanner__ok">✓</span>
              </div>
              <div class="tent">
                <div class="qr" aria-hidden="true">
                  {qrCells.map((row) => <span>{row.split('').map((c) => <i class:list={[c === '1' && 'on']}></i>)}</span>)}
                </div>
                <span class="tent__t">{t.dineIn.qr.scan}</span>
                <span class="tent__tbl num">{sc.chips[0]}</span>
              </div>
              <p>{sc.step1}</p>
            </div>
            <div class="strip__cell">
              <span class="strip__n num">2</span>
              <div class="wa wa--phone">
                {sc.chat.map((m) => <div class:list={['wa__b', m.from === 'out' ? 'wa__b--out' : 'wa__b--in']}><span>{m.text}</span></div>)}
              </div>
              <p>{sc.step2}</p>
            </div>
            <div class="strip__cell">
              <span class="strip__n num">3</span>
              <div class="record">
                <div class="record__head">
                  <span class="record__av">{sc.guestName.charAt(0)}</span>
                  <span><b>{sc.guestName}</b><span class="num" dir="ltr">{sc.guestPhone}</span></span>
                </div>
                <div class="record__chips">{sc.chips.map((c) => <span>{c}</span>)}</div>
                <div class="record__row"><span class="num">{sc.orderCode}</span><b>{sc.orderItem}</b></div>
                <div class="record__row"><span>{sc.orderMeta}</span><b class="num">{sc.orderTotal}</b></div>
              </div>
              <p>{sc.step3}</p>
            </div>
          </div>
          <p class="dine__captured">✓ {sc.captured} <button class="replay replay--inline" type="button" data-replay="scene-dine">↻ {sc.replay}</button></p>
        </div>
      </section>

      <!-- ═══ 6 · 3 STEPS — the journey ═══ -->
      <section class="sec" id="how">
        <div class="wrap">
          <header class="sec-head sec-head--row">
            <div>
              <p class="eyebrow"><span class="eyebrow__rule"></span> [05] إزاي بيبدأ</p>
              <h2 class="mega">{t.steps.h2}</h2>
            </div>
            <p class="lede">{jr.orderFrom}. {t.steps.items[2]!.body}</p>
          </header>
          <ol class="steps scene" id="steps">
            <div class="steps__line" aria-hidden="true"><i id="steps-fill"></i></div>
            {t.steps.items.map((s, i) => (
              <li>
                <span class="steps__n num">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <div class="steps__art">
                  {i === 0 && (
                    <div class="photos" aria-hidden="true"><i></i><i></i><i></i></div>
                  )}
                  {i === 0 && (
                    <div class="menu">
                      <b>{jr.menuTitle}</b>
                      {jr.menuItems.map((m) => <span><span>{m.name}</span><span class="num">{m.price}</span></span>)}
                    </div>
                  )}
                  {i === 1 && <div class="chips">{jr.setupChips.map((c) => <span>{c.replace(' ✓', '')} <i class="chips__tick">✓</i></span>)}</div>}
                  {i === 2 && (
                    <div class="order">
                      <b class="num">{jr.orderTitle}</b>
                      <span>{jr.orderItem}</span>
                      <small>{jr.orderFrom}</small>
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
          <button class="replay" type="button" data-replay="steps">↻ {jr.replay}</button>
        </div>
      </section>

      <!-- ═══ 7 · TRUST — the karkadeh band ═══ -->
      <section class="deals scene" id="trust">
        <div class="wrap">
          <header class="sec-head deals__head">
            <p class="eyebrow eyebrow--onlight"><span class="eyebrow__rule eyebrow__rule--dark"></span> [06] ليه منادم</p>
            <h2 class="mega mega--dark">{t.trust.pre} <b class="num deals__big" data-count={t.trust.num}>{t.trust.num}</b> {t.trust.post}</h2>
          </header>
          <ul class="run" aria-label={t.trust.run.title}>
            {t.trust.run.cases.map((c) => <li><i class="run__tick">✓</i><span>{c}</span></li>)}
            <li class="run__sum"><b class="num">110</b> {t.trust.run.ofLabel} <b class="num">110</b> {t.trust.run.passing}</li>
          </ul>
          <div class="grid grid--3">
            {t.trust.facts.map((f, i) => (
              <article class="deal">
                <span class="deal__n num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.head}</h3>
                <p>{f.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 8 · PRICE + THE DRAGGING ARITHMETIC ═══ -->
      <section class="sec" id="pricing">
        <div class="wrap">
          <header class="sec-head sec-head--row">
            <div>
              <p class="eyebrow"><span class="eyebrow__rule"></span> [07] السعر</p>
              <h2 class="mega">{t.pricing.h2}</h2>
            </div>
            <p class="lede">{t.pricing.includesAll} {t.pricing.setup}</p>
          </header>
          <div class="cards--3">
            {t.pricing.plans.map((p, i) => (
              <article class:list={['card', i === 1 && 'card--pop']} data-plan={p.name}>
                <div class="card__body">
                  <p class="card__name" dir="ltr">{p.name}</p>
                  <h3 class="card__size num" dir="ltr">{p.monthly}<small>{t.pricing.perMonth}</small></h3>
                  <p class="card__desc">{p.fits}</p>
                  <dl class="spec">
                    <div><dt>{t.pricing.rows.included}</dt><dd class="num">{p.included}</dd></div>
                    <div><dt>{t.pricing.rows.overage}</dt><dd>{p.overage}</dd></div>
                  </dl>
                  <a class="card__link" href={WA_LINK}>{t.nav.cta} <span aria-hidden="true">←</span></a>
                </div>
              </article>
            ))}
          </div>
          <div class="calc" id="calc">
            <div class="calc__inputs">
              <label class="calc__field">
                <span class="calc__label">{t.pricing.picker.aov}</span>
                <span class="calc__num num" id="c-aov">150</span>
                <input type="range" id="c-aov-r" min="80" max="400" step="10" value="150" aria-label={t.pricing.picker.aov} />
              </label>
              <label class="calc__field">
                <span class="calc__label">{t.pricing.picker.orders}</span>
                <span class="calc__num num" id="c-ord">600</span>
                <input type="range" id="c-ord-r" min="100" max="3000" step="50" value="600" aria-label={t.pricing.picker.orders} />
              </label>
            </div>
            <div class="calc__out">
              <div class="calc__box calc__box--bad">
                <span class="calc__k">{t.pricing.picker.appSide}</span>
                <span class="calc__v num" id="c-app">18,000</span>
              </div>
              <div class="calc__box">
                <span class="calc__k">{t.pricing.picker.ourSide} <b id="c-plan" dir="ltr">Start</b></span>
                <span class="calc__v num" id="c-ours">6,200</span>
              </div>
              <div class="calc__box calc__box--diff">
                <span class="calc__k">{t.pricing.picker.diff}</span>
                <span class="calc__v num" id="c-diff">11,800</span>
                <span class="calc__k">{t.pricing.picker.egp} {t.pricing.perMonth}</span>
              </div>
            </div>
            <p class="calc__note">{t.pricing.picker.assumption}</p>
          </div>
        </div>
      </section>

      <!-- ═══ 9 · QUESTIONS — sticky heading, their accordion ═══ -->
      <section class="sec sec--steel" id="faq">
        <div class="wrap faq__grid">
          <header class="sec-head faq__head">
            <p class="eyebrow"><span class="eyebrow__rule"></span> [08] أسئلة</p>
            <h2 class="mega mega--md">{t.objections.h2}</h2>
            <p class="lede">{t.closing.askMore}</p>
            <a class="btn btn--yellow" href={WA_LINK}>{t.nav.cta} <span aria-hidden="true">←</span></a>
          </header>
          <div class="faq" id="faq-list">
            {t.objections.items.map((o, i) => (
              <div class:list={['faq__item', i === 0 && 'is-open']}>
                <button class="faq__q" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span>{o.q}</span><span class="faq__i" aria-hidden="true"></span>
                </button>
                <div class="faq__a"><p>{o.a}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 10 · CLOSING — ink, with the composer ═══ -->
      <section class="qs" id="quote">
        <div class="wrap qs__in">
          <div>
            <p class="eyebrow"><span class="eyebrow__rule"></span> [09] {t.closing.cta}</p>
            <h2 class="mega">{t.closing.h2}</h2>
            <p class="lede">{t.closing.p}</p>
            <div class="qs__cta">
              <a class="btn btn--yellow" href={WA_LINK}>{t.closing.cta} <span aria-hidden="true">←</span></a>
              <a class="qs__tel num" href={WA_LINK} dir="ltr">{WA_NUMBER_DISPLAY}</a>
            </div>
            <p class="qs__micro">{t.closing.micro} · <a href={`mailto:${CONTACT_EMAIL}`} dir="ltr">{CONTACT_EMAIL}</a></p>
          </div>
          <a class="composer" href={WA_LINK} aria-label={t.closing.cta}>
            <div class="composer__top">
              <span class="composer__av">م</span>
              <span><b>منادم</b><span>{t.hero.chatStatus}</span></span>
            </div>
            <div class="composer__body">
              <div class="wa__b wa__b--in"><span>{t.closing.askMore}</span></div>
              <div class="wa__b wa__b--out"><span>{t.closing.prefill}</span></div>
            </div>
            <div class="composer__bar">
              <span class="composer__field">{t.closing.prefill}</span>
              <span class="composer__send" aria-hidden="true">➤</span>
            </div>
          </a>
        </div>
      </section>

      <footer class="foot">
        <div class="wrap foot__in">
          <span class="foot__word" aria-hidden="true">MUNADIM</span>
          <div class="foot__row">
            <span>{t.footer.tagline}</span>
            <a href={`mailto:${CONTACT_EMAIL}`} dir="ltr">{CONTACT_EMAIL}</a>
            <a href="/en" dir="ltr">{t.nav.toggle.label}</a>
            <span class="num">{t.footer.rights}</span>
          </div>
        </div>
      </footer>
    </main>

    <!-- sticky pill -->
    <div class="pill" id="pill">
      <a class="pill__q" href={WA_LINK}>{t.nav.cta}</a>
      <span class="pill__div"></span>
      <a class="pill__t num" href={WA_LINK} dir="ltr">{WA_NUMBER_DISPLAY}</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline></script>
    <script src="/js/clone.js" is:inline></script>
  </body>
</html>
