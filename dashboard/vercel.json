{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/menu.pdf", "destination": "https://flows-production-e528.up.railway.app/pdf/menu" },
    { "source": "/receipt/:code", "destination": "https://flows-production-e528.up.railway.app/pdf/receipt/:code" },
    { "source": "/driver/:token", "destination": "https://flows-production-e528.up.railway.app/driver/:token" },
    { "source": "/api/driver/:path*", "destination": "https://flows-production-e528.up.railway.app/api/driver/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
