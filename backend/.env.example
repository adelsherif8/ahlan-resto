# Leave everything unset to run in DEMO MODE (in-memory seeded data).

PORT=5051
JWT_SECRET=change-me

# Control plane (Ahlan Supabase) — enables real mode
SUPABASE_AHLAN_URL=
SUPABASE_AHLAN_SERVICE_KEY=

# AES-256-GCM key (hex) for decrypting per-restaurant supabase creds in integrations.supabase
ENCRYPTION_KEY=

# Optional single-tenant shortcut (skip control plane, point at one restaurant DB)
TEST_RESTO_SUPABASE_URL=
TEST_RESTO_SUPABASE_KEY=
