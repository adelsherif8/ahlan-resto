/**
 * Feature reel — Layout A as motion.
 *
 * A cream page, the Arabic headline above, a phone below, and the real
 * conversation typing itself in. Everything is real text in Amiri / IBM Plex
 * Arabic, so the Arabic is always correct — which is the whole reason these are
 * built in code instead of generated (branding/MARKETING-IMAGE-BRIEFS.md).
 */
import React, { useEffect, useState } from 'react';
import { AbsoluteFill, Img, continueRender, delayRender, interpolate, spring, staticFile, useCurrentFrame, useVideoConfig } from 'remotion';
import { C } from './lib/brand';
import { POSTS, type Bubble, type Post as PostData } from './lib/posts';

const FACES: [string, string, string][] = [
  ['Plex', 'fonts/ibm-plex-sans-arabic-v15-arabic_latin-regular.woff2', '400'],
  ['Plex', 'fonts/ibm-plex-sans-arabic-v15-arabic_latin-500.woff2', '500'],
  ['Plex', 'fonts/ibm-plex-sans-arabic-v15-arabic_latin-600.woff2', '600'],
  ['Plex', 'fonts/ibm-plex-sans-arabic-v15-arabic_latin-700.woff2', '700'],
  ['PlexMono', 'fonts/ibm-plex-mono-v20-latin-500.woff2', '500'],
  ['Amiri', 'fonts/amiri-v30-arabic-700.woff2', '700'],
  ['Cinzel', 'fonts/cinzel-v26-latin-600.woff2', '600'],
];
/** The headline is real Amiri, so the Arabic can never come out malformed. */
function useFontsReady() {
  const [h] = useState(() => delayRender('post-fonts'));
  const [ready, setReady] = useState(false);
  useEffect(() => {
    Promise.all(FACES.map(([fam, file, w]) => new FontFace(fam, `url(${staticFile(file)})`, { weight: w }).load()))
      .then((fs) => { fs.forEach((x) => document.fonts.add(x)); setReady(true); continueRender(h); });
  }, [h]);
  return ready;
}

const AR = 'Amiri';
const UI = 'Plex';
const MONO = 'PlexMono';

/** Frames each bubble waits before it lands, plus the typing pause before a reply. */
const BUBBLE_IN = 18;
const GUEST_GAP = 26;
const TYPING = 34;

export const postTiming = (p: PostData) => {
  const starts: number[] = [];
  let t = 54; // the page and headline settle first
  for (const b of p.script) {
    if (!b.me) t += TYPING;
    starts.push(t);
    t += BUBBLE_IN + GUEST_GAP;
  }
  return { starts, end: t + 70 };
};

const Tick = ({ blue }: { blue?: boolean }) => (
  <svg viewBox="0 0 18 12" width={22} height={15} style={{ marginInlineStart: 6 }}>
    {[0, 6].map((dx) => (
      <path key={dx} d={`M${1 + dx} 6.5 L${4 + dx} 9.5 L${10 + dx} 2.5`} fill="none"
        stroke={blue ? '#53BDEB' : '#8696A0'} strokeWidth={1.6} strokeLinecap="round" strokeLinejoin="round" />
    ))}
  </svg>
);

const Wave = () => (
  <span style={{ display: 'flex', alignItems: 'center', gap: 3, height: 26 }}>
    {[7, 12, 19, 11, 16, 23, 13, 8, 16, 21, 12, 7, 11, 17, 24, 14, 9, 13].map((h, i) => (
      <span key={i} style={{ width: 3.5, height: h, borderRadius: 3, background: '#8696A0', display: 'block' }} />
    ))}
  </span>
);

const Bubble = ({ b, p }: { b: Bubble; p: number }) => {
  const me = b.me;
  const y = interpolate(p, [0, 1], [26, 0]);
  return (
    <div style={{
      alignSelf: me ? 'flex-end' : 'flex-start',
      maxWidth: '86%',
      background: me ? C.waOut : C.waIn,
      borderRadius: 18,
      [me ? 'borderTopLeftRadius' : 'borderTopRightRadius']: 4,
      padding: '18px 22px 12px',
      boxShadow: '0 1px 2px rgba(0,0,0,0.10)',
      opacity: p,
      transform: `translateY(${y}px)`,
      color: '#111B21',
      fontFamily: UI,
      fontSize: 30,
      lineHeight: 1.55,
      whiteSpace: 'pre-wrap',
    }}>
      {b.kind === 'voice' && (
        <span style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
          <Wave /><b style={{ fontFamily: MONO, fontWeight: 500, fontSize: 24 }}>{b.dur}</b>
        </span>
      )}
      {b.kind === 'location' && (
        <span style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
          <span style={{ width: 420, height: 230, borderRadius: 12, background: '#D9D2C7', position: 'relative', overflow: 'hidden' }}>
            <span style={{ position: 'absolute', inset: 0, background:
              'repeating-linear-gradient(90deg,#CFC7BA 0 2px,transparent 2px 46px),repeating-linear-gradient(0deg,#CFC7BA 0 2px,transparent 2px 46px)' }} />
            <span style={{ position: 'absolute', left: '50%', top: '46%', width: 26, height: 26, marginLeft: -13,
              borderRadius: '50% 50% 50% 0', transform: 'rotate(-45deg)', background: C.karkadeh }} />
          </span>
          <span style={{ fontSize: 26, color: '#5A6B72' }}>📍 الموقع</span>
        </span>
      )}
      {b.kind === 'text' && <span dir="auto">{b.text}</span>}
      {b.kind === 'bill' && (
        <span style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          {b.lines.map(([label, val], i) => (
            <span key={i} style={{ display: 'flex', justifyContent: 'space-between', gap: 28, fontSize: 28 }}>
              <span>{label}</span>{val && <b style={{ fontFamily: MONO, fontWeight: 500 }}>{val}</b>}
            </span>
          ))}
          <span style={{ display: 'flex', justifyContent: 'space-between', gap: 28, borderTop: '1px solid rgba(17,27,33,0.14)', marginTop: 6, paddingTop: 8, fontWeight: 700 }}>
            <span>{b.total[0]}</span><b style={{ fontFamily: MONO }}>{b.total[1]}</b>
          </span>
          {b.after && <span style={{ marginTop: 6 }}>{b.after}</span>}
        </span>
      )}
      {b.kind === 'status' && (
        <span style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
          <span style={{ display: 'flex', gap: 12, alignItems: 'baseline' }}>
            <b style={{ fontFamily: MONO }}>{b.code}</b><span style={{ color: '#5A6B72', fontSize: 25 }}>· {b.ago}</span>
          </span>
          {b.steps.map(([label, done], i) => (
            <span key={i} style={{ display: 'flex', gap: 10, alignItems: 'center', opacity: done ? 1 : 0.55 }}>
              <span>{done ? '✅' : '⬜'}</span><span>{label}</span>
            </span>
          ))}
        </span>
      )}
      <span style={{ display: 'flex', justifyContent: 'flex-end', alignItems: 'center', marginTop: 4 }}>
        <span style={{ fontFamily: MONO, fontSize: 21, color: '#667781' }}>{b.time}</span>
        {me && <Tick blue />}
      </span>
    </div>
  );
};

const Typing = ({ o }: { o: number }) => (
  <div style={{ alignSelf: 'flex-start', background: C.waIn, borderRadius: 18, borderTopRightRadius: 4,
    padding: '20px 24px', display: 'flex', gap: 8, opacity: o, boxShadow: '0 1px 2px rgba(0,0,0,0.10)' }}>
    {[0, 1, 2].map((i) => <span key={i} style={{ width: 11, height: 11, borderRadius: 999, background: '#8696A0', display: 'block' }} />)}
  </div>
);

export const Post: React.FC<{ post?: string }> = ({ post = '1A' }) => {
  const data = POSTS[post] ?? POSTS['1A']!;
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const { starts } = postTiming(data);
  const fontsReady = useFontsReady();
  if (!fontsReady) return <AbsoluteFill style={{ background: C.semna }} />;

  const page = spring({ frame, fps, config: { damping: 200 }, durationInFrames: 30 });
  const head = spring({ frame: frame - 8, fps, config: { damping: 200 }, durationInFrames: 34 });
  const phone = spring({ frame: frame - 16, fps, config: { damping: 200 }, durationInFrames: 44 });
  // a slow push-in keeps it alive without moving the type
  const zoom = interpolate(frame, [0, 600], [1, 1.045], { extrapolateRight: 'clamp' });

  return (
    <AbsoluteFill style={{ background: C.semna, fontFamily: UI }}>
      <AbsoluteFill style={{ transform: `scale(${zoom})`, padding: '92px 76px 0', display: 'flex', flexDirection: 'column' }}>
        {/* headline block — Arabic leads, karkadeh rule, small English */}
        <div style={{ direction: 'rtl', textAlign: 'right', opacity: head, transform: `translateY(${(1 - head) * 18}px)` }}>
          <div style={{ fontFamily: AR, fontWeight: 700, fontSize: 86, lineHeight: 1.36, color: C.ink, maxWidth: 940 }}>
            {data.headline}
          </div>
          <div style={{ width: 190, height: 6, background: C.karkadeh, borderRadius: 3, margin: '34px 0 22px' }} />
          <div style={{ fontFamily: UI, fontSize: 31, color: 'rgba(20,17,16,0.55)', direction: 'ltr', textAlign: 'right' }}>
            {data.english}
          </div>
        </div>

        {/* the phone, inset like the still posts */}
        <div style={{
          marginTop: 46, alignSelf: 'center', width: 742, height: 1180,
          borderRadius: 54, border: `14px solid #231E1C`, background: '#231E1C',
          boxShadow: '0 40px 90px -30px rgba(20,17,16,0.45)',
          opacity: phone, transform: `translateY(${(1 - phone) * 40}px)`, overflow: 'hidden',
        }}>
          <div style={{ background: C.waBg, height: '100%', display: 'flex', flexDirection: 'column' }}>
            {/* chat header */}
            <div style={{ background: '#F0F2F5', padding: '22px 26px', display: 'flex', alignItems: 'center', gap: 16, direction: 'rtl' }}>
              <Img src={staticFile('01-mark-fine-brass-on-ink-nobg.svg')}
                style={{ width: 62, height: 62, borderRadius: 999, background: C.ink, padding: 8 }} />
              <div style={{ lineHeight: 1.25 }}>
                <div style={{ fontSize: 30, fontWeight: 600, color: '#111B21' }}>مُنادم</div>
                <div style={{ fontSize: 23, color: '#667781' }}>متصل</div>
              </div>
            </div>
            {/* thread — anchored to the bottom, the way a real chat sits. minHeight:0 lets
                it shrink below its content so a long script clips off the TOP instead of
                shoving the input bar out of the phone; that is what a chat scrolled to the
                bottom looks like. */}
            <div style={{ flex: 1, minHeight: 0, overflow: 'hidden', padding: 26, display: 'flex', flexDirection: 'column', justifyContent: 'flex-end', gap: 16, direction: 'rtl' }}>
              {data.script.map((b, i) => {
                const p = spring({ frame: frame - starts[i]!, fps, config: { damping: 200 }, durationInFrames: BUBBLE_IN });
                if (p <= 0) return null;
                return <Bubble key={i} b={b} p={p} />;
              })}
              {data.script.map((b, i) => {
                if (b.me) return null;
                const show = frame >= starts[i]! - TYPING && frame < starts[i]!;
                return show ? <Typing key={`t${i}`} o={1} /> : null;
              })}
            </div>
            {/* input bar — the chat looks live, not a screenshot */}
            <div style={{ background: '#F0F2F5', padding: '16px 20px', display: 'flex', alignItems: 'center', gap: 14, direction: 'rtl' }}>
              <div style={{ flex: 1, background: '#fff', borderRadius: 999, padding: '16px 22px', fontSize: 26, color: '#8696A0' }}>اكتب رسالة</div>
              <div style={{ width: 58, height: 58, borderRadius: 999, background: '#25D366', display: 'grid', placeItems: 'center', color: '#fff', fontSize: 26 }}>➤</div>
            </div>
          </div>
        </div>
      </AbsoluteFill>

      {/* logo, bottom-left on the cream page */}
      <Img src={staticFile('21-lockup-horizontal-light-nobg.svg')}
        style={{ position: 'absolute', left: 76, bottom: 58, width: 300, opacity: page }} />
    </AbsoluteFill>
  );
};
